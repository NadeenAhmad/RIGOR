  <rdf:Description rdf:about="http://example.org/ontology#Artist">
    <rdfs:subClassOf rdf:nodeID="N0a0bf391cf3148d6b449061ea08435d4"/>
    <rdfs:subClassOf rdf:nodeID="N8f92ef4ce1b14b5a9976dd0d986ecc7d"/>
