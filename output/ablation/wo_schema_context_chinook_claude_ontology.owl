  <rdf:Description rdf:about="http://example.org/ontology#_Employee_ReportsTo">
    <rdfs:comment xml:lang="en">References the employee who acts as this employee's manager or supervisor. This is a self-referential foreign key (Employee.ReportsTo -&gt; Employee.EmployeeId), modeling the organizational reporting hierarchy. An employee may have zero or one manager. The top-level manager has no value for this property.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Reports To</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/Employee/ReportsTo"/>
    <rdfs:range rdf:resource="http://example.org/ontology#_Employee"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#_Employee"/>
  </rdf:Description>
