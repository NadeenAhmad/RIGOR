  <rdf:Description rdf:about="http://example.org/ontology#Album">
    <owl:hasKey rdf:nodeID="N378df4b17d9f4e26b3d0b96937c56cdd"/>
    <rdfs:subClassOf rdf:nodeID="Nb865a1285a5a4683b474338cc53eb065"/>
