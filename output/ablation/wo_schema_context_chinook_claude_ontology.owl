    <owl:hasKey rdf:nodeID="N59cd1eeb1ed7417fa57b302ffeb6e542"/>
    <rdfs:label xml:lang="en">Artist</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'Artist'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a musical artist or performer entity in the catalogue. An artist can be associated with one or more albums.</rdfs:comment>
    <rdfs:comment xml:lang="en">Title of the album. This is a required (not-null) text field storing the human-readable name of the album.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the album. Primary key of the Album table. Each value uniquely identifies one album instance.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/Artist"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/Album/AlbumId"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/Album/Title"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
