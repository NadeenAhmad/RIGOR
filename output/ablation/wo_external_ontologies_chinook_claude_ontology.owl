  <rdf:Description rdf:about="http://example.org/ontology#PlaylistTrack_hasTrack">
    <rdfs:label xml:lang="en">Playlist Track has Track</rdfs:label>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'PlaylistTrack.TrackId' referencing 'Track.TrackId'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Relates a PlaylistTrack association to the Track it includes. Derived from foreign key PlaylistTrack.TrackId → Track.TrackId. Every PlaylistTrack must reference exactly one Track (NOT NULL, part of composite PK).</rdfs:comment>
