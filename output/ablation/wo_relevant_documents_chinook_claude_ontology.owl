    <owl:hasKey rdf:nodeID="N94dbd24219274c938a30de35f93e8f8a"/>
    <owl:hasKey rdf:nodeID="Ned3157f99ecf4ec58af5af8862de7afa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Class generated from source table 'Customer'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person or organization that purchases goods or services. Each customer is uniquely identified by CustomerId and must have a first name, last name, and email address. A customer may optionally be associated with a company and a support representative (Employee).</rdfs:comment>
