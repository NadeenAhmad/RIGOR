  <rdf:Description rdf:about="http://example.org/ontology#MediaType">
    <rdfs:subClassOf rdf:nodeID="N48f7ef0ae76d45edbeb303cd25b01e95"/>
    <rdfs:subClassOf rdf:nodeID="Nf4312d16f906484790c660831606c07d"/>
