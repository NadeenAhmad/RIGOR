    <rdfs:comment xml:lang="en">Class generated from source table 'MediaType'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a media format or encoding type for audio tracks. Examples include AAC, MPEG, protected AAC, and purchased AAC audio files. Each media type classifies the technical format of a track's media file.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the media type. This is the primary key of the MediaType table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name or description of the media type. Describes the audio format, encoding type, or protected media format (e.g., 'MPEG audio file', 'AAC audio file', 'Protected AAC audio file').</rdfs:comment>
    <rdfs:label xml:lang="en">Media Type</rdfs:label>
    <rdfs:label xml:lang="en">Media Type Name</rdfs:label>
    <rdfs:label xml:lang="en">Media Type ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/MediaType"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/MediaType/MediaTypeId"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/MediaType/Name"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
