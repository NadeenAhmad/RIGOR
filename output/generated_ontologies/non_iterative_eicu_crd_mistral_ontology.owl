    <rdfs:comment xml:lang="en">The offset for the care plan infectious disease.</rdfs:comment>
    <rdfs:comment xml:lang="en">The assessment of the infectious disease.</rdfs:comment>
    <rdfs:comment xml:lang="en">The offset of the nurse care entry.</rdfs:comment>
    <rdfs:comment xml:lang="en">The attribute of the cell.</rdfs:comment>
    <rdfs:comment xml:lang="en">The value of the cell attribute.</rdfs:comment>
    <rdfs:comment xml:lang="en">The label of the cell.</rdfs:comment>
    <rdfs:comment xml:lang="en">The offset of the nurse care.</rdfs:comment>
    <rdfs:comment xml:lang="en">The ID of the nurse care entry.</rdfs:comment>
