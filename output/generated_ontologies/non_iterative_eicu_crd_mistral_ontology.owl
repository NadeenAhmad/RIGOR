    <rdfs:comment xml:lang="en">Represents an allergy record in the database.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if the allergy is included in the Rx.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the allergy.</rdfs:comment>
