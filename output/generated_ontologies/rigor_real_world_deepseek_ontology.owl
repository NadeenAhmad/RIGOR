    <rdfs:subClassOf rdf:resource="http://example.org/ontology#(∃ child_stadium_definition)"/>
    <rdfs:label xml:lang="en">Child Stadium</rdfs:label>
    <rdfs:label xml:lang="en">Child-Pugh Classification</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rfa_cycles">
