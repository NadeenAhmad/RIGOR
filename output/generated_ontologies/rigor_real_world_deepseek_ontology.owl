    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether there were dose reductions during the treatment course.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ChildStadium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A classification system used to assess the severity of cirrhosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A system used to assess the severity of chronic liver disease, including cirrhosis.</rdfs:comment>
