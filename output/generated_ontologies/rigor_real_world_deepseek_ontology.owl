    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Additional details about further symptoms.</rdfs:comment>
    <rdfs:label xml:lang="en">Further Symptoms Text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#karnofsky_index_percent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
