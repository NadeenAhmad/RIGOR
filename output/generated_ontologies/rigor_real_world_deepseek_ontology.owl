    <rdfs:comment xml:lang="en">Indicates if the patient had previous operations relevant to the current procedure</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if the patient has had previous operations.</rdfs:comment>
    <rdfs:label xml:lang="en">previous operations</rdfs:label>
    <rdfs:label xml:lang="en">Previous Operations</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HistologyGeneral">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents the general histological examination data.</rdfs:comment>
    <rdfs:label xml:lang="en">General Histology</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#MedicalHistory">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Medical History</rdfs:label>
    <rdfs:comment xml:lang="en">A record of a patient's medical history including diagnoses, treatments, and conditions.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#remission">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the cancer went into remission.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Remission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ascites">
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Indicates if the patient has fluid in the abdominal cavity.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Ascites</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#primary_dose_reduction">
    <rdfs:label xml:lang="en">Primary Dose Reduction</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether there was an initial reduction in the prescribed dose.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#histological_diagnosis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The specific histological diagnosis resulting from the tissue analysis.</rdfs:comment>
    <rdfs:label xml:lang="en">Histological Diagnosis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#paclitaxel">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether Paclitaxel was used in the chemotherapy regimen.</rdfs:comment>
    <rdfs:label xml:lang="en">Paclitaxel</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bm_depression">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Bone Marrow Depression</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether bone marrow depression occurred as a side effect of chemotherapy.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#abdominal_pain">
    <rdfs:label xml:lang="en">Abdominal Pain</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Indicates if the patient has experienced abdominal pain.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hand_foot_syndrome">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Hand-Foot Syndrome</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether hand-foot syndrome occurred as a side effect of chemotherapy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patient_id">
    <rdfs:comment xml:lang="en">Unique identifier for the patient undergoing chemotherapy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
