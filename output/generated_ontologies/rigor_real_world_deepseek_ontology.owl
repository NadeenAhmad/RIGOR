    <prov:wasDerivedFrom rdf:resource="http://example.org/schema/icd/patient_id"/>
    <rdfs:comment xml:lang="en">The patient data associated with the complication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a general aftercare record to the corresponding patient data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links operational details to patient data</rdfs:comment>
    <rdfs:comment xml:lang="en">Links histological data to the corresponding patient data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an ICD record to the associated patient data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links laboratory test results to the patient's demographic data</rdfs:comment>
    <rdfs:comment xml:lang="en">Links to the demographic and personal information of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medication record to its associated patient data</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Urikostatika">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">uric acid reducers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
