    <rdfs:comment xml:lang="en">Indicates whether the patient is taking medications to lower uric acid levels (e.g., for gout)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Bilirubin_μmol_per_l">
