  <rdf:Description rdf:about="http://example.org/ontology#PatientData">
    <rdfs:label xml:lang="en">Patient Data</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Data related to a patient's clinical information.</rdfs:comment>
    <rdfs:comment xml:lang="en">Contains demographic and clinical data about patients.</rdfs:comment>
    <rdfs:comment xml:lang="en">Patient demographic and clinical data</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the data related to a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the data associated with a patient, including medical records and demographic information.</rdfs:comment>
    <rdfs:comment xml:lang="en">Demographic and personal information about a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">A class representing patient demographic and clinical data</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the basic data of a patient, including identifiers and demographic information.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/schema#patient_data"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/schema/patient_data"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#neurotoxicity">
