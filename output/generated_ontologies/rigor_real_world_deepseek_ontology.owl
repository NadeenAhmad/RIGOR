  <rdf:Description rdf:about="http://example.org/ontology#patient_id_old">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Previous identifier for the patient.</rdfs:comment>
