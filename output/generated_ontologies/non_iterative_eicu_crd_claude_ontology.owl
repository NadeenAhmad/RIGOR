>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_infusionOffset">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">infusion offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to the infusion drug event.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:admissionDx_hasPatientUnitStay">
    <rdfs:label xml:lang="en">admit diagnosis name</rdfs:label>
    <rdfs:label xml:lang="en">admit diagnosis entered offset</rdfs:label>
    <rdfs:label xml:lang="en">admit diagnosis text</rdfs:label>
    <rdfs:label xml:lang="en">admit diagnosis path</rdfs:label>
    <rdfs:label xml:lang="en">admission diagnosis ID</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:comment xml:lang="en">The textual description of the admission diagnosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">The hierarchical path of the admission diagnosis within the diagnosis taxonomy.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the admission diagnosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for the admission diagnosis record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes from unit admit time that the admission diagnosis was entered.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an admission diagnosis record to the corresponding patient unit stay.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:AdmissionDx"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hasHospital">
    <rdfs:comment xml:lang="en">The location to which the patient was discharged from the ICU unit.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of hospital discharge in 24-hour format (HH:MM:SS).</rdfs:comment>
    <rdfs:comment xml:lang="en">The offset in minutes from the unit admit time to the hospital discharge time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of unit stay (e.g., admit, readmit, transfer).</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary identifier for a unique patient unit stay episode.</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique identifier for the patient across all hospital and unit stays.</rdfs:comment>
    <rdfs:comment xml:lang="en">The height of the patient at the time of admission, in centimeters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The source from which the patient was admitted to the ICU unit.</rdfs:comment>
    <rdfs:comment xml:lang="en">The discharge status of the patient from the hospital (e.g., Alive, Expired).</rdfs:comment>
    <rdfs:comment xml:lang="en">The sequential visit number for the patient's unit stays within a single health system stay.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of unit discharge in 24-hour format (HH:MM:SS).</rdfs:comment>
    <rdfs:comment xml:lang="en">The gender of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of admission, in kilograms.</rdfs:comment>
    <rdfs:comment xml:lang="en">The offset in minutes from the unit admit time to the unit discharge time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The source from which the patient was admitted to the hospital (e.g., Emergency Department, Operating Room).</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifier for the patient's overall health system stay, which may encompass multiple unit stays.</rdfs:comment>
    <rdfs:comment xml:lang="en">The year in which the patient was discharged from the hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">The age of the patient, stored as a string to accommodate values such as '&gt; 89'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifier for the ward where the patient was located.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a patient record to the hospital where the patient was treated. Foreign key reference from patient.hospitalid to hospital.hospitalid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The discharge status of the patient from the ICU unit (e.g., Alive, Expired).</rdfs:comment>
    <rdfs:comment xml:lang="en">The APACHE admission diagnosis for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The offset in minutes from the unit admit time to the hospital admit time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The location to which the patient was discharged from the hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of unit admission in 24-hour format (HH:MM:SS).</rdfs:comment>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of discharge, in kilograms.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of hospital admission in 24-hour format (HH:MM:SS).</rdfs:comment>
    <rdfs:comment xml:lang="en">The ethnicity of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of ICU unit where the patient stayed (e.g., MICU, SICU, CCU).</rdfs:comment>
    <rdfs:label xml:lang="en">hospital discharge status</rdfs:label>
    <rdfs:label xml:lang="en">unique patient ID</rdfs:label>
    <rdfs:label xml:lang="en">hospital discharge year</rdfs:label>
    <rdfs:label xml:lang="en">ward ID</rdfs:label>
    <rdfs:label xml:lang="en">APACHE admission diagnosis</rdfs:label>
    <rdfs:label xml:lang="en">hospital admit source</rdfs:label>
    <rdfs:label xml:lang="en">hospital discharge location</rdfs:label>
    <rdfs:label xml:lang="en">patient unit stay ID</rdfs:label>
    <rdfs:label xml:lang="en">ethnicity</rdfs:label>
    <rdfs:label xml:lang="en">hospital discharge offset</rdfs:label>
    <rdfs:label xml:lang="en">unit visit number</rdfs:label>
    <rdfs:label xml:lang="en">discharge weight</rdfs:label>
    <rdfs:label xml:lang="en">unit admit time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">unit discharge status</rdfs:label>
    <rdfs:label xml:lang="en">unit stay type</rdfs:label>
    <rdfs:label xml:lang="en">unit type</rdfs:label>
    <rdfs:label xml:lang="en">patient health system stay ID</rdfs:label>
    <rdfs:label xml:lang="en">hospital admit offset</rdfs:label>
    <rdfs:label xml:lang="en">hospital discharge time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">hospital admit time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">unit discharge time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">age</rdfs:label>
    <rdfs:label xml:lang="en">has hospital</rdfs:label>
    <rdfs:label xml:lang="en">admission weight</rdfs:label>
    <rdfs:label xml:lang="en">gender</rdfs:label>
    <rdfs:label xml:lang="en">unit discharge location</rdfs:label>
    <rdfs:label xml:lang="en">unit discharge offset</rdfs:label>
    <rdfs:label xml:lang="en">admission height</rdfs:label>
    <rdfs:label xml:lang="en">unit admit source</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Hospital"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Patient">
    <rdfs:comment xml:lang="en">Represents a patient unit stay record from the 'patient' table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record in the eICU database.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record from the patient table. Referenced by diagnosis records via patientunitstayid foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the medication table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by nurse assessments and other clinical tables.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by nurse care entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient record in the eICU database, capturing demographic information, hospital and unit stay details, admission and discharge data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record from the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by treatment records.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:nurseCharting_hasPatientUnitStay">
    <rdfs:label xml:lang="en">nursing chart ID</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart entry offset</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart cell type category</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart cell type value label</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart value</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart cell type value name</rdfs:label>
    <rdfs:label xml:lang="en">nursing chart offset</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the nursing chart cell type value, identifying the specific data element being charted.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes from the unit admit time that the nursing chart entry was entered into the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse charting record to the corresponding patient unit stay in the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual value recorded for the nursing chart entry, stored as a string representation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a nursing chart entry (primary key).</rdfs:comment>
    <rdfs:comment xml:lang="en">The label of the nursing chart cell type value, providing a human-readable description of the charted measurement or observation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes from the unit admit time that the nursing chart observation was recorded.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category of the nursing chart cell type, e.g., Vital Signs, Scores, or other clinical categories.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:NurseCharting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hasPatientUnitStay">
    <rdfs:label xml:lang="en">managing physician</rdfs:label>
    <rdfs:label xml:lang="en">intervention category</rdfs:label>
    <rdfs:label xml:lang="en">active upon discharge</rdfs:label>
    <rdfs:label xml:lang="en">care provider save offset</rdfs:label>
    <rdfs:label xml:lang="en">provider type</rdfs:label>
    <rdfs:label xml:lang="en">specialty</rdfs:label>
    <rdfs:label xml:lang="en">care plan care provider ID</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">diagnosis priority</rdfs:label>
    <rdfs:label xml:lang="en">diagnosis string</rdfs:label>
    <rdfs:label xml:lang="en">ICD-9 code</rdfs:label>
    <rdfs:label xml:lang="en">diagnosis offset</rdfs:label>
    <rdfs:label xml:lang="en">diagnosis ID</rdfs:label>
    <rdfs:label xml:lang="en">nurse assessment ID</rdfs:label>
    <rdfs:label xml:lang="en">cell label</rdfs:label>
    <rdfs:label xml:lang="en">cell attribute</rdfs:label>
    <rdfs:label xml:lang="en">cell attribute value</rdfs:label>
    <rdfs:label xml:lang="en">nurse assessment entry offset</rdfs:label>
    <rdfs:label xml:lang="en">nurse assessment offset</rdfs:label>
    <rdfs:label xml:lang="en">cell attribute path</rdfs:label>
    <rdfs:label xml:lang="en">nurse care ID</rdfs:label>
    <rdfs:label xml:lang="en">nurse care entry offset</rdfs:label>
    <rdfs:label xml:lang="en">nurse care offset</rdfs:label>
    <rdfs:comment xml:lang="en">Links a care plan care provider record to the associated patient unit stay.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the care provider was active upon the patient's discharge.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category of intervention associated with the care provider in the care plan.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether this care provider is the managing physician for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the care plan care provider record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admit time when the care provider record was saved.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of care provider, e.g., attending, resident, nurse practitioner.</rdfs:comment>
    <rdfs:comment xml:lang="en">The medical specialty of the care provider.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the diagnosis was still active upon the patient's discharge. Stored as a string value up to 64 characters. Corresponds to the column 'activeupondischarge' in the diagnosis table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The full textual description or hierarchical path string of the diagnosis. Stored as a string value up to 200 characters. Corresponds to the column 'diagnosisstring' in the diagnosis table. Related to OBI:0000075 (diagnosis textual entity).</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Diagnosis record to the Patient unit stay it is associated with. Corresponds to the foreign key patientunitstayid referencing patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The ICD-9 diagnosis code associated with this diagnosis record. Stored as a string value up to 100 characters. Corresponds to the column 'icd9code' in the diagnosis table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique integer identifier for the diagnosis record. Corresponds to the primary key column 'diagnosisid' in the diagnosis table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission at which the diagnosis was recorded. Corresponds to the column 'diagnosisoffset' in the diagnosis table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The priority level of the diagnosis, indicating whether it is a primary or secondary diagnosis. Stored as a string value up to 10 characters. Corresponds to the column 'diagnosispriority' in the diagnosis table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The specific attribute name of the assessment cell being recorded in the nurse assessment.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the nurse assessment record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse assessment record to the corresponding patient unit stay record via patientunitstayid foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">The hierarchical path of the cell attribute in the nurse assessment form, representing the structured location of the assessment item.</rdfs:comment>
    <rdfs:comment xml:lang="en">The display label of the assessment cell in the nurse assessment form.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient unit stay admission to when the nurse assessment was entered into the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">The recorded value for the cell attribute in the nurse assessment, which may contain free text or structured values up to 4000 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient unit stay admission to the nurse assessment event.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse care record to the patient unit stay it is associated with. Foreign key relationship to the patient table via patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when the nurse care observation was made.</rdfs:comment>
    <rdfs:comment xml:lang="en">The specific attribute name within the nursing care flowsheet cell, describing the particular aspect of care being documented.</rdfs:comment>
    <rdfs:comment xml:lang="en">The full hierarchical path of the cell attribute within the nursing care flowsheet, providing context for the observation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The recorded value for the nursing care cell attribute, representing the actual observation, measurement, or assessment result.</rdfs:comment>
    <rdfs:comment xml:lang="en">The label of the nursing care flowsheet cell, identifying the type of nursing observation or assessment being recorded.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique integer identifier for each nurse care record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when the nurse care observation was entered into the system.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:CarePlanCareProvider"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Diagnosis"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:NurseAssessment"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:NurseCare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Note">
    <rdfs:comment xml:lang="en">Represents a clinical note entry recorded during a patient's unit stay, containing note type, path, value, and text information.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:lab_hasPatientUnitStay">
    <rdfs:label xml:lang="en">lab result text</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">lab result</rdfs:label>
    <rdfs:label xml:lang="en">lab result offset</rdfs:label>
    <rdfs:label xml:lang="en">lab measure name interface</rdfs:label>
    <rdfs:label xml:lang="en">lab name</rdfs:label>
    <rdfs:label xml:lang="en">lab measure name system</rdfs:label>
    <rdfs:label xml:lang="en">lab type ID</rdfs:label>
    <rdfs:label xml:lang="en">lab result revised offset</rdfs:label>
    <rdfs:label xml:lang="en">lab ID</rdfs:label>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admit time to the revised lab result time.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a lab result record to the patient unit stay it belongs to. Foreign key reference from lab.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary identifier for the lab result record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admit time to the lab result time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The textual representation of the laboratory test result, which may include non-numeric values.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the laboratory test performed (e.g., glucose, potassium, creatinine).</rdfs:comment>
    <rdfs:comment xml:lang="en">The numeric value of the laboratory test result.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the lab measure as defined in the source system.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifier for the type of lab test performed.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the lab measure as defined in the interface system.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:allergy_hasPatientUnitStay">
    <rdfs:comment xml:lang="en">The name of the drug associated with the allergy.</rdfs:comment>
    <rdfs:comment xml:lang="en">The HICL (Hierarchical Ingredient Code List) sequence number identifying the drug associated with the allergy.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the specific allergen.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of note associated with the allergy record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the allergy was written while the patient was in the eICU.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type or category of the allergy (e.g., drug, food, environment).</rdfs:comment>
    <rdfs:comment xml:lang="en">The specialty type of the care provider who entered the allergy.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the allergy record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an allergy record to the patient unit stay it belongs to. Foreign key from allergy.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admit time to the allergy event.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether a prescription was included with the allergy record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admit time to when the allergy was entered.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of user who entered the allergy record.</rdfs:comment>
    <rdfs:label xml:lang="en">allergy name</rdfs:label>
    <rdfs:label xml:lang="en">drug name</rdfs:label>
    <rdfs:label xml:lang="en">specialty type</rdfs:label>
    <rdfs:label xml:lang="en">user type</rdfs:label>
    <rdfs:label xml:lang="en">written in eICU</rdfs:label>
    <rdfs:label xml:lang="en">allergy offset</rdfs:label>
    <rdfs:label xml:lang="en">drug HICL sequence number</rdfs:label>
    <rdfs:label xml:lang="en">allergy note type</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">allergy entered offset</rdfs:label>
    <rdfs:label xml:lang="en">rx included</rdfs:label>
    <rdfs:label xml:lang="en">allergy type</rdfs:label>
    <rdfs:label xml:lang="en">allergy ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Allergy"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:apachePredVarHasPatientUnitStay">
    <rdfs:comment xml:lang="en">Indicator of whether the patient has diabetes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Fraction of inspired oxygen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Partial pressure of arterial oxygen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has hepatic failure.</rdfs:comment>
    <rdfs:comment xml:lang="en">Cardiac ejection fraction value.</rdfs:comment>
    <rdfs:comment xml:lang="en">Creatinine level of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient is immunosuppressed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Duration related to myocardial infarction.</rdfs:comment>
    <rdfs:comment xml:lang="en">Encoded discharge location of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Encoded gender of the patient used as a predictor variable.</rdfs:comment>
    <rdfs:comment xml:lang="en">Surgical ICU day indicator.</rdfs:comment>
    <rdfs:comment xml:lang="en">Out of bounds intubation indicator for day 1.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has metastatic cancer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Variable 03 representing hospital expected length of stay.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has leukemia.</rdfs:comment>
    <rdfs:comment xml:lang="en">Out of bounds ventilation indicator for day 1.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has lymphoma.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source of admission encoded as a predictor variable.</rdfs:comment>
    <rdfs:comment xml:lang="en">GCS verbal component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient was ventilated on day 1.</rdfs:comment>
    <rdfs:comment xml:lang="en">Age of the patient as a predictor variable.</rdfs:comment>
    <rdfs:comment xml:lang="en">Visit number for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Internal mammary artery usage indicator.</rdfs:comment>
    <rdfs:comment xml:lang="en">Teaching hospital type classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">Hospital bed count category.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient underwent elective surgery.</rdfs:comment>
    <rdfs:comment xml:lang="en">SAPS3 score for day 1.</rdfs:comment>
    <rdfs:comment xml:lang="en">Number of grafts for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 GCS eye opening component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">SAPS3 score for yesterday.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has cirrhosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">Admission diagnosis code used as a predictor variable.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient died in the hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the apachepredvar record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether thrombolytics were administered.</rdfs:comment>
    <rdfs:comment xml:lang="en">SAPS3 score for today.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 fraction of inspired oxygen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an Apache predictor variable record to the corresponding patient unit stay.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of active treatment status.</rdfs:comment>
    <rdfs:comment xml:lang="en">Medication-related sedation indicator affecting GCS scoring.</rdfs:comment>
    <rdfs:comment xml:lang="en">GCS eye opening component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 GCS verbal component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 GCS motor component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient is a readmission.</rdfs:comment>
    <rdfs:comment xml:lang="en">Geographic region code of the hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 medication-related sedation indicator affecting GCS scoring.</rdfs:comment>
    <rdfs:comment xml:lang="en">Management system type indicator.</rdfs:comment>
    <rdfs:comment xml:lang="en">GCS motor component score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Day 1 partial pressure of arterial oxygen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Acute myocardial infarction location indicator.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient has AIDS as a comorbidity.</rdfs:comment>
