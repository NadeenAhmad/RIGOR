  <rdf:Description rdf:about="http://example.org/ontology#db:hasPatientUnitStay">
    <rdfs:comment xml:lang="en">Indicates whether the drug record was written while the patient was in the eICU. Typically 'Yes' or 'No'.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of user (e.g., nurse, physician) who entered the admission drug record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The dosage amount of the admission drug, represented as a decimal value.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the drug the patient was taking at the time of admission.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an admission drug record to the patient unit stay it belongs to. Foreign key relationship to the patient table via patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes from the unit admit time that the drug was noted, representing the temporal offset of the drug record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The medical specialty type of the provider who entered the admission drug record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unit of measurement for the drug dosage, e.g., mg, mL, mcg.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the prescription was included in the admission drug record. Typically 'Yes' or 'No'.</rdfs:comment>
    <rdfs:comment xml:lang="en">The frequency at which the drug was being administered at the time of admission, e.g., daily, twice daily, PRN.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of note associated with the admission drug entry, e.g., admission or update.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Hierarchical Ingredient Code List (HICL) sequence number identifying the drug ingredient, used for standardized drug identification.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes from the unit admit time that the drug entry was recorded in the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the admission drug record. Primary key of the admissiondrug table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The predicted hospital length of stay in days based on the APACHE model.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether percutaneous transluminal coronary angioplasty (PTCA) was performed within 24 hours (integer flag).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient had a preoperative cardiac catheterization (integer flag).</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual ICU length of stay in days for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) actual number of ventilation days for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The speciality of the physician associated with this APACHE patient result.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicator of whether the patient had a preoperative myocardial infarction (integer flag).</rdfs:comment>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) ICU unit length of stay in days.</rdfs:comment>
    <rdfs:comment xml:lang="en">The version of the APACHE scoring system used (e.g., IV, IVa).</rdfs:comment>
    <rdfs:comment xml:lang="en">The predicted ICU length of stay in days based on the APACHE model.</rdfs:comment>
    <rdfs:comment xml:lang="en">The acute physiology score component of the APACHE scoring system.</rdfs:comment>
    <rdfs:comment xml:lang="en">The total APACHE score computed for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual hospital mortality outcome for the patient (e.g., ALIVE, EXPIRED).</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual hospital length of stay in days for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The predicted ICU mortality for the patient based on the APACHE model.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category of physician intervention associated with this APACHE patient result.</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual number of days the patient was on mechanical ventilation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the apachepatientresult record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The predicted number of ventilation days based on the APACHE model.</rdfs:comment>
    <rdfs:comment xml:lang="en">The actual ICU mortality outcome for the patient (e.g., ALIVE, EXPIRED).</rdfs:comment>
    <rdfs:comment xml:lang="en">The predicted hospital mortality for the patient based on the APACHE model.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) hospital length of stay in days.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an Apache Patient Result to the corresponding Patient unit stay record via patientunitstayid foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a care plan infectious disease record to the corresponding patient unit stay in the patient table. Corresponds to the foreign key patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit stay admission for the infectious disease care plan entry. Corresponds to column cplinfectdiseaseoffset.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the infectious disease was active upon the patient's discharge. Corresponds to column activeupondischarge.</rdfs:comment>
    <rdfs:comment xml:lang="en">The clinical assessment of the infectious disease, such as the identified organism or diagnosis. Corresponds to column infectdiseaseassessment.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a care plan infectious disease record. Corresponds to column cplinfectid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The anatomical site of the infectious disease. Corresponds to column infectdiseasesite.</rdfs:comment>
    <rdfs:comment xml:lang="en">The treatment administered for the infectious disease. Corresponds to column treatment.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient's response to therapy for the infectious disease. Corresponds to column responsetotherapy.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a respiratory charting record to the patient unit stay it belongs to. Foreign key reference to the patient table via patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The label describing the specific respiratory measurement or observation being recorded, e.g., FiO2, tidal volume, respiratory rate.</rdfs:comment>
    <rdfs:comment xml:lang="en">The recorded value of the respiratory measurement or observation identified by the value label.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category of the respiratory charting type, such as ventilator settings or respiratory assessment parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from ICU admission to the respiratory charting event.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a respiratory charting record (primary key).</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from ICU admission to when the respiratory charting entry was recorded in the system.</rdfs:comment>
    <rdfs:label xml:lang="en">drug note type</rdfs:label>
    <rdfs:label xml:lang="en">drug name</rdfs:label>
    <rdfs:label xml:lang="en">prescription included</rdfs:label>
    <rdfs:label xml:lang="en">drug admit frequency</rdfs:label>
    <rdfs:label xml:lang="en">written in eICU</rdfs:label>
    <rdfs:label xml:lang="en">specialty type</rdfs:label>
    <rdfs:label xml:lang="en">user type</rdfs:label>
    <rdfs:label xml:lang="en">drug entered offset</rdfs:label>
    <rdfs:label xml:lang="en">admission drug ID</rdfs:label>
    <rdfs:label xml:lang="en">drug dosage</rdfs:label>
    <rdfs:label xml:lang="en">drug offset</rdfs:label>
    <rdfs:label xml:lang="en">drug HICL sequence number</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">drug unit</rdfs:label>
    <rdfs:label xml:lang="en">physician speciality</rdfs:label>
    <rdfs:label xml:lang="en">unabridged hospital length of stay</rdfs:label>
    <rdfs:label xml:lang="en">actual ventilation days</rdfs:label>
    <rdfs:label xml:lang="en">predicted ICU mortality</rdfs:label>
    <rdfs:label xml:lang="en">predicted hospital mortality</rdfs:label>
    <rdfs:label xml:lang="en">unabridged actual ventilation days</rdfs:label>
    <rdfs:label xml:lang="en">APACHE score</rdfs:label>
    <rdfs:label xml:lang="en">predicted ICU length of stay</rdfs:label>
    <rdfs:label xml:lang="en">preoperative cardiac catheterization</rdfs:label>
    <rdfs:label xml:lang="en">preoperative myocardial infarction</rdfs:label>
    <rdfs:label xml:lang="en">APACHE version</rdfs:label>
    <rdfs:label xml:lang="en">actual ICU mortality</rdfs:label>
    <rdfs:label xml:lang="en">actual hospital mortality</rdfs:label>
    <rdfs:label xml:lang="en">physician intervention category</rdfs:label>
    <rdfs:label xml:lang="en">apache patient results id</rdfs:label>
    <rdfs:label xml:lang="en">actual ICU length of stay</rdfs:label>
    <rdfs:label xml:lang="en">actual hospital length of stay</rdfs:label>
    <rdfs:label xml:lang="en">unabridged unit length of stay</rdfs:label>
    <rdfs:label xml:lang="en">predicted ventilation days</rdfs:label>
    <rdfs:label xml:lang="en">PTCA within 24 hours</rdfs:label>
    <rdfs:label xml:lang="en">predicted hospital length of stay</rdfs:label>
    <rdfs:label xml:lang="en">acute physiology score</rdfs:label>
    <rdfs:label xml:lang="en">treatment</rdfs:label>
    <rdfs:label xml:lang="en">care plan infectious disease ID</rdfs:label>
    <rdfs:label xml:lang="en">infectious disease assessment</rdfs:label>
    <rdfs:label xml:lang="en">response to therapy</rdfs:label>
    <rdfs:label xml:lang="en">active upon discharge</rdfs:label>
    <rdfs:label xml:lang="en">care plan infectious disease offset</rdfs:label>
    <rdfs:label xml:lang="en">infectious disease site</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart entry offset</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart type category</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart offset</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart value</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart ID</rdfs:label>
    <rdfs:label xml:lang="en">respiratory chart value label</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:AdmissionDrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:ApachePatientResult"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:CarePlanInfectiousDisease"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:RespiratoryCharting"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:CarePlanGeneral">
    <rdfs:label xml:lang="en">Care Plan General</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents the careplangeneral table containing general care plan items associated with a patient unit stay.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:note_hasPatientUnitStay">
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit stay admission to when the note was entered into the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">The type or category of the clinical note, e.g., nursing note, physician note, etc. Maximum 50 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a note record to the patient unit stay it is associated with. Foreign key reference to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The structured value associated with the note entry. Maximum 150 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique integer identifier for the note record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The hierarchical path or classification path associated with the note entry. Maximum 255 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit stay admission to when the note was recorded.</rdfs:comment>
    <rdfs:comment xml:lang="en">The free-text content of the clinical note. Maximum 500 characters.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdfs:label xml:lang="en">note ID</rdfs:label>
    <rdfs:label xml:lang="en">note type</rdfs:label>
    <rdfs:label xml:lang="en">note value</rdfs:label>
    <rdfs:label xml:lang="en">note text</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">note path</rdfs:label>
    <rdfs:label xml:lang="en">note offset</rdfs:label>
    <rdfs:label xml:lang="en">note entered offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Note"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:pastHistory_hasPatientUnitStay">
    <rdfs:comment xml:lang="en">The type of note associated with the past history entry, e.g., admission or update note. Maximum 40 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The coded or structured value of the past history entry. Maximum 100 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time at which the past history record was entered into the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">The free-text description or additional textual detail associated with the past history value. Maximum 255 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a past history record to the patient unit stay it belongs to. Foreign key reference to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The hierarchical path string representing the category or classification of the past history item within the clinical documentation system. Maximum 255 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique integer identifier for the past history record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time at which the past history event is recorded.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:PastHistory"/>
    <rdfs:label xml:lang="en">past history value</rdfs:label>
    <rdfs:label xml:lang="en">past history ID</rdfs:label>
    <rdfs:label xml:lang="en">past history value text</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">past history entered offset</rdfs:label>
    <rdfs:label xml:lang="en">past history path</rdfs:label>
    <rdfs:label xml:lang="en">past history offset</rdfs:label>
    <rdfs:label xml:lang="en">past history note type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:treatmentHasPatientUnitStay">
    <rdfs:label xml:lang="en">treatment string</rdfs:label>
    <rdfs:label xml:lang="en">treatment offset</rdfs:label>
    <rdfs:label xml:lang="en">active upon discharge</rdfs:label>
    <rdfs:label xml:lang="en">treatment ID</rdfs:label>
    <rdfs:label xml:lang="en">treatment has patient unit stay</rdfs:label>
    <rdfs:comment xml:lang="en">The unique identifier for a treatment record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the treatment was still active upon the patient's discharge from the ICU. Typical values include 'True' or 'False'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a treatment record to the patient unit stay during which the treatment was administered. Foreign key reference to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">A descriptive string representing the treatment name or path. Aligned with ONS_0000044 (treatment descriptive name).</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient unit stay admission to when the treatment was recorded.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Treatment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:carePlanGeneral_hasPatientUnitStay">
    <rdfs:label xml:lang="en">care plan group</rdfs:label>
    <rdfs:label xml:lang="en">active upon discharge</rdfs:label>
    <rdfs:label xml:lang="en">care plan item value</rdfs:label>
    <rdfs:label xml:lang="en">care plan item offset</rdfs:label>
    <rdfs:label xml:lang="en">care plan general ID</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:comment xml:lang="en">The value or description of the care plan item.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the care plan item was active upon patient discharge.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission for the care plan item.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a care plan general record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The group or category to which the care plan item belongs.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a care plan general record to the associated patient unit stay in the patient table.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:CarePlanGeneral"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_etco2">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:comment xml:lang="en">End-tidal carbon dioxide (EtCO2) measurement in mmHg recorded periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">EtCO2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:CarePlanEOL">
    <rdfs:label xml:lang="en">Care Plan End of Life</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a record in the careplaneol table, capturing end-of-life care plan discussions and decisions for ICU patients.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:respiratoryCare_hasPatientUnitStay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">ventilation end offset</rdfs:label>
    <rdfs:label xml:lang="en">ventilation start offset</rdfs:label>
    <rdfs:label xml:lang="en">PEEP limit</rdfs:label>
    <rdfs:label xml:lang="en">respiratory care ID</rdfs:label>
    <rdfs:label xml:lang="en">sigh pressure limit</rdfs:label>
    <rdfs:label xml:lang="en">set apnea respiratory rate</rdfs:label>
    <rdfs:label xml:lang="en">apnea parameters</rdfs:label>
    <rdfs:label xml:lang="en">set apnea I:E ratio</rdfs:label>
    <rdfs:label xml:lang="en">airway position</rdfs:label>
    <rdfs:label xml:lang="en">set apnea FiO2</rdfs:label>
    <rdfs:label xml:lang="en">high inspired oxygen limit</rdfs:label>
    <rdfs:label xml:lang="en">low peak pressure limit</rdfs:label>
