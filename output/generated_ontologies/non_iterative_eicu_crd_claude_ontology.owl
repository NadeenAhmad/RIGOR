  <rdf:Description rdf:about="http://example.org/ontology#:medication_hasPatientUnitStay">
    <rdfs:label xml:lang="en">drug HICL sequence number</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">drug stop offset</rdfs:label>
    <rdfs:label xml:lang="en">drug order offset</rdfs:label>
    <rdfs:label xml:lang="en">GTC</rdfs:label>
    <rdfs:label xml:lang="en">drug name</rdfs:label>
    <rdfs:label xml:lang="en">PRN</rdfs:label>
    <rdfs:label xml:lang="en">drug order cancelled</rdfs:label>
    <rdfs:label xml:lang="en">loading dose</rdfs:label>
    <rdfs:label xml:lang="en">drug IV admixture</rdfs:label>
    <rdfs:label xml:lang="en">medication ID</rdfs:label>
    <rdfs:label xml:lang="en">route of administration</rdfs:label>
    <rdfs:label xml:lang="en">drug start offset</rdfs:label>
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <rdfs:label xml:lang="en">dosage</rdfs:label>
    <rdfs:comment xml:lang="en">Unique identifier for the medication record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the drug is an intravenous admixture (e.g., 'Yes' or 'No').</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the medication is administered on an as-needed (PRN) basis.</rdfs:comment>
    <rdfs:comment xml:lang="en">The dosage of the medication as a string, including amount and unit (e.g., '500 mg').</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient unit stay admission to when the drug administration started.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Generic Therapeutic Class code associated with the medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the drug order was cancelled (e.g., 'Yes' or 'No').</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the drug that was ordered for the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The frequency at which the medication is administered (e.g., 'BID', 'Q6H', 'PRN').</rdfs:comment>
    <rdfs:comment xml:lang="en">The loading dose of the medication, if applicable.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medication record to the patient unit stay during which the medication was ordered.</rdfs:comment>
    <rdfs:comment xml:lang="en">The HICL (Hierarchical Ingredient Code List) sequence number identifying the drug ingredient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient unit stay admission to when the drug administration was stopped.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient unit stay admission to when the drug was ordered.</rdfs:comment>
    <rdfs:comment xml:lang="en">The route by which the medication is administered (e.g., 'Oral', 'IV', 'Subcutaneous').</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Medication"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:microlab_hasPatientUnitStay">
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
