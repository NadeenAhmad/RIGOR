    <rdfs:comment xml:lang="en">Links an intake output record to the patient unit stay it belongs to.</rdfs:comment>
    <rdfs:comment xml:lang="en">Net fluid balance total (intake minus output minus dialysis), measured as a decimal quantity.</rdfs:comment>
    <rdfs:comment xml:lang="en">Hierarchical path identifying the category and type of the intake or output entry within the flowsheet.</rdfs:comment>
    <rdfs:comment xml:lang="en">Text value recorded for the specific intake or output cell entry, used when the value is non-numeric.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from unit admission for the individual intake output entry.</rdfs:comment>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission for the intake output record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Total dialysis fluid volume for the record, measured as a decimal quantity.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:IntakeOutput"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_st1">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">ST segment measurement from ECG lead 1 recorded periodically.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:label xml:lang="en">ST1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:BFO_0000182">
    <rdfs:comment xml:lang="en">A history as defined in BFO — a temporal entity representing the totality of processes taking place in a region of spacetime.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">history</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_systemicDiastolic">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Systemic diastolic blood pressure measurement in mmHg recorded periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">systemic diastolic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_hasPatientUnitStay">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:comment xml:lang="en">Links a vital periodic measurement record to the patient unit stay it belongs to.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#eicu:Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:numBedsCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Category describing the number of beds available in the hospital, e.g., a range or size classification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Hospital"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">number of beds category</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:VitalAperiodic">
    <rdfs:label xml:lang="en">Vital Aperiodic</rdfs:label>
    <rdfs:comment xml:lang="en">Represents aperiodic vital sign measurements for a patient unit stay, including non-invasive blood pressure, cardiac output, and vascular resistance parameters.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:NurseCharting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a record in the nursecharting table, capturing nursing chart entries including vital signs and other observations recorded by nurses during a patient's ICU stay.</rdfs:comment>
    <rdfs:label xml:lang="en">Nurse Charting</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_drugRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">drug rate</rdfs:label>
    <rdfs:comment xml:lang="en">The rate at which the drug is being administered, represented as a string value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:customLab_hasPatientUnitStay">
    <rdfs:comment xml:lang="en">The result value of the custom lab test, corresponding to labotherresult (up to 64 characters).</rdfs:comment>
    <rdfs:comment xml:lang="en">The time offset in minutes from ICU admission to when the custom lab result was recorded.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a custom lab record to the patient unit stay it belongs to, corresponding to the foreign key patientunitstayid referencing patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The identifier for the type of custom lab test performed, corresponding to labothertypeid.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the custom lab test, corresponding to labothername (up to 64 characters).</rdfs:comment>
    <rdfs:comment xml:lang="en">Additional textual value or description associated with the custom lab result, corresponding to labothervaluetext (up to 128 characters).</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a custom lab record, corresponding to the primary key customlabid.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lab other value text</rdfs:label>
    <rdfs:label xml:lang="en">lab other result</rdfs:label>
    <rdfs:label xml:lang="en">lab other offset</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">lab other name</rdfs:label>
    <rdfs:label xml:lang="en">lab other type ID</rdfs:label>
    <rdfs:label xml:lang="en">custom lab ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:CustomLab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Hospital">
    <rdfs:label xml:lang="en">Hospital</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a hospital entity containing information about the facility including bed count category, teaching status, and geographic region.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icdo:ICDO_0000397">
    <rdfs:comment xml:lang="en">A person awaiting admission to an adequate facility elsewhere.</rdfs:comment>
    <rdfs:label xml:lang="en">person awaiting admission to adequate facility elsewhere</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Patient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record in the eICU database.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record from the patient table. Individuals bearing an OBI patient role (OBI_0000093).</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the patient table containing patient unit stay information.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by care plan goals and other clinical tables.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by infusion drug records.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the intakeoutput table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by microbiology lab results.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by clinical notes and other clinical data tables.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record from the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the pasthistory table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by the physical exam table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by respiratory charting entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by vital aperiodic measurements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_st2">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:label xml:lang="en">ST2</rdfs:label>
    <rdfs:comment xml:lang="en">ST segment measurement from ECG lead 2 recorded periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Hospital">
    <rdfs:label xml:lang="en">Hospital</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a hospital entity referenced by patient records.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_infusionRate">
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">infusion rate</rdfs:label>
    <rdfs:comment xml:lang="en">The rate of the infusion, represented as a string value.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Treatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a treatment record administered to a patient during an ICU stay. Aligned with OGMS_0000090 (treatment).</rdfs:comment>
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_patientWeight">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of the infusion, represented as a string value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">patient weight</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_paMean">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">PA mean</rdfs:label>
    <rdfs:comment xml:lang="en">Pulmonary artery mean pressure measurement in mmHg recorded periodically.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_sao2">
    <rdfs:comment xml:lang="en">Arterial oxygen saturation (SaO2) percentage measured periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">SaO2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:region">
    <rdfs:label xml:lang="en">region</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Hospital"/>
    <rdfs:comment xml:lang="en">Geographic region where the hospital is located.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:CarePlanGoal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a goal within a patient's care plan during an ICU stay. Each record captures a specific goal, its category, value, status, and whether it was active upon discharge.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan Goal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:hospitalId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for the hospital.</rdfs:comment>
    <rdfs:label xml:lang="en">hospital ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Hospital"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_volumeOfFluid">
    <rdfs:comment xml:lang="en">The volume of fluid used in the infusion, represented as a string value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">volume of fluid</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:teachingStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Hospital"/>
    <rdfs:label xml:lang="en">teaching status</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the hospital is a teaching hospital. Encoded as a small integer (e.g., 0 for non-teaching, 1 for teaching).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_systemicSystolic">
    <rdfs:label xml:lang="en">systemic systolic</rdfs:label>
    <rdfs:comment xml:lang="en">Systemic systolic blood pressure measurement in mmHg recorded periodically.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Allergy">
    <rdfs:label xml:lang="en">Allergy</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a recorded allergy entry for a patient unit stay, corresponding to the 'allergy' database table. Aligned with OBI_1110049 (allergy) and DOID_1205 (allergic disease).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Microlab">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents microbiology laboratory culture and sensitivity test results for patients in the ICU. Each record captures a culture taken from a specific site, the organism identified, the antibiotic tested, and the sensitivity level.</rdfs:comment>
    <rdfs:label xml:lang="en">Microlab</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:ApachePredVar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents the apachepredvar table containing APACHE prediction variables used for ICU severity scoring and outcome prediction.</rdfs:comment>
    <rdfs:label xml:lang="en">Apache Predictor Variable</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_respiration">
    <rdfs:comment xml:lang="en">The patient's respiratory rate in breaths per minute recorded periodically.</rdfs:comment>
    <rdfs:label xml:lang="en">respiration</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_drugName">
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:label xml:lang="en">drug name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The name of the drug being infused to the patient.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Medication">
    <rdfs:comment xml:lang="en">Represents a medication order record for a patient unit stay in the eICU database. Each instance captures details about a drug order including drug name, dosage, route of administration, frequency, and timing offsets.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:PastHistory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a past medical history record for a patient during an ICU unit stay. Each record captures a specific element of the patient's anamnesis (medical history) including the type, path, value, and timing information.</rdfs:comment>
    <rdfs:label xml:lang="en">Past History</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:NurseCare">
    <rdfs:comment xml:lang="en">Represents a nurse care record documenting nursing observations, assessments, and interventions for a patient during an ICU stay. Related to UBERON:0018685 (nursing stage) and ICDO:0000449 (nonadministration of surgical and medical care).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nurse Care</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:VitalPeriodic">
    <rdfs:label xml:lang="en">Vital Periodic</rdfs:label>
    <rdfs:comment xml:lang="en">Represents periodic vital sign measurements recorded for a patient during their ICU stay. Each record contains time-stamped physiological measurements including temperature, oxygen saturation, heart rate, respiration, and various pressure readings.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:CustomLab">
    <rdfs:comment xml:lang="en">Represents a custom laboratory test result recorded for a patient during an ICU stay. Each instance corresponds to a row in the customlab table.</rdfs:comment>
    <rdfs:label xml:lang="en">Custom Lab</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_cvp">
    <rdfs:label xml:lang="en">CVP</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:comment xml:lang="en">Central venous pressure (CVP) measurement in mmHg recorded periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:ApachePatientResult">
    <rdfs:comment xml:lang="en">Represents a record from the apachepatientresult table containing APACHE scoring results, predicted and actual ICU/hospital mortality and length of stay, and related clinical indicators for a patient unit stay.</rdfs:comment>
    <rdfs:label xml:lang="en">Apache Patient Result</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:AdmissionDx">
    <rdfs:label xml:lang="en">Admission Diagnosis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a diagnosis recorded at the time of admission to the ICU. Each record captures the diagnosis path, name, and text associated with a patient unit stay.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_observationOffset">
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission when the vital sign observation was recorded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:label xml:lang="en">observation offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:NurseAssessment">
    <rdfs:label xml:lang="en">Nurse Assessment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a nurse assessment record for a patient unit stay, capturing structured assessment data including cell attributes and their values. Related to UBERON:0018685 (nursing stage) and ONS:0000041 (compliance assessment).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_icp">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Intracranial pressure (ICP) measurement in mmHg recorded periodically.</rdfs:comment>
    <rdfs:label xml:lang="en">ICP</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_paDiastolic">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">PA diastolic</rdfs:label>
    <rdfs:comment xml:lang="en">Pulmonary artery diastolic pressure measurement in mmHg recorded periodically.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:PhysicalExam">
    <rdfs:label xml:lang="en">Physical Exam</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a physical examination record for a patient during an ICU stay. Each record captures a specific physical exam finding including the exam path, value, and textual description. Aligned with OGMS:0000057 (physical examination).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_heartRate">
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">heart rate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The patient's heart rate in beats per minute recorded periodically.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_vitalPeriodicId">
    <rdfs:comment xml:lang="en">Unique identifier for each vital periodic measurement record.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">vital periodic ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_st3">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">ST3</rdfs:label>
    <rdfs:comment xml:lang="en">ST segment measurement from ECG lead 3 recorded periodically.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:Patient">
    <rdfs:comment xml:lang="en">Represents a patient unit stay record referenced by vital periodic measurements.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_paSystolic">
    <rdfs:comment xml:lang="en">Pulmonary artery systolic pressure measurement in mmHg recorded periodically.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">PA systolic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:ICDO_0000614">
    <rdfs:comment xml:lang="en">External ontology concept representing respiratory failure (ICDO_0000614).</rdfs:comment>
    <rdfs:label xml:lang="en">Respiratory Failure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#doid:DOID_670">
    <rdfs:comment xml:lang="en">A condition of amphetamine abuse, referenced from the Disease Ontology.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">amphetamine abuse</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_infusionDrugId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">infusion drug ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:comment xml:lang="en">The unique integer identifier for the infusion drug record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:CarePlanCareProvider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Care Plan Care Provider</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a care provider entry within a patient's care plan, including provider type, specialty, intervention category, and discharge status. Related to ICDO:ICDO_0000540 (problems related to care provider dependency).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eicu:vitalPeriodic_temperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The patient's body temperature measurement recorded periodically.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#eicu:VitalPeriodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">temperature</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Diagnosis">
    <rdfs:comment xml:lang="en">Represents a diagnosis record associated with a patient unit stay. Each instance captures a clinical diagnosis including its ICD-9 code, priority, timing offset, and discharge status. Corresponds to the 'diagnosis' database table. Related to OGMS:0000073 (diagnosis).</rdfs:comment>
    <rdfs:label xml:lang="en">Diagnosis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_hasPatientUnitStay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:comment xml:lang="en">Links an infusion drug record to the patient unit stay during which the infusion was administered.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#doid:DOID_9974">
    <rdfs:label xml:lang="en">drug dependence</rdfs:label>
    <rdfs:comment xml:lang="en">A condition of drug dependence, referenced from the Disease Ontology.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:AdmissionDrug">
    <rdfs:comment xml:lang="en">Represents a drug that a patient was taking at the time of admission to the ICU. Each instance corresponds to a row in the admissiondrug table.</rdfs:comment>
    <rdfs:label xml:lang="en">Admission Drug</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:infusionDrug_drugAmount">
    <rdfs:domain rdf:resource="http://example.org/ontology#db:InfusionDrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">drug amount</rdfs:label>
    <rdfs:comment xml:lang="en">The amount of the drug in the infusion, represented as a string value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Lab">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a laboratory test result record associated with a patient unit stay in the eICU database.</rdfs:comment>
    <rdfs:label xml:lang="en">Lab</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:RespiratoryCharting">
    <rdfs:label xml:lang="en">Respiratory Charting</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents respiratory charting records for patients in the ICU. Each record captures a respiratory measurement or observation at a specific time offset. Related to respiratory gaseous exchange (GO:0007585) and respiratory conditions (ICDO:0000614, ICDO:0000218).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:RespiratoryCare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Respiratory Care</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a respiratory care record from the respiratorycare table, documenting airway management, ventilator settings, alarm limits, and apnea parameters for a patient ICU stay.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:IntakeOutput">
    <rdfs:comment xml:lang="en">Represents a record of fluid intake and output measurements for a patient during an ICU unit stay. Each record captures intake totals, output totals, dialysis totals, net totals, and individual cell-level entries.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Intake Output</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icdo:ICDO_0000541">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">other problems related to medical facilities and other health care</rdfs:label>
    <rdfs:comment xml:lang="en">Problems related to medical facilities and other health care services.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:CarePlanInfectiousDisease">
    <rdfs:comment xml:lang="en">Represents an infectious disease entry within a patient's care plan, including site, assessment, response to therapy, and treatment information. Corresponds to the careplaninfectiousdisease database table.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan Infectious Disease</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icdo:ICDO_0000411">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A condition acquired in a hospital or healthcare facility.</rdfs:comment>
    <rdfs:label xml:lang="en">nosocomial condition</rdfs:label>
  </rdf:Description>
</rdf:RDF>
