  <rdf:Description rdf:about="http://example.org/ontology#db:intakeOutputHasPatientUnitStay">
    <rdfs:label xml:lang="en">dialysis total</rdfs:label>
    <rdfs:label xml:lang="en">cell value numeric</rdfs:label>
    <rdfs:label xml:lang="en">output total</rdfs:label>
    <rdfs:label xml:lang="en">has patient unit stay</rdfs:label>
    <rdfs:label xml:lang="en">cell path</rdfs:label>
    <rdfs:label xml:lang="en">cell value text</rdfs:label>
    <rdfs:label xml:lang="en">net total</rdfs:label>
    <rdfs:label xml:lang="en">intake output offset</rdfs:label>
    <rdfs:label xml:lang="en">intake total</rdfs:label>
    <rdfs:label xml:lang="en">cell label</rdfs:label>
    <rdfs:label xml:lang="en">intake output ID</rdfs:label>
    <rdfs:label xml:lang="en">intake output entry offset</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric value recorded for the specific intake or output cell entry, measured as a decimal quantity.</rdfs:comment>
    <rdfs:comment xml:lang="en">Label of the specific intake or output cell entry, describing the type of fluid or measurement.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the intake output record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Total fluid intake value for the record, measured as a decimal quantity. Related to the concept of energy or fluid intake measurement.</rdfs:comment>
