<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:prov="http://www.w3.org/ns/prov#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology#TSH_mU_per_l">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/TSH_mU_per_l"/>
    <rdfs:comment xml:lang="en">Thyroid-Stimulating Hormone concentration measured in milli-units per litre (mU/l). Used to assess thyroid function.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:label xml:lang="en">Thyroid-Stimulating Hormone (TSH)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasPatientData">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Icd"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#PatientData"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/icd/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/patient_id"/>
    <rdfs:label xml:lang="en">has patient data</rdfs:label>
    <rdfs:label xml:lang="en">Has Patient Data</rdfs:label>
    <rdfs:label xml:lang="en">has Patient Data</rdfs:label>
    <rdfs:comment xml:lang="en">Links a complication record to the associated patient data record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a general aftercare record to the patient data entry it belongs to. Resolved from the foreign key column patient_id referencing patient_data.patient_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the operational details record to the associated patient data record. Resolves foreign key from patient_id to the PatientData class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a general histology record to the patient data of the patient who underwent the histological examination. Resolves foreign key from histology_general.patient_id to patient_data.patient_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an ICD diagnosis record to the patient for whom the diagnosis was documented. Resolves the foreign key from icd.patient_id to patient_data.patient_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a laboratory analysis record to the patient data of the patient for whom the tests were performed. Derived from the foreign key patient_id referencing patient_data.patient_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medical history record to the associated patient data. Derived from foreign key column 'patient_id' referencing patient_data.patient_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medication record to the patient data record it belongs to. Resolves foreign key from medication.patient_id to patient_data.patient_id.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_4">
    <rdfs:label xml:lang="en">Additional Medication 4</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a fourth additional medication not covered by the standard categories. True if present, false otherwise. Detailed description in weitere_Medikation_4_Text.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rez_cholangitis">
    <rdfs:label xml:lang="en">Recurring Cholangitis</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/rez_cholangitis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient experienced recurring cholangitis (Rez Cholangitiden), i.e., recurrent bile duct infections. Boolean: true if present, false otherwise. Source DB type: TINYINT.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#incisional_hernia_surgery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether surgical treatment for the incisional hernia was performed (OP Narbenbruch). Boolean: true if surgery was performed, false otherwise. Source DB type: TINYINT.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/incisional_hernia_surgery"/>
    <rdfs:label xml:lang="en">Incisional Hernia Surgery</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#duration_of_inpatient_stay_d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Total duration of the patient's inpatient hospital stay, measured in days (d).</rdfs:comment>
    <rdfs:label xml:lang="en">duration of inpatient stay</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/duration_of_inpatient_stay_d"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#number_ecs">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">Number of erythrocyte concentrate (red blood cell) units transfused during the operation (German: Anzahl EK's). Unit: count of packed red blood cell units.</rdfs:comment>
    <rdfs:label xml:lang="en">Number of Erythrocyte Concentrates</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/number_ecs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Antihypertensiva">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Antihypertensiva"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking antihypertensive medications used to lower blood pressure. True if prescribed, false otherwise.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:label xml:lang="en">Antihypertensive Medication</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#thrombosis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">thrombosis</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/thrombosis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed thrombosis (blood clot formation) postoperatively.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#op_date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The date on which the surgical operation was performed (German: OP Datum).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/op_date"/>
    <rdfs:label xml:lang="en">Operation Date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ototoxicity">
    <rdfs:label xml:lang="en">Ototoxicity</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced ototoxicity (Ototoxizität), i.e., hearing damage or loss as a side effect, commonly associated with Cisplatin.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/ototoxicity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#treatment_of_stenosis">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/treatment_of_stenosis"/>
    <rdfs:comment xml:lang="en">Free-text description of the treatment or intervention for bile duct stenosis (Versorgung der Stenose).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Treatment of Bile Duct Stenosis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_4"/>
    <rdfs:label xml:lang="en">other complication 4</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text field for the fourth additional complication not listed in the predefined categories.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diabetes_mellitus_id">
    <rdfs:label xml:lang="en">Diabetes Mellitus Identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#DiabetesMellitus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diabetes_mellitus/diabetes_mellitus_id"/>
    <rdfs:comment xml:lang="en">Primary key identifier for a diabetes mellitus type record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#alopecia">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Alopecia (Hair Loss)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/alopecia"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced alopecia (Alopezie), i.e., hair loss, as a side effect of chemotherapy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#capecitabine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Capecitabine, an oral prodrug of 5-Fluorouracil used in cancer treatment, was administered.</rdfs:comment>
    <rdfs:label xml:lang="en">Capecitabine Administered</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/capecitabine"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Labour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents a set of laboratory test results for a patient, collected either preoperatively or before discharge. Each instance corresponds to a single laboratory analysis event. System-generated ETL columns (s_ColLineage, s_Generation, s_GUID, s_Lineage) present in the source database schema are intentionally excluded as they carry no clinical meaning.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour"/>
    <rdfs:label xml:lang="en">Laboratory Analysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intraop_special_features_text">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/intraop_special_features_text"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text description of special circumstances or notable events during the operation (German: intraop Besonderheiten Text).</rdfs:comment>
    <rdfs:label xml:lang="en">Intraoperative Special Features Text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HbA1c_percent">
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/HbA1c_percent"/>
    <rdfs:comment xml:lang="en">Glycated hemoglobin measured as a percentage (%). Shows the average blood sugar level over the last 2-3 months.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">Glycated Hemoglobin (HbA1c)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Icd"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique primary key identifier for the chemotherapy treatment record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the complication record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the general aftercare record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each general operational details record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique primary key identifier for a general histology examination record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each ICD diagnosis record in the database.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique integer identifier (primary key) for the medication record.</rdfs:comment>
    <rdfs:label xml:lang="en">Record Identifier</rdfs:label>
    <rdfs:label xml:lang="en">complication identifier</rdfs:label>
    <rdfs:label xml:lang="en">Aftercare Record ID</rdfs:label>
    <rdfs:label xml:lang="en">General Operational Details Identifier</rdfs:label>
    <rdfs:label xml:lang="en">Histology General ID</rdfs:label>
    <rdfs:label xml:lang="en">ICD Record Identifier</rdfs:label>
    <rdfs:label xml:lang="en">Medication Record ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/icd/id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#abdominal_pain">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/abdominal_pain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">abdominal pain</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports abdominal pain (Abdominelle Schmerzen).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#postoperative_bleeding">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced postoperative bleeding (hemorrhage).</rdfs:comment>
    <rdfs:label xml:lang="en">postoperative bleeding</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/postoperative_bleeding"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_pre_existing_diseases"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has other pre-existing diseases not captured by specific fields (Andere Vorerkrankungen).</rdfs:comment>
    <rdfs:label xml:lang="en">other pre-existing diseases</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complication_management">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">other complication management</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether other complication management strategies not explicitly listed were applied.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complication_management"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#continuous_bladder_catheter">
    <rdfs:label xml:lang="en">Continuous Bladder Catheter</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether a continuous (indwelling) urinary bladder catheter was placed (German: Blasendauerkatheter). True if a bladder catheter was inserted.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/continuous_bladder_catheter"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anaesthesia_duration_min">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Anaesthesia Duration in Minutes</rdfs:label>
    <rdfs:comment xml:lang="en">Total duration of anesthesia measured in minutes (German: Anästhesiedauer). Unit: minutes.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/anaesthesia_duration_min"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasMetastases">
    <rdfs:label xml:lang="en">has type of primary metastasis</rdfs:label>
    <rdfs:comment xml:lang="en">Links a medical history record to the type of primary metastasis. Derived from foreign key column 'type_primary_metastasis' referencing metastases.metastasen_id.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/type_primary_metastasis"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Metastases"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pdt_cycles">
    <rdfs:comment xml:lang="en">The total number of Photodynamic Therapy (PDT) cycles administered to the patient.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Number of PDT Cycles</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/pdt_cycles"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HistologyGeneral">
    <rdfs:comment xml:lang="en">Represents a general histological examination record, documenting the pathologist, order number, histological diagnosis, and a summary of histological findings for a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: id exactly 1 xsd:integer</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general"/>
    <rdfs:label xml:lang="en">General Histology</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#caudal_block">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Caudal Block</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/caudal_block"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">Indicates whether a caudal block was performed, a type of epidural injection administered through the sacral hiatus (German: Kaudalblock). True if caudal block was used.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intraop_special_features">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Intraoperative Special Features</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether there were special circumstances or notable events during the operation (German: intraop Besonderheiten). True if special features were noted.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/intraop_special_features"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#previous_secondary_tumour">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">previous secondary tumour</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/previous_secondary_tumour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a history of a previous secondary (metastatic) tumour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hepatitis_C">
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has hepatitis C as a cause of liver disease (Ursache Hepatitis C).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hepatitis C</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/hepatitis_C"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ChildStadium">
    <rdfs:comment xml:lang="en">Represents the Child-Pugh classification stage for liver cirrhosis severity. Used to assess the prognosis of chronic liver disease, mainly cirrhosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: child_stadium_id exactly 1 xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the Child-Pugh classification, a clinical scoring system used to assess the severity of chronic liver disease, including cirrhosis. The classification evaluates liver function based on clinical and laboratory parameters to predict disease progression and guide treatment decisions. Stages include: 0 = no cirrhosis (keine Zirrhose), 1 = Child A (mild/compensated cirrhosis), 2 = Child B (moderate/decompensated cirrhosis), 3 = Child C (severe/decompensated cirrhosis), 99 = no information provided (keine Angabe).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/child_stadium"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Child-Pugh Stadium</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#loss_of_appetite">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">loss of appetite</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports loss of appetite (Appetitlosigkeit).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/loss_of_appetite"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Urikostatika">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Urikostatika"/>
    <rdfs:label xml:lang="en">Uricostatic Medication</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking uricostatic medications to lower uric acid levels, e.g., for gout treatment. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#date_laboratory_analysis">
    <rdfs:label xml:lang="en">Date of Laboratory Analysis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/date_laboratory_analysis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:comment xml:lang="en">The calendar date on which the laboratory analysis was performed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pneumonia">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/pneumonia"/>
    <rdfs:label xml:lang="en">pneumonia</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed pneumonia as a postoperative complication.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#back_pain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/back_pain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports back pain (Rueckenschmerzen).</rdfs:comment>
    <rdfs:label xml:lang="en">back pain</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#previous_tumour_text">
    <rdfs:comment xml:lang="en">Free-text description of the patient's previous primary tumour, including type and location.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">previous tumour text</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/previous_tumour_text"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#oxaliplatin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Oxaliplatin Administered</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Oxaliplatin, a platinum-based antineoplastic agent, was used in the treatment regimen.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/oxaliplatin"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#thoracic_drainage_for_effusion">
    <rdfs:label xml:lang="en">thoracic drainage for effusion</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/thoracic_drainage_for_effusion"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether thoracic drainage was used to remove fluid from the pleural space.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#liver_failure">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed liver failure as a postoperative complication.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">liver failure</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/liver_failure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#interventional_drainage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/interventional_drainage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether imaging-guided interventional drainage was performed to treat abscesses or fluid collections.</rdfs:comment>
    <rdfs:label xml:lang="en">interventional drainage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Diuretika">
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking diuretics, used to remove excess fluid and treat high blood pressure. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Diuretika"/>
    <rdfs:label xml:lang="en">Diuretics</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_chemotherapeutics_ii">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for specifying the second additional chemotherapeutic agent not listed among the predefined options.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/other_chemotherapeutics_ii"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Other Chemotherapeutic Agent II</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#readmission_to_clinic_date">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/readmission_to_clinic_date"/>
    <rdfs:comment xml:lang="en">The date of the patient's readmission to the clinic. Stored as TEXT in the source database but semantically represents a date.</rdfs:comment>
    <rdfs:label xml:lang="en">readmission date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#spa">
    <rdfs:label xml:lang="en">Spinal Anaesthesia (SpA)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether spinal anesthesia was administered, involving injection of local anesthetic into the subarachnoid space (German: SpA - Spinalanästhesie). True if spinal anesthesia was used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/spa"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ascites_severity">
    <rdfs:comment xml:lang="en">Text description of the severity of ascites, if present. Typical values may include mild, moderate, or severe.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">ascites severity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/ascites_severity"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Cholinesterase_μmol_per_l">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Cholinesterase_μmol_per_l"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Cholinesterase concentration measured in micromoles per litre (μmol/l). Assesses liver function and nutritional status.</rdfs:comment>
    <rdfs:label xml:lang="en">Cholinesterase</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patient_id">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Integer identifier referencing the patient who received the treatment.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the patient data record.</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique integer identifier assigned to the patient within the clinical database system. Serves as the primary key for the patient data record.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/patient_id"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data/patient_id"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Patient Identifier</rdfs:label>
    <rdfs:label xml:lang="en">Patient ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient had other complications not covered by the specific complication fields.</rdfs:comment>
    <rdfs:label xml:lang="en">other complications</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#AP_μmol_per_l">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/AP_μmol_per_l"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">Alkaline Phosphatase (AP)</rdfs:label>
    <rdfs:comment xml:lang="en">Alkaline Phosphatase concentration measured in micromoles per litre (μmol/l). Checks liver and bone health.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasClavienDindo">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">has Clavien-Dindo classification</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a complication record to its Clavien-Dindo classification grade, indicating the severity of the surgical complication.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/clavien_dindo"/>
    <rdfs:range rdf:resource="http://example.org/ontology#ClavienDindo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_5_Text">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text description of the fifth additional medication prescribed to the patient.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_5_Text"/>
    <rdfs:label xml:lang="en">Additional Medication 5 Description</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#emesis">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/emesis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced emesis (vomiting) as a side effect of treatment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Emesis (Vomiting)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Harnstoff_mmol_per_l">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Harnstoff_mmol_per_l"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Urea (Harnstoff)</rdfs:label>
    <rdfs:comment xml:lang="en">Urea concentration measured in millimoles per litre (mmol/l). Indicates kidney function and protein metabolism.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#orale_Antidiabetika">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/orale_Antidiabetika"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Oral Antidiabetic Medication</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking oral antidiabetic medications for diabetes management. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#her_2_status">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/her_2_status"/>
    <rdfs:comment xml:lang="en">Human Epidermal Growth Factor Receptor 2 (HER-2) status, an important biomarker used in breast cancer and other cancers. Encoded as integer: typically 0 = negative, 1 = equivocal (1+), 2 = equivocal (2+), 3 = positive (3+). HER-2 overexpression may indicate eligibility for targeted therapy such as Trastuzumab.</rdfs:comment>
    <rdfs:label xml:lang="en">HER-2 Receptor Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#oedema">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/oedema"/>
    <rdfs:label xml:lang="en">oedema</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient presents with oedema, i.e., swelling caused by fluid retention (Oedeme).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#tace">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Transarterial Chemoembolization (TACE) was performed. TACE is a localized interventional treatment for liver tumors combining intra-arterial chemotherapy with embolization.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">TACE Performed</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/tace"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_3_Text">
    <rdfs:label xml:lang="en">Additional Medication 3 Description</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_3_Text"/>
    <rdfs:comment xml:lang="en">Free-text description of the third additional medication prescribed to the patient.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_chemotherapeutics_iii">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/other_chemotherapeutics_iii"/>
    <rdfs:label xml:lang="en">Other Chemotherapeutic Agent III</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text field for specifying the third additional chemotherapeutic agent not listed among the predefined options.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#adhesions">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/adhesions"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether adhesions (scar tissue from previous surgeries or inflammation) were found intraoperatively (German: Adhäsionen). True if adhesions were present.</rdfs:comment>
    <rdfs:label xml:lang="en">Adhesions</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PatientData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Patient Data</rdfs:label>
    <rdfs:comment xml:lang="en">Represents demographic and identification data for a patient, including age at surgery and sex.</rdfs:comment>
    <rdfs:comment xml:lang="en">Core demographic and identification data for a patient, including sex and age at the time of surgery.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents demographic and administrative data about a patient, including identifiers, sex, age at surgery, and record creation timestamp.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the basic demographic and administrative data of a patient, including identifiers, age at surgery, and sex. Corresponds to the 'Stammdaten' (basic data) table in the clinical database.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#epirubicin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/epirubicin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Epirubicin Administered</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Epirubicin, an anthracycline chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#reintubation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient required reintubation after initial extubation.</rdfs:comment>
    <rdfs:label xml:lang="en">reintubation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/reintubation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icterus">
    <rdfs:label xml:lang="en">icterus</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/icterus"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient presents with icterus (jaundice), a yellowing of the skin and eyes (Ikterus).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Plavix">
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Plavix (Clopidogrel)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Plavix"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking Plavix (Clopidogrel), a blood thinner used to prevent strokes and heart attacks. True if prescribed, false otherwise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#endoscopy">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">endoscopy</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/endoscopy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether an endoscopic procedure was performed as part of complication management.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#transfusion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Transfusion</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether a blood transfusion was required during the operation (German: Transfusion). True if transfusion was administered.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/transfusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dyspnoea">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports shortness of breath (Dyspnoe).</rdfs:comment>
    <rdfs:label xml:lang="en">dyspnoea</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/dyspnoea"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cirrhosis_intraop">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Cirrhosis Intraoperative</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/cirrhosis_intraop"/>
    <rdfs:comment xml:lang="en">Indicates whether liver cirrhosis was identified intraoperatively (German: Zirrhose intraOP). True if cirrhosis was found during surgery.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hepatitis_D">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hepatitis D</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/hepatitis_D"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has hepatitis D as a cause of liver disease (Ursache Hepatitis NANB).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#operation_time_end">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/operation_time_end"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">The end date and time of the surgical operation (German: Operationszeit bis).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Operation Time End</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anastomotic_insufficiency">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/anastomotic_insufficiency"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">anastomotic insufficiency</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed anastomotic insufficiency (failure or leakage of a surgical connection between two body parts).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rsi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether Rapid Sequence Induction (RSI) was performed, a technique for quick intubation to minimize aspiration risk (German: RSI). True if RSI was used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/rsi"/>
    <rdfs:label xml:lang="en">Rapid Sequence Induction (RSI)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#photodynamic_therapy">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/photodynamic_therapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Photodynamic Therapy (PDT) was performed. PDT is a light-based cancer treatment that uses a photosensitizing agent activated by specific wavelengths of light to destroy cancer cells.</rdfs:comment>
    <rdfs:label xml:lang="en">Photodynamic Therapy Performed</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bm_depression">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced bone marrow depression (KM-Depression), resulting in reduced production of blood cells (myelosuppression).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/bm_depression"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Bone Marrow Depression</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#embolism">
    <rdfs:label xml:lang="en">embolism</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed an embolism (e.g., pulmonary embolism) postoperatively.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/embolism"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#inhalative_Bronchodilatatoren">
    <rdfs:label xml:lang="en">Inhaled Bronchodilators</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is using inhaled bronchodilators for respiratory conditions such as asthma or COPD. True if prescribed, false otherwise.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/inhalative_Bronchodilatatoren"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#family_history_neoplastic_disease_text">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">family history of neoplastic disease text</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description providing details about the patient's family history of neoplastic disease, including affected relatives and cancer types.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/family_history_neoplastic_disease_text"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#metastasen_timepoint">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Metastases"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/metastases/metastasen_timepoint"/>
    <rdfs:label xml:lang="en">Metastasis Timepoint</rdfs:label>
    <rdfs:comment xml:lang="en">Categorical code indicating the timing of metastasis relative to the primary tumor diagnosis (Zeitpunkt Metastase). Encoded values: 1 = Synchronous (synchron) — metastasis occurred at the same time as the primary tumor diagnosis; 2 = Metachronous (metachron) — metastasis occurred after the primary tumor was diagnosed; 99 = No information provided (keine Angabe) — no specific information is available regarding the timing of metastasis.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#DiabetesMellitus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Diabetes Mellitus Type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents the classification of diabetes mellitus types, including type 1, type 2, and other forms. Each instance encodes a specific diabetes type with a code and description.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification of diabetes mellitus types based on their underlying cause and clinical presentation. Codes include: 1 - Type I (insulin-dependent, autoimmune destruction of beta cells), 2 - Type IIa (milder insulin resistance, some remaining insulin production), 3 - Type IIb (more severe insulin resistance, reduced insulin production), 4 - Type II unspecified (subtype a or b not specified), 5 - Type IIIa (genetic defects of beta-cell function), 6 - Type IIIb (genetic defects in insulin action or other specific mechanisms), 99 - No information provided.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: diabetes_mellitus_code some xsd:string</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diabetes_mellitus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Steroide_Tagesdosis">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Steroide_Tagesdosis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Steroid Daily Dose</rdfs:label>
    <rdfs:comment xml:lang="en">The daily dose of steroids prescribed to the patient. Unit is not explicitly specified in the source but typically recorded in milligrams (mg).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_2">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Additional Medication 2</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a second additional medication not covered by the standard categories. True if present, false otherwise. Detailed description in weitere_Medikation_2_Text.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bladder_catheter_removed_date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Bladder Catheter Removed Date</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/bladder_catheter_removed_date"/>
    <rdfs:comment xml:lang="en">The date on which the urinary bladder catheter was removed (German: Blasenkatheter entfernt Datum).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intraabdomineller_Abszess">
    <rdfs:label xml:lang="en">intra-abdominal abscess</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/intraabdomineller_Abszess"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed an intra-abdominal abscess postoperatively. Original German column name: intraabdomineller Abszess.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Statine">
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking statins, used to lower cholesterol levels. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Statine"/>
    <rdfs:label xml:lang="en">Statins</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_2_Text">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Additional Medication 2 Description</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of the second additional medication prescribed to the patient.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_2_Text"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anaesthesia_time_end">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/anaesthesia_time_end"/>
    <rdfs:comment xml:lang="en">The end date and time of anesthesia administration (German: Anästhesiezeit bis).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Anaesthesia Time End</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ALAT_μmol_per_l">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/ALAT_μmol_per_l"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">Alanine Aminotransferase (ALAT)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:comment xml:lang="en">Alanine Aminotransferase concentration measured in micromoles per litre (μmol/l). Indicates liver function.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#height_cm">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:label xml:lang="en">Height in Centimetres</rdfs:label>
    <rdfs:comment xml:lang="en">Patient's height measured in centimetres (cm) at the time of the aftercare examination. German: Größe.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/height_cm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diabetes_mellitus_description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A textual description of the diabetes mellitus type, providing a human-readable name such as 'Typ I', 'Typ II a', 'Typ II b', 'Typ II unspez', 'Typ III a', 'Typ III b', or 'keine Angabe'.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diabetes_mellitus/diabetes_mellitus_description"/>
    <rdfs:label xml:lang="en">Diabetes Mellitus Description</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#DiabetesMellitus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#localisation_of_the_metastasis">
    <rdfs:label xml:lang="en">localisation of the metastasis</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of the anatomical location of the metastasis (Lokalisation der Metastase).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/localisation_of_the_metastasis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Hämoglobin_mmol_per_l">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Hämoglobin_mmol_per_l"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">Hemoglobin (Hämoglobin)</rdfs:label>
    <rdfs:comment xml:lang="en">Hemoglobin concentration measured in millimoles per litre (mmol/l). Reflects oxygen-carrying capacity of the blood.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rfa_cycles">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Number of RFA Cycles</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/rfa_cycles"/>
    <rdfs:comment xml:lang="en">The total number of Radiofrequency Ablation (RFA) cycles administered to the patient.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ascites">
    <rdfs:label xml:lang="en">ascites</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient presents with ascites, i.e., accumulation of fluid in the abdominal cavity (Aszites).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/ascites"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasDiabetesMellitus">
    <rdfs:comment xml:lang="en">Links a medical history record to the type of diabetes mellitus. Derived from foreign key column 'diabetes_type' referencing diabetes_mellitus.diabetes_mellitus_id.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://example.org/ontology#DiabetesMellitus"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/diabetes_type"/>
    <rdfs:label xml:lang="en">has diabetes mellitus type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#tiva">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether Total Intravenous Anaesthesia (TIVA) was used, a technique where anesthesia is maintained exclusively with intravenous agents without inhalational agents (German: TIVA). True if TIVA was administered.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/tiva"/>
    <rdfs:label xml:lang="en">Total Intravenous Anaesthesia (TIVA)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#implementation_tumor_board">
    <rdfs:label xml:lang="en">Tumor Board Recommendations Implemented</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/implementation_tumor_board"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the tumor board's recommendations (Umsetzung TuBo) were implemented in the patient's treatment.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labour_created_at">
    <rdfs:comment xml:lang="en">The date and time when this laboratory analysis record was created in the system. Table-scoped name to avoid domain union conflict with patientData_created_at.</rdfs:comment>
    <rdfs:label xml:lang="en">Labour Record Creation Timestamp</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/created_at"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases_2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">other pre-existing diseases 2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_pre_existing_diseases_2"/>
    <rdfs:comment xml:lang="en">Free-text field for the second additional pre-existing disease not captured by specific fields.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasChildStadium">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/child_stadium"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#ChildStadium"/>
    <rdfs:label xml:lang="en">has Child-Pugh stadium</rdfs:label>
    <rdfs:comment xml:lang="en">Links a medical history record to the Child-Pugh cirrhosis classification stage. Derived from foreign key column 'child_stadium' referencing child_stadium.child_stadium_id.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#previous_tumour">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a history of a previous primary tumour.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">previous tumour</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/previous_tumour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drainage_complication">
    <rdfs:label xml:lang="en">drainage complication</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a complication associated with a drainage procedure occurred.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/drainage_complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#oesophageal_stenosis">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:comment xml:lang="en">Indicates whether oesophageal stenosis (Oesophagusstenose), a narrowing of the oesophagus, was observed. Boolean: true if present, false otherwise. Source DB type: TINYINT.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Oesophageal Stenosis</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/oesophageal_stenosis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#DekubitusGrade">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/dekubitus_grade"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents the severity staging of a pressure ulcer (decubitus), typically graded from Stage 1 (non-blanchable erythema) through Stage 4 (full-thickness tissue loss).</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification of pressure ulcers (decubitus ulcers or bedsores) by their severity. Grades range from Grade I (intact skin with non-blanching redness) through Grade IV (full-thickness tissue loss with extensive damage to muscle, bone, or supporting structures). A value of 99 indicates no information provided.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: dekubitus_grade_id exactly 1 xsd:integer</rdfs:comment>
    <rdfs:label xml:lang="en">Decubitus Grade (Pressure Ulcer Stage)</rdfs:label>
    <rdfs:label xml:lang="en">Decubitus Ulcer Grade</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#radiation_amount_in_gray">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/radiation_amount_in_gray"/>
    <rdfs:label xml:lang="en">Radiation Dose in Gray</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">The total amount of radiation administered to the patient, measured in Gray (Gy). Gray is the SI unit of absorbed radiation dose, where 1 Gy = 1 J/kg.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Lipase_μmol_per_l">
    <rdfs:comment xml:lang="en">Lipase concentration measured in micromoles per litre (μmol/l). Monitors pancreatic health.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Lipase_μmol_per_l"/>
    <rdfs:label xml:lang="en">Lipase</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dose_according_to_bsa">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the chemotherapy dose was calculated according to body surface area (BSA / Körperoberfläche, KOF).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Dose According to Body Surface Area</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/dose_according_to_bsa"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ClavienDindo">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/clavien_dindo"/>
    <rdfs:label xml:lang="en">Clavien-Dindo Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A standardized classification system for grading surgical complications based on the therapy used to treat the complication. Grades range from I (minor deviation) to V (death).</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: clavien_dindo_id some xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the Clavien-Dindo classification system, which is a standardized grading scale used to classify postoperative surgical complications based on their severity. Grades range from 0 (no complications) through I-IV (increasing severity) to V (death of the patient). This classification is widely used in surgical and medical fields to standardize the reporting and evaluation of complications, aiding in clinical decision-making and research.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Albumin_g_per_l">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Albumin_g_per_l"/>
    <rdfs:label xml:lang="en">Albumin</rdfs:label>
    <rdfs:comment xml:lang="en">Albumin concentration measured in grams per litre (g/l). Measures nutritional status and liver function.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#recommendations_tumor_board">
    <rdfs:label xml:lang="en">Tumor Board Recommendations</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/recommendations_tumor_board"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field containing the recommendations made by the tumor board (Empfehlungen TuBo) regarding the patient's treatment plan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patientData_created_at">
    <rdfs:label xml:lang="en">Patient Data Created At</rdfs:label>
    <rdfs:label xml:lang="en">Record Creation Timestamp</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data/created_at"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
    <rdfs:comment xml:lang="en">Timestamp indicating when the patient data record was created in the system. Disambiguated from GeneralAftercare.created_at.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date and time when the patient data record was created in the database system.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#conversion_lap_open">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Conversion Laparoscopic to Open</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/conversion_lap_open"/>
    <rdfs:comment xml:lang="en">Indicates whether the procedure was converted from laparoscopic to open surgery (German: Konversion lap/open). True if conversion occurred.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#readmission_to_clinic">
    <rdfs:label xml:lang="en">readmission to clinic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/readmission_to_clinic"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient was readmitted to the hospital after discharge.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weight_kg">
    <rdfs:label xml:lang="en">Weight in Kilograms</rdfs:label>
    <rdfs:label xml:lang="en">weight in kilograms</rdfs:label>
    <rdfs:comment xml:lang="en">Patient's weight measured in kilograms (kg) at the time of the aftercare examination. German: Gewicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient's body weight measured in kilograms (kg).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/weight_kg"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/weight_kg"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#metastasen_id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for the metastasis record. Serves as the primary key.</rdfs:comment>
    <rdfs:label xml:lang="en">Metastasis ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Metastases"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/metastases/metastasen_id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#liver_abscess">
    <rdfs:label xml:lang="en">liver abscess</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/liver_abscess"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed a liver abscess postoperatively.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anastomotic_insufficiency_type">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/anastomotic_insufficiency_type"/>
    <rdfs:comment xml:lang="en">Free-text field specifying the location or type of the failed anastomosis, if anastomotic insufficiency occurred.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">anastomotic insufficiency type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#laparoscopic_procedure">
    <rdfs:label xml:lang="en">Laparoscopic Procedure</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the surgical procedure was performed laparoscopically (German: Laparoskopisches Vorgehen). True if laparoscopic, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/laparoscopic_procedure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_1_Text">
    <rdfs:label xml:lang="en">Additional Medication 1 Description</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_1_Text"/>
    <rdfs:comment xml:lang="en">Free-text description of the first additional medication prescribed to the patient, providing details not captured by the standard medication categories.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#MedicalHistory">
    <rdfs:comment xml:lang="en">Represents a comprehensive medical history record for a patient, including pre-existing conditions, symptoms, comorbidities, family history, and cancer-related information.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Medical History</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nausea_vomiting">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/nausea_vomiting"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports nausea and/or vomiting (Uebelkeit/Erbrechen).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">nausea and vomiting</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#date_of_aftercare">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/date_of_aftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:label xml:lang="en">Date of Aftercare Examination</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Date of the follow-up examination (Datum Nachsorgeuntersuchung). Stored as a FLOAT in the source database; the encoding scheme should be interpreted according to the source system conventions (e.g., Excel serial date number). The direct mapping draft mapped this as xsd:date; the actual DB type is FLOAT, so xsd:float is used here for schema fidelity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hepatomegaly_splenomegaly">
    <rdfs:label xml:lang="en">hepatomegaly or splenomegaly</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient presents with hepatomegaly (enlarged liver) and/or splenomegaly (enlarged spleen) (Hepatomegalie/Splenomegalie).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/hepatomegaly_splenomegaly"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Chemotherapy">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy"/>
    <rdfs:comment xml:lang="en">Represents a comprehensive record of a patient's oncological treatment, including chemotherapy regimens, radiotherapy, interventional therapies (TACE, RFA, PDT), treatment outcomes, tumor board decisions, dosage adjustments, side effects, performance status, and biomarker information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chemotherapy Treatment Record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#GGT_μmol_per_l">
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/GGT_μmol_per_l"/>
    <rdfs:label xml:lang="en">Gamma-Glutamyl Transferase (GGT)</rdfs:label>
    <rdfs:comment xml:lang="en">Gamma-Glutamyl Transferase concentration measured in micromoles per litre (μmol/l). Reflects bile duct and liver function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#histological_diagnosis">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/histological_diagnosis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Histological Diagnosis</rdfs:label>
    <rdfs:comment xml:lang="en">The specific histological diagnosis (German: Histologische Diagnose) resulting from the tissue analysis. This is a nullable text field.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nicotine_amount_py">
    <rdfs:label xml:lang="en">nicotine amount in pack-years</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/nicotine_amount_py"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Cumulative tobacco exposure measured in pack-years (PY). One pack-year equals smoking one pack of cigarettes per day for one year. Unit: pack-years.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_1"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Free-text field for the first additional complication not listed in the predefined categories.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">other complication 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ffo">
    <rdfs:comment xml:lang="en">Indicates whether fiberoptic intubation was performed, a technique using a flexible fiberoptic scope for endotracheal intubation (German: FFO). True if fiberoptic intubation was used.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Fiberoptic Intubation (FFO)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/ffo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text field for the second additional complication not listed in the predefined categories.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_2"/>
    <rdfs:label xml:lang="en">other complication 2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#primary_dose_reduction">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a primary (initial) dose reduction (Primäre Dosisreduktion) was applied from the start of treatment.</rdfs:comment>
    <rdfs:label xml:lang="en">Primary Dose Reduction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/primary_dose_reduction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#reduced_general_state">
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">reduced general state</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient presents with a reduced general condition (Reduzierter Allgemeinzustand).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/reduced_general_state"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#progression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/progression"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Disease Progression</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether disease progression occurred, meaning the tumor grew or spread during or after treatment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#microsatellites">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Microsatellite instability (MSI) status, a genetic biomarker. Encoded as integer representing categorical values: typically 0 = microsatellite stable (MSS), 1 = microsatellite instability low (MSI-L), 2 = microsatellite instability high (MSI-H). MSI-H tumors may respond to immunotherapy.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/microsatellites"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Microsatellite Instability Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#aftercare_text">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/aftercare_text"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Aftercare Free Text</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text field for additional follow-up care notes and observations (Nachsorge Freitext).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Schilddrüsenhormone">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Schilddrüsenhormone"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking thyroid hormone replacement therapy (Schilddrüsenhormone). True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:label xml:lang="en">Thyroid Hormones</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#regression">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether tumor regression (shrinkage) occurred as a response to treatment.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/regression"/>
    <rdfs:label xml:lang="en">Tumor Regression</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#parenteral_nutrition">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Parenteral Nutrition</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether parenteral (intravenous) nutrition was required postoperatively (German: Parenterale Ernährung). True if parenteral nutrition was administered.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/parenteral_nutrition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Antidepressiva">
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Antidepressiva"/>
    <rdfs:label xml:lang="en">Antidepressants</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking antidepressant medication. True if prescribed, false otherwise.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apfel_score">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/apfel_score"/>
    <rdfs:comment xml:lang="en">Apfel simplified risk score for predicting postoperative nausea and vomiting (PONV). Encoded as integer from 0 to 4, where each point represents one risk factor: 0 = approximately 10% risk, 1 = approximately 20% risk, 2 = approximately 40% risk, 3 = approximately 60% risk, 4 = approximately 80% risk (German: Apfel-Score).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Apfel Score</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#duration_intermediate_care_d">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">duration of intermediate care</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/duration_intermediate_care_d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Duration of the patient's stay in the Intermediate Care Unit (IMC), measured in days (d).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_3"/>
    <rdfs:label xml:lang="en">Additional Medication 3</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a third additional medication not covered by the standard categories. True if present, false otherwise. Detailed description in weitere_Medikation_3_Text.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_5"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">other complication 5</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for the fifth additional complication not listed in the predefined categories.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#first_haemodialysis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Information about the patient's first haemodialysis session. Stored as text to accommodate date or descriptive entries.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/first_haemodialysis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">first haemodialysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#radiotherapy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Radiotherapy Administered</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/radiotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient received radiotherapy (radiation therapy) as part of their treatment. True if radiotherapy was administered.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#remission">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether remission was achieved, meaning complete or partial disappearance of cancer symptoms or markers.</rdfs:comment>
    <rdfs:label xml:lang="en">Remission</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/remission"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cse">
    <rdfs:label xml:lang="en">Combined Spinal-Epidural Anaesthesia (CSE)</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether combined spinal-epidural anesthesia was administered, a technique combining spinal and epidural approaches (German: CSE). True if CSE was used.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/cse"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#supply_of_the_leakage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:label xml:lang="en">Management of Bile Duct Leakage</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/supply_of_the_leakage"/>
    <rdfs:comment xml:lang="en">Free-text description of the management or treatment provided for bile duct leakage (Versorgung der Leckage).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#discharge_with_drainage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient was discharged from the hospital with a drainage system still in place (German: Entlassung mit Drainage). True if discharged with drainage.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/discharge_with_drainage"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Discharge with Drainage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#clavien_dindo_id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/clavien_dindo/clavien_dindo_id"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ClavienDindo"/>
    <rdfs:comment xml:lang="en">The unique integer identifier serving as the primary key for each entry in the Clavien-Dindo classification table. Each value uniquely identifies a specific complication grade.</rdfs:comment>
    <rdfs:label xml:lang="en">Clavien-Dindo Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Sex">
    <rdfs:comment xml:lang="en">Classification of the biological sex of a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classification of the biological sex of a patient. Referenced by PatientData.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the biological sex classification of a patient. Categories typically include male, female, or other as recorded in the clinical system.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classification of biological sex or gender category (Geschlecht). Known values: 1 = female (weiblich), 2 = male (männlich), 3 = diverse (divers, non-binary or other gender identities).</rdfs:comment>
    <rdfs:label xml:lang="en">Sex</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/sex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#multi_organ_failure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/multi_organ_failure"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed multi-organ failure (simultaneous failure of two or more organs).</rdfs:comment>
    <rdfs:label xml:lang="en">multi-organ failure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dekubitus_grade_stadium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/dekubitus_grade/dekubitus_grade_stadium"/>
    <rdfs:comment xml:lang="en">The textual description of the pressure ulcer severity stage. Known encoded values are: 'Grad I' — Skin intact with non-blanching redness, area may feel warmer or firmer; 'Grad II' — Partial-thickness skin loss involving epidermis and possibly dermis, may appear as open blister or shallow ulcer; 'Grad III' — Full-thickness skin loss with damage to or necrosis of subcutaneous tissue, extending down to but not through underlying fascia; 'Grad IV' — Full-thickness skin and tissue loss with extensive damage to muscle, bone, or supporting structures such as tendons or joints; 'keine Angabe' (code 99) — No information provided regarding the grade of the pressure ulcer.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Decubitus Grade Stadium</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#DekubitusGrade"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#neurotoxicity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Neurotoxicity</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/neurotoxicity"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced neurotoxicity (Neurotoxizität), i.e., neurological damage caused by treatment, commonly associated with platinum-based agents and taxanes.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#docetaxel">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/docetaxel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Docetaxel, a taxane chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
    <rdfs:label xml:lang="en">Docetaxel Administered</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#number_ffps">
    <rdfs:comment xml:lang="en">Number of fresh frozen plasma (FFP) units transfused during the operation (German: Anzahl FFP's). Unit: count of FFP units.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Number of Fresh Frozen Plasma Units</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/number_ffps"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#kidney_insufficiency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/kidney_insufficiency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed renal insufficiency or kidney failure postoperatively.</rdfs:comment>
    <rdfs:label xml:lang="en">kidney insufficiency</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cisplatin">
    <rdfs:label xml:lang="en">Cisplatin Administered</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/cisplatin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Cisplatin, a platinum-based chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases_1">
    <rdfs:comment xml:lang="en">Free-text field for the first additional pre-existing disease not captured by specific fields.</rdfs:comment>
    <rdfs:label xml:lang="en">other pre-existing diseases 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_pre_existing_diseases_1"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gall_bladder_leakage">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/gall_bladder_leakage"/>
    <rdfs:label xml:lang="en">Bile Duct Leakage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether bile duct leakage (Gallengangsleckage) was observed. Boolean: true if leakage is present, false otherwise. Source DB type: TINYINT.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#leucovorin">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/leucovorin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Leucovorin (folinic acid) was used, typically alongside 5-Fluorouracil to enhance its efficacy.</rdfs:comment>
    <rdfs:label xml:lang="en">Leucovorin Administered</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#INR">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">International Normalized Ratio, a dimensionless standardized measure of blood clotting results.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/INR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">International Normalized Ratio (INR)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#mobilisation_postop_date">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/mobilisation_postop_date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Postoperative Mobilisation Date</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the patient was first mobilised after surgery (German: Mobilisation postop Datum).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#GeneralAftercare">
    <rdfs:label xml:lang="en">General Aftercare</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare"/>
    <rdfs:comment xml:lang="en">Documents a patient's post-surgical follow-up examination, including body metrics (height, weight, BMI), surgical complications such as incisional hernia, bile duct leakage, bile duct stenosis, recurring cholangitis, and oesophageal stenosis, along with their treatments. Corresponds to the German 'allgemeine Nachsorge' form.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_side_effects_text">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for specifying additional side effects (Sonstige Nebenwirkungen Text) not covered by the predefined options.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/other_side_effects_text"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Other Side Effects Description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patient_id_old">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data/patient_id_old"/>
    <rdfs:label xml:lang="en">Old Patient ID</rdfs:label>
    <rdfs:label xml:lang="en">Old Patient Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Legacy patient identifier from a previous system, retained for traceability and data migration purposes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A legacy or previous unique integer identifier for the patient, retained for backward compatibility or cross-referencing with older systems.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#created_at">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/created_at"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/created_at"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/created_at"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">The date and time when this chemotherapy treatment record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp indicating when the general aftercare record was created in the system.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp indicating when the medication record was created in the system.</rdfs:comment>
    <rdfs:label xml:lang="en">Record Creation Timestamp</rdfs:label>
    <rdfs:label xml:lang="en">Created At</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases_5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_pre_existing_diseases_5"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">other pre-existing diseases 5</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text field for the fifth additional pre-existing disease not captured by specific fields.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#complication_free_progression">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient had a complication-free postoperative course. True (1) means no complications occurred.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/complication_free_progression"/>
    <rdfs:label xml:lang="en">complication-free progression</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#family_history_neoplastic_disease">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a family history of neoplastic (tumor/cancer) disease. True if positive family history exists.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/family_history_neoplastic_disease"/>
    <rdfs:label xml:lang="en">family history of neoplastic disease</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gastric_tube_removed_date">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">The date on which the gastric (nasogastric) tube was removed (German: Magensonde entfernt Datum).</rdfs:comment>
    <rdfs:label xml:lang="en">Gastric Tube Removed Date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/gastric_tube_removed_date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasDekubitusGrade">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/decubitus_score"/>
    <rdfs:comment xml:lang="en">Links a complication record to the pressure ulcer (decubitus) severity grade, referencing the dekubitus_grade lookup table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has decubitus grade</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#DekubitusGrade"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#side_effects_of_cx">
    <rdfs:label xml:lang="en">Side Effects of Chemotherapy Present</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/side_effects_of_cx"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced any side effects from chemotherapy (Nebenwirkung der CX).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#five_fluorouracil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">5-Fluorouracil (5-FU) Administered</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/five_fluorouracil"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether 5-Fluorouracil (5-FU), an antimetabolite chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ecog_stage">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Eastern Cooperative Oncology Group (ECOG) performance status score measuring the patient's ability to perform daily activities. Encoded as integer: 0 = Fully active; 1 = Restricted in strenuous activity but ambulatory; 2 = Ambulatory and capable of self-care but unable to work; 3 = Limited self-care, confined to bed/chair &gt;50% of waking hours; 4 = Completely disabled; 5 = Dead.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">ECOG Performance Status</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/ecog_stage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Metastases">
    <rdfs:label xml:lang="en">Metastases</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents metastatic disease information including the timepoint of metastasis occurrence. Used to classify the type of primary metastasis in the medical history.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a metastasis record documenting the timing of cancer spread (metastasis) relative to the primary tumor diagnosis. Each instance captures whether the metastasis was synchronous, metachronous, or unspecified.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/metastases"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#endoscopic_retrograde_cholangiopancreatography">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/endoscopic_retrograde_cholangiopancreatography"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">ERCP (Endoscopic Retrograde Cholangiopancreatography)</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether an Endoscopic Retrograde Cholangiopancreatography (ERCP) was performed.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#stand_by_monitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Stand-by Monitoring</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/stand_by_monitoring"/>
    <rdfs:comment xml:lang="en">Indicates whether stand-by monitoring was provided during the procedure or recovery (German: Stand by / Monitoring). True if monitoring was provided.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nocturia">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">nocturia</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports nocturia, i.e., nighttime urination (Nykturie).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/nocturia"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#decubitus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed a decubitus (pressure ulcer) during the hospital stay.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">decubitus (pressure ulcer)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/decubitus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#further_symptoms">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">further symptoms</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports additional symptoms not captured by other specific fields.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/further_symptoms"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weight_loss">
    <rdfs:label xml:lang="en">weight loss</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/weight_loss"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports unintentional weight loss (Gewichtsverlust).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#GFR_ml_per_min">
    <rdfs:comment xml:lang="en">Glomerular Filtration Rate measured in millilitres per minute (ml/min). Key test for kidney function.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Glomerular Filtration Rate (GFR)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/GFR_ml_per_min"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#simplified_acute_physiology_score_average">
    <rdfs:comment xml:lang="en">The average Simplified Acute Physiology Score (SAPS), used to assess the severity of a patient's condition in the ICU. Higher scores indicate greater severity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">SAPS average score</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/simplified_acute_physiology_score_average"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sex_category">
    <rdfs:label xml:lang="en">Sex Category</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/sex/sex_category"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The textual label describing the biological sex category of the patient, e.g., 'male', 'female', or 'other'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Textual description of the sex/gender category (Geschlecht). Known values: 'weiblich' (female), 'männlich' (male), 'divers' (diverse/non-binary).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Sex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_3">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_3"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">other complication 3</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text field for the third additional complication not listed in the predefined categories.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pre_existing_liver_disease">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/pre_existing_liver_disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">pre-existing liver disease</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a pre-existing liver disease (Lebervorerkrankung).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#paclitaxel">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Paclitaxel, a taxane chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
    <rdfs:label xml:lang="en">Paclitaxel Administered</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/paclitaxel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rfa">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/rfa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Radiofrequency Ablation (RFA) was performed. RFA is a minimally invasive technique that uses heat generated by radiofrequency energy to destroy tumor tissue.</rdfs:comment>
    <rdfs:label xml:lang="en">RFA Performed</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#order_number">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/order_number"/>
    <rdfs:comment xml:lang="en">The order or case number (German: Auftragsnummer) assigned to the histological examination. This is a nullable text field.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdfs:label xml:lang="en">Order Number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#MDRD_ml_per_min">
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/MDRD_ml_per_min"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">MDRD Estimated GFR</rdfs:label>
    <rdfs:comment xml:lang="en">Modification of Diet in Renal Disease (MDRD) formula-estimated glomerular filtration rate measured in millilitres per minute (ml/min). Helps assess kidney health.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ventilation_duration_h">
    <rdfs:label xml:lang="en">invasive ventilation duration</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/ventilation_duration_h"/>
    <rdfs:comment xml:lang="en">Total duration of invasive mechanical ventilation, measured in hours (h).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_side_effects">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced other side effects (Sonstige Nebenwirkungen) not listed among the predefined options.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Other Side Effects Present</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/other_side_effects"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cholascos">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/cholascos"/>
    <rdfs:label xml:lang="en">cholascites (bile ascites)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed cholascites (bile-stained ascites) as a postoperative complication.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Quickk_percent">
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Quickk_percent"/>
    <rdfs:label xml:lang="en">Quick Value (Prothrombin Time)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Quick value (prothrombin time) measured as a percentage (%). Indicates blood clotting time.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Complication">
    <rdfs:comment xml:lang="en">Represents a postoperative or surgical complication record associated with a patient, including various complication types, durations of care, and management interventions.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication"/>
    <rdfs:label xml:lang="en">Complication</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#irinotecan">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Irinotecan Administered</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/irinotecan"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Irinotecan, a topoisomerase I inhibitor chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bmi">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Body Mass Index (BMI) calculated from the patient's weight and height. Unit: kg/m².</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:label xml:lang="en">Body Mass Index</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/bmi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#haemodialysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">haemodialysis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient required haemodialysis postoperatively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/haemodialysis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pre_existing_disease_immunological_text">
    <rdfs:comment xml:lang="en">Free-text description of the patient's pre-existing immunological disease.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/pre_existing_disease_immunological_text"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">pre-existing immunological disease text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#re_operation">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/re_operation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient required an additional surgical procedure (re-operation) due to complications.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">re-operation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pleural_effusion">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed pleural effusion (fluid accumulation in the pleural space) postoperatively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/pleural_effusion"/>
    <rdfs:label xml:lang="en">pleural effusion</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Anti_Xa">
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a factor Xa inhibitor anticoagulant (e.g., Rivaroxaban). True if prescribed, false otherwise.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Anti_Xa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Anti-Xa Anticoagulant</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intraoperative_new_findings_txt">
    <rdfs:comment xml:lang="en">Free-text description of new findings discovered during the operation (German: intraop Neubefund Text).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/intraoperative_new_findings_txt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Intraoperative New Findings Text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Insulin_Tagesdosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">The daily dose of insulin prescribed to the patient. Typically recorded in international units (IU).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Insulin Daily Dose</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Insulin_Tagesdosis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#folic_acid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/folic_acid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Folic Acid (Folsäure) was used alongside chemotherapy, typically to enhance the efficacy of 5-Fluorouracil.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Folic Acid Administered</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#clavien_dindo_grade">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/clavien_dindo/clavien_dindo_grade"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Clavien-Dindo Grade</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The specific grade level of the postoperative complication according to the Clavien-Dindo classification. Known grades include: 0 (no postoperative complications), I (any deviation from normal postoperative course without need for intervention), II (complications requiring medical treatment including parenteral nutrition and blood transfusions), IIIa (complications requiring surgical, endoscopic, or radiologic intervention without general anesthesia), IIIb (complications requiring intervention under general anesthesia), IVa (life-threatening complications requiring intensive care with single organ dysfunction including dialysis), IVb (dysfunction of multiple organs), and V (death of the patient).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#ClavienDindo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#biliom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">bilioma</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed a bilioma (encapsulated collection of bile outside the biliary tree) postoperatively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/biliom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bile_duct_stenosis">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/bile_duct_stenosis"/>
    <rdfs:comment xml:lang="en">Indicates whether bile duct stricture or narrowing (Gallengangsstenose) was observed. Boolean: true if stenosis is present, false otherwise. Source DB type: TINYINT.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:label xml:lang="en">Bile Duct Stenosis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#tumor_board_decision">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Tumor Board Decision Made</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a tumor board decision (Tumorboardbeschluss) was made regarding this patient's treatment.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/tumor_board_decision"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#haemodialysis_h">
    <rdfs:label xml:lang="en">haemodialysis duration</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Total duration of haemodialysis treatment, measured in hours (h).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/haemodialysis_h"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_4_Text">
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:label xml:lang="en">Additional Medication 4 Description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text description of the fourth additional medication prescribed to the patient.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_4_Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ICD_discription">
    <rdfs:domain rdf:resource="http://example.org/ontology#Icd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">ICD Description (Free Text)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/icd/ICD_discription"/>
    <rdfs:comment xml:lang="en">Free-text description providing additional details about the ICD diagnosis code that may not be fully captured by the code alone. For example, for ICD code C34 (lung cancer), the description might specify 'adenocarcinoma of the right upper lobe'. For E11 (Type 2 Diabetes Mellitus), it might read 'With complications, including retinopathy'. This field corresponds to the 'ICD Freitext' column in the original data.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Bilirubin_μmol_per_l">
    <rdfs:label xml:lang="en">Bilirubin</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Bilirubin_μmol_per_l"/>
    <rdfs:comment xml:lang="en">Bilirubin concentration measured in micromoles per litre (μmol/l). Monitors liver function and bile processing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#body_mass_index">
    <rdfs:label xml:lang="en">body mass index</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/body_mass_index"/>
    <rdfs:comment xml:lang="en">The patient's Body Mass Index (BMI), calculated as weight in kg divided by height in meters squared (kg/m²).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#age_at_surgery">
    <rdfs:comment xml:lang="en">The patient's age in years at the time of the surgical procedure.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient's age in years at the time of the surgical operation (OP). Recorded as an integer value representing completed years of life at the date of surgery.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data/age_at_surgery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Age at Surgery</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Thyreostatika">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking thyrostatic medications that inhibit thyroid hormone production. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:label xml:lang="en">Thyrostatic Medication</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Thyreostatika"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#fever">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports fever (Fieber).</rdfs:comment>
    <rdfs:label xml:lang="en">fever</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/fever"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#secondary_wound_healing">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced secondary wound healing (wound healing disorder) postoperatively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/secondary_wound_healing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">secondary wound healing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#urinary_retention">
    <rdfs:label xml:lang="en">urinary retention</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced urinary retention postoperatively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/urinary_retention"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#number_of_cycles">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Number of Chemotherapy Cycles</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/number_of_cycles"/>
    <rdfs:comment xml:lang="en">The total number of chemotherapy cycles administered to the patient during this treatment course.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#postoperative_nutrition_date">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The date when oral feeding was resumed postoperatively (German: Kostaufbau postoperativ Datum).</rdfs:comment>
    <rdfs:label xml:lang="en">Postoperative Nutrition Resumption Date</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/postoperative_nutrition_date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Falithrom_Marcumar">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Falithrom_Marcumar"/>
    <rdfs:label xml:lang="en">Falithrom/Marcumar (Vitamin K Antagonist)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking Falithrom or Marcumar, which are vitamin K antagonists (e.g., Phenprocoumon/Warfarin) used as anticoagulants. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pre_existing_disease_immunological">
    <rdfs:label xml:lang="en">pre-existing immunological disease</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/pre_existing_disease_immunological"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a pre-existing immunological disease.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#burst_abdomen">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/burst_abdomen"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">burst abdomen (fascial dehiscence)</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed burst abdomen (fascial dehiscence or wound rupture) postoperatively.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Anzahl_der_Antihypertensiva">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Anzahl_der_Antihypertensiva"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">The count of distinct antihypertensive medications prescribed to the patient. Corrected from xsd:boolean to xsd:integer to properly represent the number of antihypertensive drugs. Originally stored as TINYINT in the database which was incorrectly mapped to boolean.</rdfs:comment>
    <rdfs:label xml:lang="en">Number of Antihypertensive Medications</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#general_anaesthesia">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/general_anaesthesia"/>
    <rdfs:comment xml:lang="en">Indicates whether general anesthesia was administered (German: Allgemeinanästhesie). True if general anesthesia was used.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">General Anaesthesia</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Insulin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:label xml:lang="en">Insulin</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking insulin for diabetes management. True if prescribed, false otherwise.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Insulin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cholangitis">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed cholangitis (inflammation of the bile duct) postoperatively.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/cholangitis"/>
    <rdfs:label xml:lang="en">cholangitis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complication_management_text">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Free-text field to document details of other complication management strategies.</rdfs:comment>
    <rdfs:label xml:lang="en">other complication management text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complication_management_text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#analgosedation">
    <rdfs:label xml:lang="en">Analgosedation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether analgosedation (combined analgesia and sedation) was administered for pain relief (German: Analgosedierung). True if analgosedation was used.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/analgosedation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation">
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking an additional medication not covered by the standard categories. True if present, false otherwise. Detailed description in weitere_Medikation_1_Text.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Additional Medication 1</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#lumbar_pda">
    <rdfs:label xml:lang="en">Lumbar Epidural Catheter (PDA)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/lumbar_pda"/>
    <rdfs:comment xml:lang="en">Indicates whether a lumbar peridural (epidural) catheter was placed for anesthesia or analgesia (German: Lumb Periduralkatheter PDA). True if lumbar epidural catheter was used.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#operation_duration_min">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Operation Duration in Minutes</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/operation_duration_min"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">Total duration of the surgical operation measured in minutes (German: Operationsdauer). Unit: minutes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#previous_operations">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/previous_operations"/>
    <rdfs:label xml:lang="en">Previous Operations</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient had previous operations relevant to the current procedure (German: Voroperationen). True if prior surgeries exist.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#histology_summary">
    <rdfs:comment xml:lang="en">A summary of the histological findings (German: Histologie Zusammenfassung), providing an overview of key results from the tissue examination. This is a nullable text field.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/histology_summary"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Histology Summary</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pathologist">
    <rdfs:label xml:lang="en">Pathologist</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#HistologyGeneral"/>
    <rdfs:comment xml:lang="en">The name of the pathologist (German: PathologIn) responsible for analyzing and reporting the histological findings. This is a nullable text field.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/histology_general/pathologist"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#tace_cycles">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Number of TACE Cycles</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/tace_cycles"/>
    <rdfs:comment xml:lang="en">The total number of Transarterial Chemoembolization (TACE) cycles administered to the patient.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anaesthesia_special">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Anaesthesia Special Conditions</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether there were special conditions or notable events related to anesthesia (German: Besonderheiten Anästhesie). True if special conditions were noted.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/anaesthesia_special"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hepatitis_B">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/hepatitis_B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has hepatitis B as a cause of liver disease (Ursache Hepatitis B).</rdfs:comment>
    <rdfs:label xml:lang="en">hepatitis B</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sorafenib">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/sorafenib"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Sorafenib Administered</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Sorafenib, a multikinase inhibitor used as targeted therapy in hepatocellular carcinoma and other cancers, was administered.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosis_date_metastasis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Date when the metastasis was diagnosed (Diagnosedatum Metastase). Source column is TEXT; semantically upgraded to xsd:date for proper date handling.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/diagnosis_date_metastasis"/>
    <rdfs:label xml:lang="en">diagnosis date of metastasis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#generalOperationalDetails_created_at">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/created_at"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">Created At</rdfs:label>
    <rdfs:comment xml:lang="en">Timestamp indicating when this operational details record was created in the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#endoscopy_text">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/endoscopy_text"/>
    <rdfs:comment xml:lang="en">Free-text field to document findings or notes from an endoscopy procedure.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">endoscopy free text</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#child_stadium_definition">
    <rdfs:domain rdf:resource="http://example.org/ontology#ChildStadium"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/child_stadium/child_stadium_definition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Child-Pugh Stadium Definition</rdfs:label>
    <rdfs:comment xml:lang="en">Textual definition or label describing the Child-Pugh classification stage. Examples include 'keine Zirrhose' (no cirrhosis), 'Child A' (mild/compensated cirrhosis), 'Child B' (moderate/decompensated cirrhosis), 'Child C' (severe/decompensated cirrhosis), and 'keine Angabe' (no information provided).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#complication_created_at">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Timestamp indicating when the complication record was created in the system.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/created_at"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">complication record created at</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#mutation_adjusted_risk_score_h">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/mutation_adjusted_risk_score_h"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Duration of the MARS or SPAD procedure, measured in hours (h).</rdfs:comment>
    <rdfs:label xml:lang="en">MARS/SPAD duration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ivra">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/ivra"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Intravenous Regional Anaesthesia (IVRA)</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether intravenous regional anesthesia (Bier block) was used, a technique involving IV injection of local anesthetic into an exsanguinated limb (German: IVRA). True if IVRA was used.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anaesthesia_special_text">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/anaesthesia_special_text"/>
    <rdfs:label xml:lang="en">Anaesthesia Special Conditions Text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for additional details about special conditions related to anesthesia (German: Besonderheiten Anästhesie Text).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ASS">
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/ASS"/>
    <rdfs:label xml:lang="en">Acetylsalicylic Acid (Aspirin)</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking acetylsalicylic acid (ASS/Aspirin), commonly used for blood thinning or pain relief. True if prescribed, false otherwise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#prov:Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#anaesthesia_time_start">
    <rdfs:comment xml:lang="en">The start date and time of anesthesia administration (German: Anästhesiezeit von).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/anaesthesia_time_start"/>
    <rdfs:label xml:lang="en">Anaesthesia Time Start</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dose_reduction_over_time">
    <rdfs:label xml:lang="en">Dose Reduction Over Time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/dose_reduction_over_time"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether dose reductions were made during the course of treatment (Dosisreduktion im Verlauf).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#asa_score">
    <rdfs:comment xml:lang="en">American Society of Anesthesiologists (ASA) Physical Status Classification score. Encoded as integer: 1 = normal healthy patient, 2 = patient with mild systemic disease, 3 = patient with severe systemic disease, 4 = patient with severe systemic disease that is a constant threat to life, 5 = moribund patient not expected to survive without the operation, 6 = declared brain-dead patient whose organs are being removed for donor purposes (German: ASA-Score).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:label xml:lang="en">ASA Score</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/asa_score"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#operation_time_start">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">The start date and time of the surgical operation (German: Operationszeit von).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Operation Time Start</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/operation_time_start"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#previous_secondary_tumour_text">
    <rdfs:comment xml:lang="en">Free-text description of the patient's previous secondary tumour, including type and location.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">previous secondary tumour text</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/previous_secondary_tumour_text"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CRP_mg_per_l">
    <rdfs:label xml:lang="en">C-Reactive Protein (CRP)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">C-Reactive Protein concentration measured in milligrams per litre (mg/l). Marker for inflammation and infection.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/CRP_mg_per_l"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#surgeon">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Surgeon</rdfs:label>
    <rdfs:comment xml:lang="en">Name or identifier of the surgeon who performed the operation (German: ChirurgIn).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/surgeon"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NSAR">
    <rdfs:label xml:lang="en">Non-Steroidal Anti-Inflammatory Drugs (NSAIDs)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking non-steroidal anti-inflammatory drugs (NSAR/NSAIDs) for pain and inflammation. True if prescribed, false otherwise.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/NSAR"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#night_sweat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports night sweats (Nachtschweiss). Night sweats are a B-symptom relevant in oncological assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/night_sweat"/>
    <rdfs:label xml:lang="en">night sweat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#access_route">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The surgical or anesthesia access route used during the procedure (German: Zugangsweg).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Access Route</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/access_route"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#specific_antibodies_text">
    <rdfs:label xml:lang="en">Specific Antibodies Description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/specific_antibodies_text"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Free-text field for specifying which specific monoclonal antibodies were administered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diabetes_mellitus_code">
    <rdfs:label xml:lang="en">Diabetes Mellitus Code</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#DiabetesMellitus"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diabetes_mellitus/diabetes_mellitus_code"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A categorical code representing the type of diabetes mellitus. Known values: '1' = Type I (insulin-dependent, autoimmune destruction of pancreatic beta cells), '2' = Type IIa (milder insulin resistance with some remaining insulin production), '3' = Type IIb (more severe insulin resistance with reduced insulin production), '4' = Type II unspecified (subtype not determined), '5' = Type IIIa (diabetes associated with genetic defects of beta-cell function), '6' = Type IIIb (diabetes caused by genetic defects in insulin action), '99' = No information provided (keine Angabe).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nicotine_abuse">
    <rdfs:label xml:lang="en">nicotine abuse</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/nicotine_abuse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has a history of nicotine/tobacco abuse (Nikotinabusus).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Protonenpumpeninhibitoren">
    <rdfs:label xml:lang="en">Proton Pump Inhibitors (PPIs)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking proton pump inhibitors (Protonenpumpeninhibitoren/PPIs) to reduce stomach acid production. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Protonenpumpeninhibitoren"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#mutation_adjusted_risk_score">
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a Molecular Adsorbent Recirculating System (MARS) or Single-Pass Albumin Dialysis (SPAD) procedure was performed. Despite the column name, this represents MARS/SPAD dialysis procedures.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">MARS/SPAD performed</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/mutation_adjusted_risk_score"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#specific_antibodies">
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Specific Antibodies Administered</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether specific monoclonal antibodies were used as part of the treatment regimen.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/specific_antibodies"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_chemotherapeutics_i">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Other Chemotherapeutic Agent I</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text field for specifying the first additional chemotherapeutic agent not listed among the predefined options.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/other_chemotherapeutics_i"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sex_id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Sex"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">A unique integer identifier for the sex classification entry. Serves as the primary key for the sex lookup table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique numerical code identifying the sex/gender category (Geschlecht). Known encodings: 1 = female (weiblich), 2 = male (männlich), 3 = diverse (divers). This is the primary key of the sex classification table.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/sex/sex_id"/>
    <rdfs:label xml:lang="en">Sex Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#clavien_dindo_definition">
    <rdfs:comment xml:lang="en">A textual description of the complication severity and required interventions associated with the corresponding Clavien-Dindo grade. This definition provides clinical detail about what characterizes each grade level of postoperative complication.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Clavien-Dindo Grade Definition</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/clavien_dindo/clavien_dindo_definition"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ClavienDindo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PCT_ng_ml">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdfs:label xml:lang="en">Procalcitonin (PCT)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/PCT_ng_ml"/>
    <rdfs:comment xml:lang="en">Procalcitonin concentration measured in nanograms per millilitre (ng/ml). Marker for bacterial infections or sepsis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#stable_course">
    <rdfs:label xml:lang="en">Stable Disease Course</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient had a stable disease course (Stabiler Verlauf), meaning no significant progression or shrinkage of the tumor.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/stable_course"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drainage_complication_text">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">drainage complication text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/drainage_complication_text"/>
    <rdfs:comment xml:lang="en">Free-text field providing specific details of the drainage-related complication.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dekubitus_grade_id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Decubitus Grade Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Primary key identifier for the decubitus ulcer grade record.</rdfs:comment>
