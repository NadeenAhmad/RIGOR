    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/further_symptoms_text"/>
    <rdfs:comment xml:lang="en">Free-text description of additional symptoms reported by the patient.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diarrhea">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/diarrhea"/>
