    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/dekubitus_grade/dekubitus_grade_id"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#DekubitusGrade"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#incisional_hernia">
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralAftercare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_aftercare/incisional_hernia"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Incisional Hernia</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient has an incisional hernia (Narbenbruch). Boolean: true if present, false otherwise. Source DB type: TINYINT.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diarrhoea">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/diarrhoea"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports diarrhoea (Diarrhoe). May also be connected to treatment side effects.</rdfs:comment>
    <rdfs:label xml:lang="en">diarrhoea</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_liver_disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_liver_disease"/>
    <rdfs:comment xml:lang="en">Free-text description of other liver diseases not covered by specific hepatitis or ethyltoxic fields (Andere Lebererkrankungen).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">other liver disease</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases_4">
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:label xml:lang="en">other pre-existing diseases 4</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/other_pre_existing_diseases_4"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for the fourth additional pre-existing disease not captured by specific fields.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Steroide">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/Steroide"/>
    <rdfs:label xml:lang="en">Steroids</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking steroids, often used for inflammation or immune modulation. True if prescribed, false otherwise.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#duration_intensive_care_station_d">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Duration of the patient's stay in the Intensive Care Unit (ICU), measured in days (d).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">duration of intensive care stay</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/duration_intensive_care_station_d"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intraoperative_new_findings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Intraoperative New Findings</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">Indicates whether new findings were discovered during the operation (German: intraop Neubefund). True if new findings were identified.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/intraoperative_new_findings"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ICD">
    <rdfs:label xml:lang="en">ICD Code</rdfs:label>
    <rdfs:comment xml:lang="en">The International Classification of Diseases (ICD) alphanumeric code representing a specific medical diagnosis. Examples include E11 (Type 2 Diabetes Mellitus), C34 (Malignant neoplasm of bronchus and lung), I10 (Essential Hypertension), N18.4 (Chronic Kidney Disease Stage 4). ICD 1 typically represents the primary diagnosis, while subsequent codes represent secondary or comorbid conditions.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/icd/ICD"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Icd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#weitere_Medikation_5">
    <rdfs:label xml:lang="en">Additional Medication 5</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a fifth additional medication not covered by the standard categories. True if present, false otherwise. Detailed description in weitere_Medikation_5_Text.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/weitere_Medikation_5"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hand_foot_syndrome">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/hand_foot_syndrome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced Hand-Foot Syndrome (Hand-Fuß-Syndrom / palmar-plantar erythrodysesthesia), a common side effect of certain chemotherapy drugs such as Capecitabine and 5-FU.</rdfs:comment>
    <rdfs:label xml:lang="en">Hand-Foot Syndrome</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_complications_6">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text field for the sixth additional complication not listed in the predefined categories.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/other_complications_6"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">other complication 6</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ethyltoxic">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient has alcohol-related (ethyltoxic) liver disease (Ursache ethyltoxisch).</rdfs:comment>
    <rdfs:label xml:lang="en">ethyltoxic liver disease</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/ethyltoxic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#GeneralOperationalDetails">
    <rdfs:label xml:lang="en">General Operational Details</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents the comprehensive record of a surgical procedure including surgical details, intraoperative findings, anesthesia management, and postoperative recovery information for a patient.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosis_date_primary_tumour">
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/diagnosis_date_primary_tumour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Date when the primary tumour was diagnosed (Diagnosedatum Primaertumor). Source column is TEXT; semantically upgraded to xsd:date for proper date handling.</rdfs:comment>
    <rdfs:label xml:lang="en">diagnosis date of primary tumour</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gastric_tube">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether a gastric (nasogastric) tube was placed (German: Magensonde). True if a gastric tube was inserted.</rdfs:comment>
    <rdfs:label xml:lang="en">Gastric Tube</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/gastric_tube"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Kreatinin_μmol_per_l">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Kreatinin_μmol_per_l"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Creatinine concentration measured in micromoles per litre (μmol/l). Assesses kidney function.</rdfs:comment>
    <rdfs:label xml:lang="en">Creatinine (Kreatinin)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#noninvasive_ventilation_duration_h">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/noninvasive_ventilation_duration_h"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">non-invasive ventilation duration</rdfs:label>
    <rdfs:comment xml:lang="en">Total duration of non-invasive ventilation (e.g., CPAP, BiPAP), measured in hours (h).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#body_size_cm">
    <rdfs:comment xml:lang="en">The patient's body height measured in centimeters (cm).</rdfs:comment>
    <rdfs:label xml:lang="en">body size in centimeters</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/body_size_cm"/>
