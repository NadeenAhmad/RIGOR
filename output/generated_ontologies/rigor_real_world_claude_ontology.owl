    <rdfs:label xml:lang="en">Labour Record Identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#number_of_relatives_first_degree">
    <rdfs:label xml:lang="en">number of first-degree relatives</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/number_of_relatives_first_degree"/>
