    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced diarrhea (Diarrhoe) as a side effect of treatment.</rdfs:comment>
    <rdfs:label xml:lang="en">Diarrhea</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#other_pre_existing_diseases_3">
