    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Sodium concentration measured in millimoles per litre (mmol/l). Important for electrolyte balance and hydration status.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Natrium_mmol_per_l"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#constipation">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/constipation"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient reports constipation (Obstipation).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">constipation</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#chemotherapy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient received systemic chemotherapy. True if chemotherapy was administered.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Chemotherapy Administered</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Icd">
    <rdfs:label xml:lang="en">ICD Diagnosis Record</rdfs:label>
    <rdfs:comment xml:lang="en">Represents an International Classification of Diseases (ICD) diagnosis entry associated with a patient. Each instance captures a single ICD code and its free-text description for a patient encounter. ICD codes are alphanumeric codes representing specific medical diagnoses used worldwide in healthcare (e.g., E11 for Type 2 Diabetes, C34 for lung cancer). A patient may have multiple ICD entries representing primary and secondary/comorbid diagnoses.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/icd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ps_deterioration">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/ps_deterioration"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient experienced a general deterioration in performance status (AZ Verschlechterung / Allgemeinzustand Verschlechterung) during treatment.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Performance Status Deterioration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Leukozyten_Gpt_per_l">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Leukocytes (Leukozyten)</rdfs:label>
    <rdfs:comment xml:lang="en">White blood cell count measured in Giga particles per litre (Gpt/l). Indicates infection or inflammation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/Leukozyten_Gpt_per_l"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ileus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient developed ileus (bowel obstruction or paralysis) postoperatively.</rdfs:comment>
    <rdfs:label xml:lang="en">ileus</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/complication/ileus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ASAT_μmol_per_l">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Aspartate Aminotransferase concentration measured in micromoles per litre (μmol/l). Evaluates liver and muscle health.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">Aspartate Aminotransferase (ASAT)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/labour/ASAT_μmol_per_l"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Labour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medicalHistory_id">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/id"/>
    <rdfs:label xml:lang="en">medical history identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Primary key identifier for the medical history record. Unique integer assigned to each record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#karnofsky_index_percent">
    <rdfs:comment xml:lang="en">Karnofsky Performance Scale index expressed as a percentage (0-100%) assessing the patient's functional status. 100% = normal, no complaints; 0% = dead. Values are typically recorded in increments of 10.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/karnofsky_index_percent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:label xml:lang="en">Karnofsky Performance Index (%)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drainage_removed_date">
    <rdfs:comment xml:lang="en">The date on which surgical drains were removed (German: Drainagen entfernt Datum).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/general_operational_details/drainage_removed_date"/>
    <rdfs:label xml:lang="en">Drainage Removed Date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasSex">
    <rdfs:range rdf:resource="http://example.org/ontology#Sex"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
    <rdfs:label xml:lang="en">has sex</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient_data/sex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links patient data to the sex classification of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links patient data to the sex classification of the patient. Resolved from the foreign key column sex referencing sex.sex_id.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a patient record to the biological sex classification of the patient. Resolves the foreign key from patient_data.sex to the sex lookup table.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Medication">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Medication Record</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a patient's medication regimen, documenting specific drugs, doses, and categories of treatment including anticoagulants, anti-inflammatory drugs, steroids, antihypertensives, antidiabetics, and other prescribed medications.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#carboplatin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Carboplatin, a platinum-based antineoplastic agent, was used in the treatment regimen.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/carboplatin"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Carboplatin Administered</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#doxorubicin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Doxorubicin, an anthracycline chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
    <rdfs:label xml:lang="en">Doxorubicin Administered</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/doxorubicin"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#child_stadium_id">
    <rdfs:domain rdf:resource="http://example.org/ontology#ChildStadium"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Child-Pugh Stadium Identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Primary key identifier for the Child-Pugh classification stage. Encoded values: 0 = no cirrhosis (keine Zirrhose), 1 = Child A (mild/compensated cirrhosis with better liver function), 2 = Child B (moderate/decompensated cirrhosis with significant liver dysfunction), 3 = Child C (severe/decompensated cirrhosis with poor liver function and prognosis), 99 = no information provided (keine Angabe).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/child_stadium/child_stadium_id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#prov:Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gemcitabine">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Gemcitabine Administered</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether Gemcitabine, a nucleoside analog chemotherapy drug, was used in the treatment regimen.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/chemotherapy/gemcitabine"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Chemotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#prov:SoftwareAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
</rdf:RDF>
