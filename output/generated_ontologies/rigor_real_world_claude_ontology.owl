    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <rdfs:comment xml:lang="en">Number of first-degree relatives affected by neoplastic disease. Stored as text to accommodate non-numeric entries.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medicalHistory_created_at">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Timestamp indicating when the medical history record was created in the system. Disambiguated from PatientData.created_at by prefix.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">medical history created at</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#MedicalHistory"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medical_history/created_at"/>
