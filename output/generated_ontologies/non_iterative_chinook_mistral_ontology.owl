<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology#hasInvoiceId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#InvoiceLine"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Invoice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasMediaType">
    <rdfs:domain rdf:resource="http://example.org/ontology#Track"/>
    <rdfs:range rdf:resource="http://example.org/ontology#MediaType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Track">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasArtistId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Artist"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Artist"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Genre">
    <rdfs:label xml:lang="en">Genre</rdfs:label>
    <rdfs:label xml:lang="en">Name of the musical genre.</rdfs:label>
    <rdfs:label xml:lang="en">U12 has genre</rdfs:label>
    <rdfs:label xml:lang="en">Unique identifier for the genre.</rdfs:label>
    <rdfs:comment xml:lang="en">This is a required text field.</rdfs:comment>
    <rdfs:comment xml:lang="en">This field is the primary key of the Genre table.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Genre table stores music genre categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">This property links a track to its genre.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasPlaylist">
    <rdfs:domain rdf:resource="http://example.org/ontology#PlaylistTrack"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Playlist"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#InvoiceLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasTrack">
    <rdfs:domain rdf:resource="http://example.org/ontology#InvoiceLine"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Playlist"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#PlaylistTrack"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Track"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Name of the playlist.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the playlist.</rdfs:comment>
    <rdfs:comment xml:lang="en">A playlist contains tracks.</rdfs:comment>
    <rdfs:label xml:lang="en">has playlist ID</rdfs:label>
    <rdfs:label xml:lang="en">has name</rdfs:label>
    <rdfs:label xml:lang="en">has track</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasReportsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Employee"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Employee"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Artist">
    <rdfs:label xml:lang="en">hasName</rdfs:label>
    <rdfs:label xml:lang="en">hasArtistId</rdfs:label>
    <rdfs:label xml:lang="en">Artist</rdfs:label>
    <rdfs:comment xml:lang="en">The Artist table stores information about musical artists or performer entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name of the artist or performer. This field stores the human-readable artist name.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the artist. This field is the primary key of the Artist table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasInvoiceLine">
    <rdfs:domain rdf:resource="http://example.org/ontology#Invoice"/>
    <rdfs:range rdf:resource="http://example.org/ontology#InvoiceLine"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasArtist">
    <rdfs:range rdf:resource="http://example.org/ontology#Artist"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Album"/>
    <rdfs:comment xml:lang="en">Title of the album. This is a required text field.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier for the album. This field is the primary key of the Album table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links each album to an artist.</rdfs:comment>
    <rdfs:label xml:lang="en">hasAlbumId</rdfs:label>
    <rdfs:label xml:lang="en">hasTitle</rdfs:label>
    <rdfs:label xml:lang="en">hasArtist</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Customer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Invoice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasAlbumId">
    <rdfs:range rdf:resource="http://example.org/ontology#Album"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Track"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasGenreId">
    <rdfs:domain rdf:resource="http://example.org/ontology#Track"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Genre"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Invoice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Album">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Album</rdfs:label>
    <rdfs:comment xml:lang="en">The Album table stores information about music albums.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasMediaTypeId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#MediaType"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Track"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasSupportRepId">
    <rdfs:domain rdf:resource="http://example.org/ontology#Customer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Employee"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PlaylistTrack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Employee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#MediaType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Playlist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
</rdf:RDF>
