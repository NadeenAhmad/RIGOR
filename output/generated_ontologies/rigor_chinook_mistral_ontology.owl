    <rdfs:comment xml:lang="en">Class generated from source table 'InvoiceLine'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'InvoiceLine'. Represents individual line items within invoices, connecting invoices to tracks and recording the quantity and unit price for each purchased item.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/InvoiceLine"/>
    <rdfs:label xml:lang="en">Invoice Line</rdfs:label>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Track"/>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Invoice"/>
  </rdf:Description>
