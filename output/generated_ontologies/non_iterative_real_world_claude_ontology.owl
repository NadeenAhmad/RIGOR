  <rdf:Description rdf:about="http://example.org/ontology#:bodyMassIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">body mass index</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:comment xml:lang="en">Patient's calculated body mass index (BMI).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:preExistingDiseaseImmunologicalText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text description of the pre-existing immunological disease.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:label xml:lang="en">pre-existing disease immunological text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:ChildStadium">
    <rdfs:label xml:lang="en">Child Stadium</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Child-Pugh classification stadium for liver disease severity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasOtherChemotherapeuticsI">
    <rdfs:label xml:lang="en">Other Chemotherapeutics I</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:comment xml:lang="en">Free-text description of the first additional chemotherapeutic agent used.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ChemotherapyRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chemotherapy Record</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a chemotherapy treatment record for a patient, including details about drugs administered, treatment modalities, side effects, dosing, treatment intent, and clinical outcomes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#otherComplicationManagementText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">other complication management text</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of other complication management measures.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasRemission">
    <rdfs:label xml:lang="en">Remission</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:comment xml:lang="en">Indicates whether disease remission was achieved (1 = yes, 0 = no).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:nauseaVomiting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">nausea vomiting</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient experiences nausea or vomiting (boolean flag).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#metastasenTimepoint">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Metastasen Timepoint</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The timepoint at which the metastasis was identified or recorded, represented as a text value (e.g., preoperative, postoperative, follow-up).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Metastases"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drainageComplicationText">
    <rdfs:comment xml:lang="en">Free-text description of the drainage complication.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">drainage complication text</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Sex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents the sex classification table, capturing biological sex categories of patients (e.g., male, female, diverse).</rdfs:comment>
    <rdfs:label xml:lang="en">Sex</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#DekubitusGrade">
    <rdfs:comment xml:lang="en">Reference class for the decubitus (pressure ulcer) grading scale.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dekubitus Grade</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:MedicalHistory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medical History</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a patient's medical history record including body measurements, family history, pre-existing diseases, symptoms, and comorbidities. Corresponds to the medical_history database table.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Complication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Complication</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a complication record from the complication table, which may reference a decubitus grade score.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#otherComplicationManagement">
    <rdfs:label xml:lang="en">other complication management</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether other complication management measures were taken.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:patientIdOld">
    <rdfs:comment xml:lang="en">Legacy or previous identifier for the patient, used for backward compatibility or data migration.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:PatientData"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">patient ID old</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hasTypePrimaryMetastasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:comment xml:lang="en">Links a medical history record to the metastasis type classification.</rdfs:comment>
    <rdfs:label xml:lang="en">has type primary metastasis</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Metastases"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:patientId">
    <rdfs:label xml:lang="en">patient ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:PatientData"/>
    <rdfs:comment xml:lang="en">Primary identifier for the patient record in the patient_data table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:DiabetesMellitus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Diabetes mellitus type classification.</rdfs:comment>
    <rdfs:label xml:lang="en">Diabetes Mellitus</rdfs:label>
  </rdf:Description>
</rdf:RDF>
