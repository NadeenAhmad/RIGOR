    <rdfs:label xml:lang="en">Anti-Xa</rdfs:label>
    <rdfs:label xml:lang="en">orale Antidiabetika</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 1 Text</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 2 Text</rdfs:label>
    <rdfs:label xml:lang="en">NSAR</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 2</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 4</rdfs:label>
    <rdfs:label xml:lang="en">Antidepressiva</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 5</rdfs:label>
    <rdfs:label xml:lang="en">Antihypertensiva</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 4 Text</rdfs:label>
    <rdfs:label xml:lang="en">inhalative Bronchodilatatoren</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation</rdfs:label>
    <rdfs:label xml:lang="en">weitere Medikation 5 Text</rdfs:label>
    <rdfs:label xml:lang="en">Protonenpumpeninhibitoren</rdfs:label>
    <rdfs:comment xml:lang="en">The body mass index of the patient at the time of aftercare.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date of the aftercare visit, stored as a float value.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient has an incisional hernia (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient has recurrent cholangitis (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient has oesophageal stenosis (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The weight of the patient in kilograms at the time of aftercare.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the supply or management of the gall bladder leakage.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient has bile duct stenosis (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text notes or comments regarding the general aftercare visit.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier of the general aftercare record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The height of the patient in centimeters at the time of aftercare.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a general aftercare record to the corresponding patient data record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The timestamp when the general aftercare record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the treatment applied for bile duct stenosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient has gall bladder leakage (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether surgery was performed for the incisional hernia (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The histological diagnosis determined from the tissue examination, describing the type and nature of the tissue or tumor.</rdfs:comment>
    <rdfs:comment xml:lang="en">The order number associated with the histology request or report.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a histology general record to the corresponding patient in the patient_data table via patient_id foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name or identifier of the pathologist who performed the histological examination.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique integer identifier for the histology general record.</rdfs:comment>
    <rdfs:comment xml:lang="en">A textual summary of the histological findings and relevant observations from the pathological examination.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medical history record to the corresponding patient data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a fifth additional medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking additional medication (first entry). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Daily dose of steroids in appropriate units (e.g., mg).</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the fourth additional medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the second additional medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking Anti-Xa anticoagulants. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the medication record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking oral antidiabetic medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a second additional medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking diuretics. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medication record to the patient it belongs to. Foreign key reference to patient_data.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking insulin. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Number of different antihypertensive medications the patient is taking.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a third additional medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking thyroid hormones. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking statins. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking uricostatic drugs (e.g., allopurinol). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking Falithrom or Marcumar (phenprocoumon). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking non-steroidal anti-inflammatory drugs (NSAIDs/NSAR). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking steroids. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking acetylsalicylic acid (ASS/Aspirin). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking antidepressants. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp indicating when the medication record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the third additional medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the first additional medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking a fourth additional medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking inhaled bronchodilators. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Daily dose of insulin in units (IU).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking thyrostatic drugs. Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking proton pump inhibitors (PPIs). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of the fifth additional medication.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking Plavix (clopidogrel). Boolean flag (0 or 1).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient is taking antihypertensive medication. Boolean flag (0 or 1).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#patient:PatientData"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:PatientData"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:PatientData"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:GeneralAftercare"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:HistologyGeneral"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:familyHistoryNeoplasticDiseaseText">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">family history neoplastic disease text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text description of the family history of neoplastic disease.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:labour_hasPatient">
    <rdfs:comment xml:lang="en">Links a laboratory analysis record to the patient for whom the analysis was performed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Creatinine level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Sodium (Natrium) concentration measured in millimoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Blood urea nitrogen (Harnstoff) level measured in millimoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Glycated haemoglobin percentage, a long-term blood sugar control indicator.</rdfs:comment>
    <rdfs:comment xml:lang="en">Alkaline phosphatase level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Haemoglobin concentration measured in millimoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">White blood cell (leukocyte) count measured in Giga particles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">System lineage metadata value.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the laboratory analysis record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date on which the laboratory analysis was performed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Procalcitonin level measured in nanograms per millilitre, a marker for bacterial infection and sepsis.</rdfs:comment>
    <rdfs:comment xml:lang="en">System column lineage metadata value.</rdfs:comment>
    <rdfs:comment xml:lang="en">C-reactive protein level measured in milligrams per litre, an inflammation marker.</rdfs:comment>
    <rdfs:comment xml:lang="en">System generation metadata value.</rdfs:comment>
    <rdfs:comment xml:lang="en">Thyroid-stimulating hormone level measured in milli-units per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Bilirubin level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Modification of Diet in Renal Disease estimated GFR measured in millilitres per minute.</rdfs:comment>
    <rdfs:comment xml:lang="en">International Normalized Ratio, a measure of blood coagulation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp indicating when the laboratory record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Albumin concentration measured in grams per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Alanine aminotransferase level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Lipase enzyme level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Cholinesterase enzyme level measured in micromoles per litre, an indicator of liver synthetic function.</rdfs:comment>
    <rdfs:comment xml:lang="en">System globally unique identifier metadata value.</rdfs:comment>
    <rdfs:comment xml:lang="en">Quick value (prothrombin time) measured as a percentage.</rdfs:comment>
    <rdfs:comment xml:lang="en">Aspartate aminotransferase level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Gamma-glutamyltransferase level measured in micromoles per litre.</rdfs:comment>
    <rdfs:comment xml:lang="en">Glomerular filtration rate measured in millilitres per minute, indicating kidney function.</rdfs:comment>
    <rdfs:label xml:lang="en">INR</rdfs:label>
    <rdfs:label xml:lang="en">date of laboratory analysis</rdfs:label>
    <rdfs:label xml:lang="en">Cholinesterase (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">Kreatinin (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">ALAT (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">HbA1c (%)</rdfs:label>
    <rdfs:label xml:lang="en">Leukozyten (Gpt/l)</rdfs:label>
    <rdfs:label xml:lang="en">id</rdfs:label>
    <rdfs:label xml:lang="en">Harnstoff (mmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">AP (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">GFR (ml/min)</rdfs:label>
    <rdfs:label xml:lang="en">Lipase (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">Quick (%)</rdfs:label>
    <rdfs:label xml:lang="en">s_ColLineage</rdfs:label>
    <rdfs:label xml:lang="en">TSH (mU/l)</rdfs:label>
    <rdfs:label xml:lang="en">CRP (mg/l)</rdfs:label>
    <rdfs:label xml:lang="en">Albumin (g/l)</rdfs:label>
    <rdfs:label xml:lang="en">ASAT (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">has patient</rdfs:label>
    <rdfs:label xml:lang="en">Hämoglobin (mmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">GGT (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">MDRD (ml/min)</rdfs:label>
    <rdfs:label xml:lang="en">PCT (ng/ml)</rdfs:label>
    <rdfs:label xml:lang="en">Bilirubin (μmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">Natrium (mmol/l)</rdfs:label>
    <rdfs:label xml:lang="en">s_GUID</rdfs:label>
    <rdfs:label xml:lang="en">s_Lineage</rdfs:label>
    <rdfs:label xml:lang="en">created at</rdfs:label>
    <rdfs:label xml:lang="en">s_Generation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:PatientData"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:Labour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasRFA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:label xml:lang="en">RFA</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether Radiofrequency Ablation (RFA) was performed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:backPain">
    <rdfs:label xml:lang="en">back pain</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient experiences back pain (boolean flag).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasOtherChemotherapeuticsIII">
    <rdfs:comment xml:lang="en">Free-text description of the third additional chemotherapeutic agent used.</rdfs:comment>
    <rdfs:label xml:lang="en">Other Chemotherapeutics III</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#postoperativeBleeding">
    <rdfs:label xml:lang="en">postoperative bleeding</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Indicates whether postoperative bleeding occurred as a complication.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasDoseAccordingToBSA">
    <rdfs:label xml:lang="en">Dose According to BSA</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the dose was calculated according to Body Surface Area (BSA) (1 = yes, 0 = no).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:familyHistoryNeoplasticDisease">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a family history of neoplastic disease (boolean flag).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">family history neoplastic disease</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:PatientData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents the patient_data table containing patient information.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents patient data referenced by laboratory records.</rdfs:comment>
    <rdfs:comment xml:lang="en">Referenced patient data entity from the patient_data table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a record in the patient_data table, capturing demographic and identification information about a patient. Related to clinical data items (OGMS_0000123).</rdfs:comment>
    <rdfs:label xml:lang="en">Patient Data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#relocationIntermediateCareUnit">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">relocation to intermediate care unit</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient was relocated to the intermediate care unit.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:previousSecondaryTumour">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of a previous secondary tumour (boolean flag).</rdfs:comment>
    <rdfs:label xml:lang="en">previous secondary tumour</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasRFACycles">
    <rdfs:label xml:lang="en">RFA Cycles</rdfs:label>
    <rdfs:comment xml:lang="en">The number of RFA cycles performed.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:diarrhoea">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient experiences diarrhoea (boolean flag).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">diarrhoea</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#secondaryWoundHealing">
    <rdfs:comment xml:lang="en">Indicates whether secondary wound healing occurred as a complication.</rdfs:comment>
    <rdfs:label xml:lang="en">secondary wound healing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasLeucovorin">
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:comment xml:lang="en">Indicates whether Leucovorin was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Leucovorin</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#thrombosis">
    <rdfs:comment xml:lang="en">Indicates whether thrombosis occurred as a complication.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">thrombosis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hepatitisB">
    <rdfs:comment xml:lang="en">Indicates whether the patient has hepatitis B (boolean flag).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hepatitis B</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cholascos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">cholascos</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:comment xml:lang="en">Indicates whether cholascos (bile ascites) occurred as a complication.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasDocetaxel">
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:comment xml:lang="en">Indicates whether Docetaxel was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Docetaxel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:diagnosisDateMetastasis">
    <rdfs:comment xml:lang="en">Date of diagnosis of metastasis.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">diagnosis date metastasis</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasPatient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#PatientData"/>
    <rdfs:range rdf:resource="http://example.org/ontology#patient:PatientData"/>
    <rdfs:label xml:lang="en">has patient</rdfs:label>
    <rdfs:label xml:lang="en">analgosedation</rdfs:label>
    <rdfs:label xml:lang="en">parenteral nutrition</rdfs:label>
    <rdfs:label xml:lang="en">laparoscopic procedure</rdfs:label>
    <rdfs:label xml:lang="en">created at</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative new findings text</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia duration in minutes</rdfs:label>
    <rdfs:label xml:lang="en">access route</rdfs:label>
    <rdfs:label xml:lang="en">rapid sequence induction (RSI)</rdfs:label>
    <rdfs:label xml:lang="en">lumbar peridural anaesthesia (PDA)</rdfs:label>
    <rdfs:label xml:lang="en">spinal anaesthesia (SPA)</rdfs:label>
    <rdfs:label xml:lang="en">previous operations</rdfs:label>
    <rdfs:label xml:lang="en">caudal block</rdfs:label>
    <rdfs:label xml:lang="en">stand-by monitoring</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia time start</rdfs:label>
    <rdfs:label xml:lang="en">operation time end</rdfs:label>
    <rdfs:label xml:lang="en">mobilisation postoperative date</rdfs:label>
    <rdfs:label xml:lang="en">conversion laparoscopic to open</rdfs:label>
    <rdfs:label xml:lang="en">surgeon</rdfs:label>
    <rdfs:label xml:lang="en">continuous bladder catheter</rdfs:label>
    <rdfs:label xml:lang="en">adhesions</rdfs:label>
    <rdfs:label xml:lang="en">gastric tube removed date</rdfs:label>
    <rdfs:label xml:lang="en">cirrhosis intraoperative</rdfs:label>
    <rdfs:label xml:lang="en">operation duration in minutes</rdfs:label>
    <rdfs:label xml:lang="en">ASA score</rdfs:label>
    <rdfs:label xml:lang="en">number of erythrocyte concentrates</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia special</rdfs:label>
    <rdfs:label xml:lang="en">combined spinal-epidural anaesthesia (CSE)</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia time end</rdfs:label>
    <rdfs:label xml:lang="en">Apfel score</rdfs:label>
    <rdfs:label xml:lang="en">number of fresh frozen plasmas</rdfs:label>
    <rdfs:label xml:lang="en">intravenous regional anaesthesia (IVRA)</rdfs:label>
    <rdfs:label xml:lang="en">postoperative nutrition date</rdfs:label>
    <rdfs:label xml:lang="en">transfusion</rdfs:label>
    <rdfs:label xml:lang="en">bladder catheter removed date</rdfs:label>
    <rdfs:label xml:lang="en">fiberoptic intubation (FFO)</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative special features</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative new findings</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative special features text</rdfs:label>
    <rdfs:label xml:lang="en">id</rdfs:label>
    <rdfs:label xml:lang="en">operation time start</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia special text</rdfs:label>
    <rdfs:label xml:lang="en">general anaesthesia</rdfs:label>
    <rdfs:label xml:lang="en">operation date</rdfs:label>
    <rdfs:label xml:lang="en">total intravenous anaesthesia (TIVA)</rdfs:label>
    <rdfs:label xml:lang="en">thoracic peridural anaesthesia (PDA)</rdfs:label>
    <rdfs:label xml:lang="en">gastric tube</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#GeneralOperationalDetails"/>
    <rdfs:comment xml:lang="en">Links a complication record to the associated patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether special anaesthesia techniques were used (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether adhesions were found during the operation (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The start time of the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date when the gastric tube was removed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of special anaesthesia techniques used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The end time of anaesthesia administration.</rdfs:comment>
    <rdfs:comment xml:lang="en">American Society of Anesthesiologists physical status classification score.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a conversion from laparoscopic to open surgery occurred (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The surgical access route used during the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Number of erythrocyte concentrates (packed red blood cells) transfused during the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Number of fresh frozen plasma units transfused during the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The end time of the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether spinal anaesthesia was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a gastric tube was placed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether parenteral nutrition was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether liver cirrhosis was identified intraoperatively (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Links general operational details to the corresponding patient record via patient_id foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">Total duration of anaesthesia measured in minutes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether total intravenous anaesthesia was used (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key identifier for the general operational details record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a continuous bladder catheter was placed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of intraoperative special features.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp indicating when the record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether intravenous regional anaesthesia was used (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether analgosedation was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a laparoscopic procedure was performed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether general anaesthesia was used (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the patient had previous operations (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a blood transfusion was administered during the operation (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The date on which the operation was performed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date when postoperative nutrition was started.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name or identifier of the surgeon who performed the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether stand-by monitoring was used during the procedure (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether thoracic peridural anaesthesia was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">The start time of anaesthesia administration.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether combined spinal-epidural anaesthesia was used (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Date of first postoperative mobilisation of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether lumbar peridural anaesthesia was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Apfel score for predicting postoperative nausea and vomiting risk.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date when the bladder catheter was removed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Total duration of the operation measured in minutes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether rapid sequence induction was performed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether there were special features noted intraoperatively (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of new findings discovered intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether new findings were discovered intraoperatively (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether a caudal block was performed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether fiberoptic intubation was performed (1 = yes, 0 = no).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#endoscopy">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">endoscopy</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether endoscopy was performed as part of complication management.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#embolism">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether embolism occurred as a complication.</rdfs:comment>
    <rdfs:label xml:lang="en">embolism</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ileus">
    <rdfs:comment xml:lang="en">Indicates whether ileus (bowel obstruction) occurred as a complication.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">ileus</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#haemodialysisH">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">Duration of haemodialysis in hours.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">haemodialysis duration (hours)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasCisplatin">
    <rdfs:comment xml:lang="en">Indicates whether Cisplatin was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Cisplatin</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#complicationFreeProgression">
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">complication-free progression</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient had a complication-free postoperative progression (boolean).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:diabetesMellitusDescription">
    <rdfs:comment xml:lang="en">A free-text description providing details about the specific diabetes mellitus classification entry.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:DiabetesMellitus"/>
    <rdfs:label xml:lang="en">diabetes mellitus description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:PatientData">
    <rdfs:comment xml:lang="en">Represents a patient record referenced by the patient_data table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient Data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasEpirubicin">
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:comment xml:lang="en">Indicates whether Epirubicin was administered (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:label xml:lang="en">Epirubicin</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasAlopecia">
    <rdfs:label xml:lang="en">Alopecia</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether alopecia (hair loss) occurred as a side effect (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:Sex">
    <rdfs:label xml:lang="en">Sex</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the sex lookup table, containing sex definitions referenced by patient_data.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:otherLiverDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:label xml:lang="en">other liver disease</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of other liver diseases.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasProgression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Progression</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether disease progression was observed (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasRadiationAmountInGray">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment xml:lang="en">The amount of radiation administered, measured in Gray (Gy).</rdfs:comment>
    <rdfs:label xml:lang="en">Radiation Amount in Gray</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:nocturia">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:label xml:lang="en">nocturia</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient experiences nocturia (boolean flag).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasCreatedAt">
    <rdfs:comment xml:lang="en">Timestamp when this chemotherapy record was created.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Created At</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:otherPreExistingDiseases2">
    <rdfs:label xml:lang="en">other pre-existing diseases 2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text description of the second additional pre-existing disease.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#mutationAdjustedRiskScoreH">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">mutation adjusted risk score value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Value of the mutation-adjusted risk score.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasNumberOfCycles">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Number of Cycles</rdfs:label>
    <rdfs:comment xml:lang="en">The number of chemotherapy cycles administered.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drainageComplication">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether a drainage-related complication occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:label xml:lang="en">drainage complication</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:localisationOfTheMetastasis">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:label xml:lang="en">localisation of the metastasis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Description of the localisation of the metastasis.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:firstHaemodialysis">
    <rdfs:comment xml:lang="en">Date or description of the first haemodialysis.</rdfs:comment>
    <rdfs:label xml:lang="en">first haemodialysis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:DiabetesMellitus">
    <rdfs:label xml:lang="en">Diabetes Mellitus</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a diabetes mellitus classification entry, containing a unique identifier, a code, and a textual description. Aligned with DOID:9351 (diabetes mellitus).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hepatitisC">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has hepatitis C (boolean flag).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">hepatitis C</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:otherPreExistingDiseases4">
    <rdfs:comment xml:lang="en">Free-text description of the fourth additional pre-existing disease.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">other pre-existing diseases 4</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasId">
    <rdfs:comment xml:lang="en">Unique identifier for the chemotherapy record.</rdfs:comment>
    <rdfs:label xml:lang="en">ID</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
