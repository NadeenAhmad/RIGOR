  <rdf:Description rdf:about="http://example.org/ontology#:ChildStadium">
    <rdfs:comment xml:lang="en">The unique integer identifier for a Child-Pugh stadium entry.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the Child-Pugh classification stadium used to assess the prognosis of chronic liver disease, primarily cirrhosis. Each instance defines a specific Child-Pugh stage (e.g., Child A, B, or C) along with its clinical definition.</rdfs:comment>
    <rdfs:comment xml:lang="en">A textual description defining the criteria and characteristics of the Child-Pugh stadium classification level.</rdfs:comment>
    <rdfs:label xml:lang="en">Child Stadium</rdfs:label>
    <rdfs:label xml:lang="en">Child Stadium ID</rdfs:label>
    <rdfs:label xml:lang="en">Child Stadium Definition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#multiOrganFailure">
