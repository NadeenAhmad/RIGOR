    <rdfs:domain rdf:resource="http://example.org/ontology#ChemotherapyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:weightLoss">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has experienced weight loss (boolean flag).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">weight loss</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:ClavienDindo">
    <rdfs:comment xml:lang="en">The grade designation in the Clavien-Dindo classification system (e.g., Grade I, Grade II, Grade IIIa, Grade IIIb, Grade IVa, Grade IVb, Grade V).</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the Clavien-Dindo classification system for grading surgical complications. Each instance corresponds to a specific grade with its definition.</rdfs:comment>
    <rdfs:comment xml:lang="en">The textual definition describing the criteria and characteristics of the corresponding Clavien-Dindo complication grade.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for a Clavien-Dindo classification grade entry.</rdfs:comment>
    <rdfs:label xml:lang="en">Clavien-Dindo</rdfs:label>
    <rdfs:label xml:lang="en">Clavien-Dindo Definition</rdfs:label>
    <rdfs:label xml:lang="en">Clavien-Dindo ID</rdfs:label>
    <rdfs:label xml:lang="en">Clavien-Dindo Grade</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#readmissionToClinicDate">
    <rdfs:comment xml:lang="en">Date of readmission to the clinic.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Complication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">readmission to clinic date</rdfs:label>
  </rdf:Description>
