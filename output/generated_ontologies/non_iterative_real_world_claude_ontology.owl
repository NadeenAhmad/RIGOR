    <rdfs:range rdf:resource="http://example.org/ontology#db:DiabetesMellitus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:numberOfRelativesFirstDegree">
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdfs:label xml:lang="en">number of relatives first degree</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Number or description of first-degree relatives affected by neoplastic disease.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:hasSex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:PatientData"/>
    <rdfs:range rdf:resource="http://example.org/ontology#db:Sex"/>
    <rdfs:label xml:lang="en">has sex</rdfs:label>
    <rdfs:comment xml:lang="en">Links a patient data record to the corresponding sex classification. Foreign key relationship from patient_data.sex to sex.sex_id.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#db:createdAt">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
