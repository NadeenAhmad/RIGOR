  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasChemotherapy">
    <rdfs:label xml:lang="en">Chemotherapy</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient received chemotherapy (1 = yes, 0 = no).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
