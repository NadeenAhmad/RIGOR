    <rdfs:label xml:lang="en">id</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#db:ICD"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
