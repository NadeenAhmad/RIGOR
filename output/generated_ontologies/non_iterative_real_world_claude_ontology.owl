  <rdf:Description rdf:about="http://example.org/ontology#:hasDiabetesType">
    <rdfs:comment xml:lang="en">Links a medical history record to the diabetes mellitus type classification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:MedicalHistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
