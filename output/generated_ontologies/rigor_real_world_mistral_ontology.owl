  <rdf:Description rdf:about="http://example.org/ontology#Sex">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/sex"/>
    <rdfs:label xml:lang="en">Sex</rdfs:label>
    <rdfs:comment xml:lang="en">The sex of an individual.</rdfs:comment>
    <rdfs:comment xml:lang="en">This class represents the sex of a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The biological sex of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the sex of a patient, encoded as an integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the sex of a patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The biological sex of an individual.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the sex of a patient, which can be male, female, or other.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the classification of gender.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
