  <rdf:Description rdf:about="http://example.org/ontology#Pasthistory">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Past Medical History</rdfs:label>
    <rdfs:comment xml:lang="en">Records of a patient's previous medical conditions, treatments, and procedures</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplitemoffset">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset (in minutes) from hospital admission when the care plan item was documented</rdfs:comment>
    <rdfs:label xml:lang="en">care plan item offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSECAREENTRYOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nurse Care Entry Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Offset time indicating when the nurse care entry was made.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdxname">
    <rdfs:label xml:lang="en">admission diagnosis name</rdfs:label>
    <rdfs:comment xml:lang="en">Standardized name or code of the admission diagnosis</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labresult">
    <rdfs:comment xml:lang="en">The numerical result of the laboratory test.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">Lab Result</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEOFFSET">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset of the note in relation to the patient's admission.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <rdfs:label xml:lang="en">Note Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Infusiondrug">
    <rdfs:label xml:lang="en">Infusion Drug</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents data related to drug infusions administered to patients.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apacheversion">
    <rdfs:label xml:lang="en">APACHE version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The version of the APACHE scoring system used (e.g., APACHE II, APACHE IV)</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:comment xml:lang="en">Time offset (in minutes) from hospital admission when drug was prescribed</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">drug offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#antibiotic">
    <rdfs:domain rdf:resource="http://example.org/ontology#Microlab"/>
    <rdfs:label xml:lang="en">antibiotic</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/antibiotic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Antibiotic tested against the cultured organism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#careprovidersaveoffset">
    <rdfs:label xml:lang="en">care provider save offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Time offset for when the care provider information was saved</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#noninvasivediastolic">
    <rdfs:label xml:lang="en">non-invasive diastolic blood pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Diastolic blood pressure measured non-invasively, in mmHg</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#st2">
    <rdfs:comment xml:lang="en">Second ST segment measurement from ECG in millivolts</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:label xml:lang="en">ST segment 2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Nursecharting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Documentation of patient care parameters and observations by nursing staff</rdfs:comment>
    <rdfs:label xml:lang="en">Nurse Charting</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Vitalperiodic">
    <rdfs:comment xml:lang="en">Records periodic measurements of patient vital signs in clinical settings</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vital Signs Periodic Measurement</rdfs:label>
  </rdf:Description>
</rdf:RDF>
