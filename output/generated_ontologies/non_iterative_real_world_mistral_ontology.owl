    <rdfs:comment xml:lang="en">A class representing the child_stadium table in the database.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasHistologicalDiagnosis">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The histological diagnosis for the histology general record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#histology_general"/>
    <rdfs:label xml:lang="en">has histological diagnosis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasSex">
    <rdfs:domain rdf:resource="http://example.org/ontology#PatientData"/>
    <rdfs:label xml:lang="en">has creation date</rdfs:label>
    <rdfs:label xml:lang="en">Patient Data</rdfs:label>
    <rdfs:label xml:lang="en">has sex</rdfs:label>
    <rdfs:label xml:lang="en">has old patient ID</rdfs:label>
    <rdfs:label xml:lang="en">has age at surgery</rdfs:label>
    <rdfs:label xml:lang="en">has patient ID</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a patient data entry to the sex of the patient</rdfs:comment>
    <rdfs:comment xml:lang="en">The old ID of the patient</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the data of a patient, including ID, old ID, creation date, sex, and age at surgery</rdfs:comment>
    <rdfs:comment xml:lang="en">The date and time when the patient data was created</rdfs:comment>
    <rdfs:comment xml:lang="en">The ID of the patient</rdfs:comment>
    <rdfs:comment xml:lang="en">The age of the patient at the time of surgery</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#Sex"/>
  </rdf:Description>
