  <rdf:Description rdf:about="http://example.org/ontology#general_operational_details">
    <rdfs:comment xml:lang="en">The unique identifier for this record.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if FFO was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Text description of special features detected intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if the patient was discharged with drainage.</rdfs:comment>
    <rdfs:comment xml:lang="en">The end time of the anaesthesia.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if there were special features intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if CSE was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient associated with this record.</rdfs:comment>
    <rdfs:comment xml:lang="en">The start time of the anaesthesia.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if a caudal block was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if thoracic PDA was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date when the gastric tube was removed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if general anaesthesia was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if cirrhosis was detected intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">The duration of the operation in minutes.</rdfs:comment>
    <rdfs:comment xml:lang="en">The ASA score of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if a transfusion was performed.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date of postoperative nutrition.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if new findings were detected intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if RSI was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Text description of special features in the anaesthesia.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if SPA was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if a continuous bladder catheter was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if there were special features in the anaesthesia.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if parenteral nutrition was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date when the drainage was removed.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date when the bladder catheter was removed.</rdfs:comment>
    <rdfs:comment xml:lang="en">The duration of the anaesthesia in minutes.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date of post-operative mobilisation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if a gastric tube was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if IVRA was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The end time of the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The access route used during the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Apfel score of the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of ECS.</rdfs:comment>
    <rdfs:comment xml:lang="en">Text description of new findings detected intraoperatively.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if lumbar PDA was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of FFPS.</rdfs:comment>
    <rdfs:comment xml:lang="en">The timestamp when the record was created.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if the procedure was laparoscopic.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if there were previous operations.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if TIVA was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if adhesions were present.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the surgeon.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if the procedure was converted from laparoscopic to open.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if stand-by monitoring was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates if analgosedation was used.</rdfs:comment>
    <rdfs:comment xml:lang="en">The start time of the operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date of the operation.</rdfs:comment>
    <rdfs:label xml:lang="en">anaesthesia duration in minutes</rdfs:label>
    <rdfs:label xml:lang="en">discharge with drainage</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia special</rdfs:label>
    <rdfs:label xml:lang="en">conversion lap open</rdfs:label>
    <rdfs:label xml:lang="en">postoperative nutrition date</rdfs:label>
    <rdfs:label xml:lang="en">TIVA</rdfs:label>
    <rdfs:label xml:lang="en">patient</rdfs:label>
    <rdfs:label xml:lang="en">thoracic PDA</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia time start</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative new findings</rdfs:label>
    <rdfs:label xml:lang="en">id</rdfs:label>
    <rdfs:label xml:lang="en">operation time start</rdfs:label>
    <rdfs:label xml:lang="en">general anaesthesia</rdfs:label>
    <rdfs:label xml:lang="en">gastric tube</rdfs:label>
    <rdfs:label xml:lang="en">drainage removed date</rdfs:label>
    <rdfs:label xml:lang="en">surgeon</rdfs:label>
    <rdfs:label xml:lang="en">CSE</rdfs:label>
    <rdfs:label xml:lang="en">adhesions</rdfs:label>
    <rdfs:label xml:lang="en">operation duration in minutes</rdfs:label>
    <rdfs:label xml:lang="en">intraop special features</rdfs:label>
    <rdfs:label xml:lang="en">IVRA</rdfs:label>
    <rdfs:label xml:lang="en">cirrhosis intraop</rdfs:label>
    <rdfs:label xml:lang="en">laparoscopic procedure</rdfs:label>
    <rdfs:label xml:lang="en">ASA score</rdfs:label>
    <rdfs:label xml:lang="en">intraoperative new findings text</rdfs:label>
    <rdfs:label xml:lang="en">number of ECS</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia time end</rdfs:label>
    <rdfs:label xml:lang="en">Apfel score</rdfs:label>
    <rdfs:label xml:lang="en">FFO</rdfs:label>
    <rdfs:label xml:lang="en">lumbar PDA</rdfs:label>
    <rdfs:label xml:lang="en">access route</rdfs:label>
    <rdfs:label xml:lang="en">intraop special features text</rdfs:label>
    <rdfs:label xml:lang="en">transfusion</rdfs:label>
    <rdfs:label xml:lang="en">SPA</rdfs:label>
    <rdfs:label xml:lang="en">bladder catheter removed date</rdfs:label>
    <rdfs:label xml:lang="en">RSI</rdfs:label>
    <rdfs:label xml:lang="en">previous operations</rdfs:label>
    <rdfs:label xml:lang="en">caudal block</rdfs:label>
    <rdfs:label xml:lang="en">stand-by monitoring</rdfs:label>
    <rdfs:label xml:lang="en">anaesthesia special text</rdfs:label>
    <rdfs:label xml:lang="en">mobilisation postop date</rdfs:label>
    <rdfs:label xml:lang="en">operation date</rdfs:label>
    <rdfs:label xml:lang="en">operation time end</rdfs:label>
    <rdfs:label xml:lang="en">analgosedation</rdfs:label>
    <rdfs:label xml:lang="en">parenteral nutrition</rdfs:label>
    <rdfs:label xml:lang="en">continuous bladder catheter</rdfs:label>
    <rdfs:label xml:lang="en">gastric tube removed date</rdfs:label>
    <rdfs:label xml:lang="en">number of FFPS</rdfs:label>
    <rdfs:label xml:lang="en">created at</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
