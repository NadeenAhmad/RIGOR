  <rdf:Description rdf:about="http://example.org/ontology#LOWPEAKPRESLIMIT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Lower alarm limit for peak inspiratory pressure, measured in cmH2O.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/LOWPEAKPRESLIMIT"/>
    <rdfs:label xml:lang="en">Low Peak Pressure Limit</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Note">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Clinical Note</rdfs:label>
    <rdfs:comment xml:lang="en">A clinical note or documentation entry recorded during a patient's unit stay. Notes capture various types of clinical observations, assessments, and care documentation.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Nursecare">
    <rdfs:comment xml:lang="en">External alignment: nursecareid exactly 1 xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a nursing care documentation entry recorded during a patient's unit stay. Each record captures a specific nursing care observation or intervention, including the cell label, attribute path, attribute name, and attribute value from the nursing care charting system.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nurse Care Entry</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PRIORVENTSTARTOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/PRIORVENTSTARTOFFSET"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to the start of a prior mechanical ventilation episode.</rdfs:comment>
    <rdfs:label xml:lang="en">Prior Ventilation Start Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitdischargestatus">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitdischargestatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The status of the patient at unit discharge (e.g., Alive, Expired).</rdfs:comment>
    <rdfs:comment xml:lang="en">The vital status of the patient at the time of unit discharge (e.g., 'Alive', 'Expired'). Indicates whether the patient survived to unit discharge.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:label xml:lang="en">Unit Discharge Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cardiacinput">
    <rdfs:label xml:lang="en">Cardiac Input</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/cardiacinput"/>
    <rdfs:comment xml:lang="en">Cardiac input measurement, typically the cardiac index or a related hemodynamic parameter, measured in L/min/m² or similar units.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intakeoutputoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/intakeoutputoffset"/>
    <rdfs:label xml:lang="en">Intake Output Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when this intake/output record was documented. A negative value indicates a time before ICU admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#frequency">
    <rdfs:label xml:lang="en">Frequency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">The frequency at which the medication is administered (e.g., 'once daily', 'every 8 hours', 'BID', 'TID', 'PRN').</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/frequency"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Respiratorycharting">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting"/>
    <rdfs:comment xml:lang="en">External alignment: RESPCHARTID exactly 1 xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a respiratory charting entry recorded during a patient's unit stay. Each record captures a specific respiratory measurement or observation, including ventilator settings, respiratory parameters, and related clinical values.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Respiratory Charting</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistoryvaluetext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text or extended description of the past history value, providing additional detail beyond the coded value. Maximum 255 characters.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Past History Value Text</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistoryvaluetext"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:infectdiseaseassessment">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/infectdiseaseassessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Clinical assessment or diagnosis of the infectious disease, describing the type or nature of the infection identified (e.g., suspected urinary tract infection, confirmed pneumonia, sepsis).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Infectious Disease Assessment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#leukemia">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Leukemia</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/leukemia"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of leukemia as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#saps3day1">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Simplified Acute Physiology Score 3 (SAPS 3) calculated on the first day of ICU admission. Used to assess severity of illness.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/saps3day1"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">SAPS 3 Day 1 Score</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diabetes">
    <rdfs:comment xml:lang="en">Indicates whether the patient has diabetes as a comorbidity for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/diabetes"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Diabetes</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugivadmixture">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugivadmixture"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Indicates whether the drug is an intravenous (IV) admixture. Typically contains a yes/no or similar categorical string value.</rdfs:comment>
    <rdfs:label xml:lang="en">Drug IV Admixture</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaldischargeyear">
    <rdfs:label xml:lang="en">Hospital Discharge Year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaldischargeyear"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The year in which the patient was discharged from the hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">The calendar year in which the patient was discharged from the hospital, stored as an integer (e.g., 2014, 2015). Source column is SMALLINT.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTID">
    <rdfs:comment xml:lang="en">Unique primary key identifier for each respiratory charting entry. This is a surrogate key that uniquely identifies a single respiratory observation record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTID"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Respiratory Chart ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#age">
    <rdfs:label xml:lang="en">Age</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The age of the patient as a string. May contain numeric values or descriptive text such as '&gt; 89' for patients older than 89 years, in compliance with de-identification requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">The age of the patient at the time of unit admission, stored as a string. Values may include numeric ages or the special value '&gt; 89' for patients older than 89 years, in compliance with de-identification requirements.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/age"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTCELLTYPEVALLABEL">
    <rdfs:comment xml:lang="en">The human-readable label for the type of value recorded in the nursing chart cell (e.g., Heart Rate, Blood Pressure, Temperature, Glasgow Coma Score).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTCELLTYPEVALLABEL"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nursing Chart Cell Type Value Label</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#LOWEXHTVLIMIT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/LOWEXHTVLIMIT"/>
    <rdfs:label xml:lang="en">Low Exhaled Tidal Volume Limit</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:comment xml:lang="en">Lower alarm limit for exhaled tidal volume, measured in milliliters (mL).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patientunitstayid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each patient unit stay record.</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique integer identifier for each patient unit stay. Serves as the primary key for the patient table, uniquely identifying a single ICU or hospital unit admission episode.</rdfs:comment>
    <rdfs:label xml:lang="en">Patient Unit Stay ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/patientunitstayid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#amilocation">
    <rdfs:comment xml:lang="en">Encoded location of acute myocardial infarction (AMI). Categorical integer representing the anatomical location of the infarction (e.g., anterior, inferior, lateral).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">AMI Location</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/amilocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ethnicity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The ethnicity of the patient as recorded in the clinical system.</rdfs:comment>
    <rdfs:comment xml:lang="en">The self-reported or recorded ethnicity of the patient (e.g., 'Caucasian', 'African American', 'Hispanic', 'Asian', 'Native American', 'Other/Unknown').</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/ethnicity"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:label xml:lang="en">Ethnicity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergyenteredoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:label xml:lang="en">Allergy Entered Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergyenteredoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time to when the allergy was entered into the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sao2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Peripheral arterial oxygen saturation measured as a percentage (0-100%). Reflects the proportion of hemoglobin binding sites occupied by oxygen.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/sao2"/>
    <rdfs:label xml:lang="en">Arterial Oxygen Saturation (SaO2)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEVALUE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTEVALUE"/>
    <rdfs:comment xml:lang="en">A structured or coded value associated with the clinical note, typically a short categorical or numeric entry corresponding to the note path.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <rdfs:label xml:lang="en">Note Value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#managementsystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/managementsystem"/>
    <rdfs:comment xml:lang="en">Encoded management system type for the patient. Categorical integer representing the type of clinical management system used.</rdfs:comment>
    <rdfs:label xml:lang="en">Management System</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#readmit">
    <rdfs:comment xml:lang="en">Indicates whether this is a readmission to the ICU. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/readmit"/>
    <rdfs:label xml:lang="en">Readmission Flag</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/gender"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The gender of the patient (e.g., Male, Female, Other, Unknown).</rdfs:comment>
    <rdfs:comment xml:lang="en">The gender of the patient, recorded as a string value (e.g., 'Male', 'Female', 'Other', or 'Unknown').</rdfs:comment>
    <rdfs:label xml:lang="en">Gender</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTENTRYOFFSET">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTENTRYOFFSET"/>
    <rdfs:label xml:lang="en">Nursing Chart Entry Offset</rdfs:label>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the nursing chart entry was entered into the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sicuday">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The day number in the surgical ICU stay used for APACHE scoring.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/sicuday"/>
    <rdfs:label xml:lang="en">Surgical ICU Day</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admissiondxid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">A unique integer identifier serving as the primary key for each admission diagnosis record.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx/admissiondxid"/>
    <rdfs:label xml:lang="en">Admission Diagnosis Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labresultoffset">
    <rdfs:label xml:lang="en">Lab Result Offset</rdfs:label>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time to when the lab result was obtained.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labresultoffset"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:physicalexamid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Physical Examination ID</rdfs:label>
    <rdfs:comment xml:lang="en">Unique integer identifier for each physical examination record. Serves as the primary key of the physicalexam table.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/physicalexamid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#careprovidersaveoffset">
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the care provider record was saved.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:label xml:lang="en">Care Provider Save Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/careprovidersaveoffset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CPAPLIMIT">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/CPAPLIMIT"/>
    <rdfs:label xml:lang="en">CPAP Limit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Alarm limit for Continuous Positive Airway Pressure (CPAP), measured in cmH2O. CPAP provides constant pressure to maintain airway patency.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistoryenteredoffset">
    <rdfs:label xml:lang="en">Past History Entered Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to when the past history entry was entered into the system.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistoryenteredoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:cplinfectdiseaseoffset">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to when the infectious disease entry was recorded in the care plan. A negative value indicates the entry was recorded before unit admission.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan Infectious Disease Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/cplinfectdiseaseoffset"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HIPEAKPRESLIMIT">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">High Peak Pressure Limit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Upper alarm limit for peak inspiratory pressure, measured in cmH2O.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/HIPEAKPRESLIMIT"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#MEANAIRWAYPRESLIMIT">
    <rdfs:label xml:lang="en">Mean Airway Pressure Limit</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/MEANAIRWAYPRESLIMIT"/>
    <rdfs:comment xml:lang="en">Alarm limit for mean airway pressure, measured in cmH2O.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ventday1">
    <rdfs:comment xml:lang="en">Indicates whether the patient was on mechanical ventilation on the first day of ICU admission. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/ventday1"/>
    <rdfs:label xml:lang="en">Ventilation on Day 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1pao2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Partial pressure of arterial oxygen (PaO2) on day 1 of ICU admission, measured in mmHg.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1pao2"/>
    <rdfs:label xml:lang="en">Day 1 PaO2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#visitnumber">
    <rdfs:comment xml:lang="en">The sequential visit number for the patient, indicating the order of ICU admissions.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Visit Number</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/visitnumber"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#region">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Hospital"/>
    <rdfs:comment xml:lang="en">Encoded geographic region of the hospital. Categorical integer representing the region (e.g., Midwest, Northeast, South, West).</rdfs:comment>
    <rdfs:comment xml:lang="en">The geographic region of the United States where the hospital is located (e.g., 'Midwest', 'Northeast', 'South', 'West').</rdfs:comment>
    <rdfs:comment xml:lang="en">The software agent responsible for generating the ontology from the database schema.</rdfs:comment>
    <rdfs:comment xml:lang="en">The JSON representation of the database schema used as input for the direct mapping process.</rdfs:comment>
    <rdfs:comment xml:lang="en">The provenance activity that generated this ontology from the eICU database schema via direct mapping.</rdfs:comment>
    <rdfs:comment xml:lang="en">The geographic region where the hospital is located. This is a string value representing the administrative or geographic area of the hospital. Note: the core ontology previously declared this property with xsd:integer range, which is corrected here to xsd:string to match the source schema (VARCHAR(64)).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/region"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/hospital/region"/>
    <rdfs:label xml:lang="en">Geographic Region</rdfs:label>
    <rdfs:label xml:lang="en">Direct Mapping Activity</rdfs:label>
    <rdfs:label xml:lang="en">Schema JSON</rdfs:label>
    <rdfs:label xml:lang="en">Ontology Generator Script</rdfs:label>
    <rdfs:label xml:lang="en">Region</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#treatmentoffset">
    <rdfs:label xml:lang="en">Treatment Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Treatment"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the treatment was recorded or administered.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/treatment/treatmentoffset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cellpath">
    <rdfs:comment xml:lang="en">The hierarchical path within the intake/output flowsheet that identifies the category and type of the recorded value (e.g., 'intake|Crystalloids|Normal Saline'). Represents the navigation path in the clinical documentation system.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/cellpath"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:label xml:lang="en">Cell Path</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SIGHPRESLIMIT">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SIGHPRESLIMIT"/>
    <rdfs:comment xml:lang="en">Alarm limit for sigh breath pressure, measured in cmH2O. Sigh breaths are periodic larger breaths delivered by the ventilator.</rdfs:comment>
    <rdfs:label xml:lang="en">Sigh Pressure Limit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labtypeid">
    <rdfs:label xml:lang="en">Lab Type Identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labtypeid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Categorical identifier representing the type of laboratory test performed. This is a coded integer value referencing a lab type classification system. DECIMAL(3,0) in the source schema, effectively an integer code.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTCELLTYPECAT">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nursing Chart Cell Type Category</rdfs:label>
    <rdfs:comment xml:lang="en">The category of the nursing chart cell type, representing the broad clinical domain of the observation (e.g., Vital Signs, Scores/Assessments, Routine Vital Signs).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTCELLTYPECAT"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#immunosuppression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is immunosuppressed as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Immunosuppression</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/immunosuppression"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdxname">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Admission Diagnosis Name</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx/admitdxname"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The standardized short name of the admission diagnosis as selected from the eICU diagnosis picklist.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labothervaluetext">
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/labothervaluetext"/>
    <rdfs:comment xml:lang="en">The textual representation of the custom laboratory test value, which may include numeric values with units or free-text results. For numeric lab values, the unit depends on the specific test identified by labothername (e.g., µmol/L for Bilirubin, U/L for liver enzymes, mg/dL for Creatinine, mg/L for CRP, ng/mL for PCT, g/dL for Hemoglobin, mmol/L for Sodium).</rdfs:comment>
    <rdfs:label xml:lang="en">Lab Other Value Text</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labresultrevisedoffset">
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time to when the lab result was revised or finalized.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Lab Result Revised Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labresultrevisedoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nursingchartid">
    <rdfs:label xml:lang="en">Nursing Chart ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/nursingchartid"/>
    <rdfs:comment xml:lang="en">Unique identifier for each nurse charting entry. Serves as the primary key for the nursecharting table.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cpleolsaveoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Care Plan End of Life Save Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplaneol"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaneol/cpleolsaveoffset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time when the end-of-life care plan was saved.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1meds">
    <rdfs:comment xml:lang="en">Indicates whether the patient was on sedative or paralytic medications affecting GCS assessment on day 1 of ICU admission. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1meds"/>
    <rdfs:label xml:lang="en">Day 1 GCS Medications Flag</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1motor">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1motor"/>
    <rdfs:label xml:lang="en">Day 1 GCS Motor Score</rdfs:label>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale motor component score on day 1 of ICU admission. Ordinal integer ranging from 1 (no motor response) to 6 (obeys commands). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#treatmentid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Treatment"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/treatment/treatmentid"/>
    <rdfs:label xml:lang="en">Treatment ID</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A unique integer identifier for each treatment record. Serves as the primary key for the treatment table.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#vitalperiodicid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Unique primary key identifier for each periodic vital sign measurement record.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/vitalperiodicid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:label xml:lang="en">Vital Periodic Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasystolic">
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/pasystolic"/>
    <rdfs:comment xml:lang="en">Pulmonary artery systolic pressure measured in millimeters of mercury (mmHg). Represents the peak pressure in the pulmonary artery during right ventricular contraction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Pulmonary Artery Systolic Pressure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ph">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/ph"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:comment xml:lang="en">Arterial blood pH value (dimensionless), representing the worst value in the first 24 hours of ICU admission for APACHE scoring. Normal range is approximately 7.35-7.45.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Arterial pH</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pvr">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/pvr"/>
    <rdfs:comment xml:lang="en">Pulmonary Vascular Resistance (PVR), a measure of the resistance to blood flow in the pulmonary vasculature, measured in dynes·sec/cm⁵.</rdfs:comment>
    <rdfs:label xml:lang="en">Pulmonary Vascular Resistance</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#gtc">
    <rdfs:label xml:lang="en">GTC (Generic Therapeutic Class)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/gtc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The Generic Therapeutic Class code, an integer representing the therapeutic classification category of the drug. This is a categorical/coded value used for grouping medications by their therapeutic purpose, not a true numeric quantity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nurseassessid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/nurseassessid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Unique primary key identifier for each nurse assessment record.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:label xml:lang="en">Nurse Assessment ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#saps3today">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Simplified Acute Physiology Score 3 (SAPS 3) calculated for the current day of ICU stay.</rdfs:comment>
    <rdfs:label xml:lang="en">SAPS 3 Today Score</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/saps3today"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Microlab">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Microbiology Laboratory Result</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a microbiology laboratory culture result, including the culture site, identified organism, antibiotic tested, and the sensitivity level of the organism to the antibiotic. This is used to guide antimicrobial therapy and detect multidrug-resistant organisms (e.g., MRSA, ESBL, VRE, KPC, NDM-1, MRGN).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:volumeoffluid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/volumeoffluid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Volume of Fluid</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:comment xml:lang="en">The total volume of the intravenous fluid in which the drug is dissolved, stored as a string to accommodate various unit formats (e.g., 'ml'). May be empty if not recorded.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bilirubin">
    <rdfs:label xml:lang="en">Serum Bilirubin</rdfs:label>
    <rdfs:comment xml:lang="en">Serum bilirubin concentration measured in milligrams per deciliter (mg/dL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring. Elevated values may indicate liver dysfunction.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/bilirubin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:physicalexamtext">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Free-text notes or additional narrative description associated with the physical examination finding. May be null if only a structured value was recorded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/physicalexamtext"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Physical Examination Text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#metastaticcancer">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/metastaticcancer"/>
    <rdfs:label xml:lang="en">Metastatic Cancer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of metastatic cancer as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugname">
    <rdfs:comment xml:lang="en">The name of the medication documented at admission. May include brand or generic names such as aspirin, statins, insulin, antihypertensives, NSAIDs, steroids, proton pump inhibitors, etc.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the drug to which the patient has an allergy, as identified in the medication database.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the prescribed or administered drug. May include brand names, generic names, or combination drug descriptions. Examples include anticoagulants (e.g., Clopidogrel), NSAIDs, statins, diuretics, antihypertensives, proton pump inhibitors, oral antidiabetics, insulin, bronchodilators, steroids, and antidepressants.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugname"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/drugname"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugname"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Drug Name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apachepredvar_age">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/age"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Patient age in years as an integer, used for APACHE prediction scoring. This is distinct from the patient table age which is stored as a string.</rdfs:comment>
    <rdfs:label xml:lang="en">APACHE Patient Age</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nursecareid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/nursecareid"/>
    <rdfs:label xml:lang="en">Nurse Care Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Unique integer identifier serving as the primary key for each nurse care documentation entry.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#st2">
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:comment xml:lang="en">ST segment deviation measured in millivolts (mV) from ECG lead 2. ST segment changes may indicate myocardial ischemia or infarction.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">ST Segment Lead 2</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/st2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admissionweight">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/admissionweight"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">Admission Weight</rdfs:label>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of admission, measured in kilograms (kg).</rdfs:comment>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of unit admission, recorded in kilograms (kg) as a decimal value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTCELLTYPEVALNAME">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nursing Chart Cell Type Value Name</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTCELLTYPEVALNAME"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The system-level name for the type of value recorded in the nursing chart cell, used for programmatic identification of the observation type.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:physicalexamvalue">
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/physicalexamvalue"/>
    <rdfs:label xml:lang="en">Physical Examination Value</rdfs:label>
    <rdfs:comment xml:lang="en">The coded or structured value recorded for the physical examination finding (e.g., 'Normal', 'Abnormal', a numeric score). May be null if only free-text was entered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CPLGOALoffset">
    <rdfs:label xml:lang="en">Care Plan Goal Time Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the care plan goal was entered or recorded.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/CPLGOALoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:activeupondischarge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Active Upon Discharge</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/activeupondischarge"/>
    <rdfs:comment xml:lang="en">Indicates whether the infectious disease was still active at the time of the patient's discharge. Typically encoded as a boolean-like string value (e.g., 'True', 'False').</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Hospital">
    <rdfs:label xml:lang="en">Hospital</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/hospital"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a hospital facility within the eICU collaborative research database.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a hospital or healthcare facility where patients receive care. Identified by a unique hospital identifier and characterized by attributes such as bed capacity category, teaching status, and geographic region.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a hospital facility where surgical and medical care is provided. Each hospital is characterized by its bed capacity category, teaching status, and geographic region.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#creatinine">
    <rdfs:label xml:lang="en">Serum Creatinine</rdfs:label>
    <rdfs:label xml:lang="en">Creatinine</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Serum creatinine concentration measured in milligrams per deciliter (mg/dL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring. Elevated values indicate impaired renal function.</rdfs:comment>
    <rdfs:comment xml:lang="en">Serum creatinine level, measured in mg/dL. Used as a physiological variable in APACHE scoring to assess renal function.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/creatinine"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/creatinine"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ima">
    <rdfs:comment xml:lang="en">Indicates whether an internal mammary artery (IMA) graft was used in cardiac surgery. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Internal Mammary Artery Use</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/ima"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admissiondrugid">
    <rdfs:label xml:lang="en">Admission Drug ID</rdfs:label>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each admission drug record.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/admissiondrugid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CUFFPRESSURE">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/CUFFPRESSURE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Pressure of the airway cuff, measured in cmH2O. Used to ensure adequate seal without causing tracheal injury.</rdfs:comment>
    <rdfs:label xml:lang="en">Cuff Pressure</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#temperature">
    <rdfs:comment xml:lang="en">Body temperature measured in degrees Celsius, representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient's body temperature measured in degrees Celsius at the time of observation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/temperature"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/temperature"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Temperature</rdfs:label>
    <rdfs:label xml:lang="en">Body Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugorderoffset">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Drug Order Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugorderoffset"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to when the drug was ordered. A negative value indicates the order was placed before unit admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dialysis">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Dialysis</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient was receiving dialysis (renal replacement therapy) at the time of APACHE scoring. Encoded as an integer: 0 = no dialysis, 1 = on dialysis.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/dialysis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Physicalexam">
    <rdfs:comment xml:lang="en">Represents a physical examination record performed on a patient during an ICU stay. Each instance captures a specific finding or observation from a structured physical exam, including the exam path (body system and finding category), the value, and any free-text notes. Corresponds to the OGMS concept of physical examination.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: OGMS:OGMS_0000057</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam"/>
    <rdfs:label xml:lang="en">Physical Examination</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitalid">
    <rdfs:comment xml:lang="en">A unique integer identifier for the hospital. Serves as the primary key for the Hospital class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique integer identifier assigned to each hospital. Serves as the primary key for the hospital record.</rdfs:comment>
    <rdfs:label xml:lang="en">Hospital ID</rdfs:label>
    <rdfs:label xml:lang="en">Hospital Identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Hospital"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/hospital/hospitalid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ACTIVEUPONDISCHARGE">
    <rdfs:label xml:lang="en">Active Upon Discharge</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/ACTIVEUPONDISCHARGE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Indicates whether the care plan goal was still active at the time of the patient's discharge from the unit. Stored as a string in the source database with typical values 'True' or 'False'. Semantically represents a boolean flag.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#saps3yesterday">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">SAPS 3 Yesterday Score</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/saps3yesterday"/>
    <rdfs:comment xml:lang="en">Simplified Acute Physiology Score 3 (SAPS 3) calculated for the previous day of ICU stay.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icd9code">
    <rdfs:comment xml:lang="en">The International Classification of Diseases, 9th Revision (ICD-9) code associated with the diagnosis. ICD-9 codes are standardized alphanumeric codes used worldwide to classify medical conditions. The primary diagnosis (ICD 1) drives the main course of treatment, while secondary codes (ICD 2-30) capture comorbidities and complications that affect treatment decisions and outcomes.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/icd9code"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">ICD-9 Code</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:microlabid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/microlabid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Microbiology Lab Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Unique primary key identifier for each microbiology laboratory record.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdiagnosis">
    <rdfs:label xml:lang="en">Admission Diagnosis Code</rdfs:label>
    <rdfs:comment xml:lang="en">APACHE admission diagnosis code as a string identifier, representing the primary diagnosis at ICU admission.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/admitdiagnosis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#physicianspeciality">
    <rdfs:label xml:lang="en">Physician Speciality</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The medical speciality of the attending physician responsible for the patient during the ICU stay.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/physicianspeciality"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unabridgedunitlos">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/unabridgedunitlos"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) ICU unit length of stay in days, without any truncation applied by the APACHE model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Unabridged Unit Length of Stay</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bun">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/bun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Blood urea nitrogen concentration measured in milligrams per deciliter (mg/dL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring. Elevated values may indicate renal dysfunction.</rdfs:comment>
    <rdfs:label xml:lang="en">Blood Urea Nitrogen (BUN)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apachepredvarid">
    <rdfs:comment xml:lang="en">Primary key identifier for the APACHE prediction variable record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/apachepredvarid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">APACHE Prediction Variable ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:drugamount">
    <rdfs:comment xml:lang="en">The total amount of drug in the infusion solution, stored as a string to accommodate various unit formats (e.g., 'mg', 'mcg'). May be empty if not recorded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/drugamount"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Drug Amount</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labmeasurenamesystem">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The system-level name for the laboratory measurement, representing the standardized naming convention used within the hospital system.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labmeasurenamesystem"/>
    <rdfs:label xml:lang="en">Lab Measure Name System</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:responsetotherapy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/responsetotherapy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Response to Therapy</rdfs:label>
    <rdfs:comment xml:lang="en">Documents the patient's clinical response to the infectious disease treatment, e.g., 'Improving', 'No Change', 'Worsening'. Used to track therapeutic effectiveness.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CELLATTRIBUTEVALUE">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdfs:comment xml:lang="en">The recorded value for the assessed clinical attribute. This may contain free text, numeric values, or coded categorical responses depending on the attribute type. Maximum length is 4000 characters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The recorded value for the nursing care cell attribute. This is a free-text field (up to 4000 characters) that may contain numeric values, categorical selections, or descriptive text depending on the attribute type.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/CELLATTRIBUTEVALUE"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/CELLATTRIBUTEVALUE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Cell Attribute Value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#predictedicumortality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/predictedicumortality"/>
    <rdfs:label xml:lang="en">Predicted ICU Mortality</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The predicted probability of ICU mortality based on the APACHE model, stored as a string representation (e.g., a decimal probability or categorical value).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#prn">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/prn"/>
    <rdfs:label xml:lang="en">PRN (As Needed)</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the medication is prescribed on a PRN (pro re nata, i.e., as needed) basis. Typically contains a yes/no or similar categorical string value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#activetx">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/activetx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Active Treatment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient is receiving active treatment. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#eyes">
    <rdfs:label xml:lang="en">GCS Eye Opening Response</rdfs:label>
    <rdfs:label xml:lang="en">GCS Eye Opening Score</rdfs:label>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale (GCS) eye opening response component used in APACHE scoring. Ordinal integer values: 1 = no eye opening, 2 = eye opening to pain, 3 = eye opening to verbal command, 4 = eyes open spontaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale eye opening component score. Ordinal integer ranging from 1 (no eye opening) to 4 (spontaneous). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/eyes"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/eyes"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAIPPEEPHIGH">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Configured inspiratory pressure or high PEEP setting for apnea backup ventilation, measured in cmH2O.</rdfs:comment>
    <rdfs:label xml:lang="en">Set Apnea IP/PEEP High</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAIPPEEPHIGH"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaldischargeoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:label xml:lang="en">Hospital Discharge Offset</rdfs:label>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to the hospital discharge time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes between the hospital discharge time and the unit admission time (which serves as the reference time point, offset = 0). Positive values indicate the hospital discharge occurred after the unit admission.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaldischargeoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unittype">
    <rdfs:label xml:lang="en">Unit Type</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unittype"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The type of ICU or care unit where the patient was admitted (e.g., MICU, SICU, CCU, CTICU).</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of ICU or hospital unit where the patient stayed (e.g., 'MICU' for Medical ICU, 'SICU' for Surgical ICU, 'CCU-CTICU' for Cardiac Care/Cardiothoracic ICU, 'CTICU', 'Med-Surg ICU', 'Neuro ICU').</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#st1">
    <rdfs:comment xml:lang="en">ST segment deviation measured in millivolts (mV) from ECG lead 1. ST segment changes may indicate myocardial ischemia or infarction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">ST Segment Lead 1</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/st1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTOFFSET">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTOFFSET"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the respiratory charting value was recorded. A positive value indicates time after admission; a negative value indicates time before admission.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Respiratory Chart Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaladmitsource">
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The source from which the patient was admitted to the hospital (e.g., Emergency Department, Operating Room, Transfer).</rdfs:comment>
    <rdfs:comment xml:lang="en">The source or location from which the patient was admitted to the hospital (e.g., 'Emergency Department', 'Operating Room', 'Floor', 'Direct Admit', 'Other Hospital', 'Recovery Room').</rdfs:comment>
    <rdfs:label xml:lang="en">Hospital Admit Source</rdfs:label>
    <rdfs:label xml:lang="en">Hospital Admission Source</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaladmitsource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitvisitnumber">
    <rdfs:comment xml:lang="en">The sequential visit number for the patient within the same hospital stay, indicating the order of ICU admissions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An integer indicating the sequential number of this unit stay within the same health system stay. A value of 1 indicates the first unit admission; higher values indicate subsequent readmissions to a unit during the same hospital encounter.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitvisitnumber"/>
    <rdfs:label xml:lang="en">Unit Visit Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#predventdays">
    <rdfs:label xml:lang="en">Predicted Ventilation Days</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The predicted number of mechanical ventilation days as estimated by the APACHE model.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/predventdays"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cardiacoutput">
    <rdfs:comment xml:lang="en">The volume of blood pumped by the heart per minute, measured in liters per minute (L/min).</rdfs:comment>
    <rdfs:label xml:lang="en">Cardiac Output</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/cardiacoutput"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Infusiondrug">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug"/>
    <rdfs:label xml:lang="en">Infusion Drug Administration</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a record of a continuous intravenous drug infusion administered to a patient during an ICU stay. Each record captures the drug name, infusion rate, drug rate, drug amount, fluid volume, and patient weight at the time of infusion.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#wbc">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:comment xml:lang="en">White blood cell (WBC) count measured in thousands per microliter (x10^3/uL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">White Blood Cell Count</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/wbc"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosisid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/diagnosisid"/>
    <rdfs:label xml:lang="en">Diagnosis ID</rdfs:label>
    <rdfs:comment xml:lang="en">Unique integer identifier serving as the primary key for each diagnosis record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Patient">
    <rdfs:comment xml:lang="en">Represents a patient unit stay record, capturing demographic information, hospital and unit admission/discharge details, and clinical attributes for a single ICU visit.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient during a specific unit stay in a hospital. Already defined in the core ontology.</rdfs:comment>
    <rdfs:comment xml:lang="en">A patient admitted to a hospital unit stay. Already defined in the core ontology.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient during a specific unit stay in the hospital. Each instance corresponds to a unique patient-unit-stay episode, identified by patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record in the eICU database. Each instance corresponds to a unique ICU or hospital unit stay for a patient, identified by patientunitstayid. A single patient (identified by uniquepid) may have multiple unit stays.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#systemicmean">
    <rdfs:label xml:lang="en">Systemic Mean Arterial Pressure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/systemicmean"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Systemic mean arterial pressure (MAP) measured in millimeters of mercury (mmHg). Represents the average arterial pressure throughout one cardiac cycle, commonly calculated as diastolic + 1/3(systolic - diastolic).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intakeoutputentryoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:label xml:lang="en">Intake Output Entry Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/intakeoutputentryoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when this specific intake/output entry was recorded. This may differ from intakeoutputoffset if the entry was documented at a different time than the measurement period.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Medication">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a medication order or prescription for a patient during their unit stay. Captures drug details including name, dosage, route of administration, frequency, and timing offsets relative to the unit admission.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Medication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intakeoutputid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Intake Output Identifier</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/intakeoutputid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:comment xml:lang="en">Unique primary key identifier for each intake/output record entry. This is a surrogate key used to uniquely identify each row in the intakeoutput table.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTENTRYOFFSET">
    <rdfs:label xml:lang="en">Respiratory Chart Entry Offset</rdfs:label>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the respiratory charting entry was entered into the system. This may differ from RESPCHARTOFFSET if documentation was delayed.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTENTRYOFFSET"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#treatmentstring">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/treatment/treatmentstring"/>
    <rdfs:comment xml:lang="en">A hierarchical string describing the treatment administered to the patient, typically structured as a path representing the treatment category and specific intervention.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Treatment Description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Treatment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pamean">
    <rdfs:comment xml:lang="en">Mean pulmonary artery pressure measured in millimeters of mercury (mmHg). Represents the average pressure in the pulmonary artery throughout one cardiac cycle.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Pulmonary Artery Mean Pressure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/pamean"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#outputtotal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/outputtotal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The cumulative total fluid output volume for the patient at the time of this record, measured in milliliters (mL). Includes urine output, drainage, and other fluid losses.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:label xml:lang="en">Output Total</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#graftcount">
    <rdfs:label xml:lang="en">Graft Count</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/graftcount"/>
    <rdfs:comment xml:lang="en">Number of grafts performed, relevant for cardiac surgery patients in APACHE prediction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugadmitfrequency">
    <rdfs:label xml:lang="en">Drug Admit Frequency</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugadmitfrequency"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The frequency at which the drug is administered at the time of admission (e.g., once daily, twice daily, PRN).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#systemicdiastolic">
    <rdfs:comment xml:lang="en">Systemic diastolic arterial blood pressure measured in millimeters of mercury (mmHg). Represents the minimum pressure in the arteries during cardiac relaxation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:label xml:lang="en">Systemic Diastolic Blood Pressure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/systemicdiastolic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HIEXHMVLIMIT">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">High Exhaled Minute Volume Limit</rdfs:label>
    <rdfs:comment xml:lang="en">Upper alarm limit for exhaled minute volume, measured in liters per minute (L/min).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/HIEXHMVLIMIT"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actualiculos">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/actualiculos"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The actual ICU length of stay in days for the patient.</rdfs:comment>
    <rdfs:label xml:lang="en">Actual ICU Length of Stay</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#VENTENDOFFSET">
    <rdfs:label xml:lang="en">Ventilation End Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/VENTENDOFFSET"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to the end of the current mechanical ventilation episode.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#bedcount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Encoded category representing the number of beds in the hospital. Categorical integer value representing bed count ranges.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/bedcount"/>
    <rdfs:label xml:lang="en">Hospital Bed Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugenteredoffset">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugenteredoffset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to when the drug entry was recorded in the system.</rdfs:comment>
    <rdfs:label xml:lang="en">Drug Entered Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actualventdays">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Actual Ventilation Days</rdfs:label>
    <rdfs:comment xml:lang="en">The actual number of days the patient was on mechanical ventilation during the ICU stay.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/actualventdays"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#routeadmin">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The route by which the medication is administered to the patient (e.g., oral, intravenous, subcutaneous, inhaled, topical).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/routeadmin"/>
    <rdfs:label xml:lang="en">Route of Administration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEOFFSET">
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <rdfs:label xml:lang="en">Note Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTEOFFSET"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the note event occurred. A positive value indicates minutes after unit admission; a negative value indicates minutes before.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CPLGOALSTATUS">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/CPLGOALSTATUS"/>
    <rdfs:comment xml:lang="en">The current status of the care plan goal, indicating whether it is active, completed, or otherwise categorized.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdfs:label xml:lang="en">Care Plan Goal Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugordercancelled">
    <rdfs:label xml:lang="en">Drug Order Cancelled</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdfs:comment xml:lang="en">Indicates whether the drug order was cancelled. Typically contains a yes/no or similar categorical string value.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugordercancelled"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#AIRWAYPOSITION">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Position or depth of the artificial airway, typically measured in centimeters at the lip or teeth.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/AIRWAYPOSITION"/>
    <rdfs:label xml:lang="en">Airway Position</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pvri">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/pvri"/>
    <rdfs:label xml:lang="en">Pulmonary Vascular Resistance Index</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdfs:comment xml:lang="en">Pulmonary Vascular Resistance Index (PVRI), the PVR normalized to body surface area, measured in dynes·sec/cm⁵/m².</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CPLGOALVALUE">
    <rdfs:label xml:lang="en">Care Plan Goal Value</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdfs:comment xml:lang="en">The specific value or description of the care plan goal, detailing the target or desired outcome for the patient.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/CPLGOALVALUE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Careplaneol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Care Plan End of Life</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaneol"/>
    <rdfs:comment xml:lang="en">Represents an end-of-life care plan record for a patient during an ICU stay. This documents discussions and decisions regarding end-of-life care, including whether the care plan was active upon discharge.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: cpleolid exactly 1 xsd:integer</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labotheroffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's ICU admission to when the custom laboratory test was performed or resulted. A negative value indicates the test occurred before ICU admission.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/labotheroffset"/>
    <rdfs:label xml:lang="en">Lab Other Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#specialtytype">
    <rdfs:comment xml:lang="en">The medical specialty of the provider who documented the drug (e.g., surgery, internal medicine).</rdfs:comment>
    <rdfs:comment xml:lang="en">The medical specialty of the care provider who documented the allergy.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/specialtytype"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/specialtytype"/>
    <rdfs:label xml:lang="en">Specialty Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diedinhospital">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">Died in Hospital</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient died during the hospital stay. Encoded as integer: 0 = survived, 1 = died in hospital.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/diedinhospital"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labresult">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The numeric value of the laboratory test result. Units depend on the specific lab test identified by labname.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">Lab Result Numeric Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistoryvalue">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistoryvalue"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Past History Value</rdfs:label>
    <rdfs:comment xml:lang="en">The coded or short-form value of the past history entry, representing the specific condition or finding. Maximum 100 characters.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labname">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labname"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <rdfs:comment xml:lang="en">The name of the laboratory test performed, e.g., sodium (Natrium), hemoglobin (Hämoglobin), CRP (C-Reactive Protein), PCT (Procalcitonin), albumin, creatinine (Kreatinin), GFR, TSH, HbA1c, ASAT, ALAT, bilirubin, lipase, INR, leukocytes (Leukozyten), urea (Harnstoff), etc.</rdfs:comment>
    <rdfs:label xml:lang="en">Lab Test Name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:culturetakenoffset">
    <rdfs:label xml:lang="en">Culture Taken Time Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/culturetakenoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when the microbiology culture specimen was collected.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#glucose">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/glucose"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Serum Glucose</rdfs:label>
    <rdfs:comment xml:lang="en">Serum glucose concentration measured in milligrams per deciliter (mg/dL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAIE">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Set Apnea I:E Ratio</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAIE"/>
    <rdfs:comment xml:lang="en">Configured inspiratory-to-expiratory (I:E) ratio for apnea backup ventilation, e.g., '1:2'.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PEEPLIMIT">
    <rdfs:comment xml:lang="en">Alarm limit for Positive End-Expiratory Pressure (PEEP), measured in cmH2O. PEEP maintains alveolar recruitment at end-expiration.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/PEEPLIMIT"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">PEEP Limit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:patientweight">
    <rdfs:comment xml:lang="en">The patient's weight at the time of the infusion drug administration, stored as a string to accommodate various formats and units (typically in kg). May be empty if not recorded.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/patientweight"/>
    <rdfs:label xml:lang="en">Patient Weight</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:drugrate">
    <rdfs:comment xml:lang="en">The rate at which the drug is being administered, stored as a string to accommodate various unit formats (e.g., 'mcg/kg/min', 'mg/hr'). May be empty if not recorded.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/drugrate"/>
    <rdfs:label xml:lang="en">Drug Rate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cellvaluenumeric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/cellvaluenumeric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The numeric value recorded for this intake/output entry, typically representing a volume in milliliters (mL). May be null if the entry is text-based rather than numeric.</rdfs:comment>
    <rdfs:label xml:lang="en">Cell Value Numeric</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistoryid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for each past history record. Serves as the primary key (HasKey) of the Pasthistory class.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistoryid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Past History ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Admissiondx">
    <rdfs:label xml:lang="en">Admission Diagnosis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents a diagnosis recorded at the time of a patient's admission to an ICU or hospital unit. Each instance captures the diagnosis name, path in a hierarchical classification, and free-text description along with the time offset from unit admission when the diagnosis was entered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#st3">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/st3"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">ST segment deviation measured in millivolts (mV) from ECG lead 3. ST segment changes may indicate myocardial ischemia or infarction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:label xml:lang="en">ST Segment Lead 3</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apacheapsvarid">
    <rdfs:label xml:lang="en">APACHE APS Variable ID</rdfs:label>
    <rdfs:comment xml:lang="en">Unique primary key identifier for each APACHE APS variable record.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/apacheapsvarid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unabridgedactualventdays">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Unabridged Actual Ventilation Days</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) actual number of mechanical ventilation days, without any truncation applied by the APACHE model.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/unabridgedactualventdays"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Treatment">
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a clinical treatment administered to a patient during their unit stay. Each instance captures the treatment description, timing offset from unit admission, and whether the treatment was active upon discharge.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/treatment"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#vitalaperiodicid">
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Vital Aperiodic ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Primary key identifier for each aperiodic vital sign measurement record. Unique and not null.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/vitalaperiodicid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#specialty">
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:label xml:lang="en">Specialty</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The medical specialty of the care provider, e.g., cardiology, pulmonology, surgery.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/specialty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Admissiondrug">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug"/>
    <rdfs:label xml:lang="en">Admission Drug</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a medication documented at the time of a patient's admission to the ICU. Records drug name, dosage, unit, frequency, and metadata about how the drug order was entered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#aids">
    <rdfs:label xml:lang="en">AIDS Comorbidity</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of AIDS (Acquired Immunodeficiency Syndrome) as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/aids"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Allergy">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">External alignment: allergyid exactly 1 xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an allergy record for a patient during an ICU stay, documenting drug allergies and other allergic reactions including the allergen name, type, and associated drug information.</rdfs:comment>
    <rdfs:label xml:lang="en">Allergy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#usertype">
    <rdfs:comment xml:lang="en">The type or role of the user who entered the drug record (e.g., nurse, physician, pharmacist).</rdfs:comment>
    <rdfs:comment xml:lang="en">The type or role of the user (e.g., nurse, physician) who entered the allergy record.</rdfs:comment>
    <rdfs:label xml:lang="en">User Type</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/usertype"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/usertype"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drughiclseqno">
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drughiclseqno"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/drughiclseqno"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drughiclseqno"/>
    <rdfs:comment xml:lang="en">The Hierarchical Ingredient Code List (HICL) sequence number that uniquely identifies the drug ingredient. This is a coded identifier from the First Databank drug database used for drug classification and interaction checking.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Hierarchical Ingredient Code List (HICL) sequence number identifying the drug ingredient associated with the allergy. This is a coded integer identifier from the First Databank drug database used for drug-allergy cross-referencing.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Hierarchical Ingredient Code List (HICL) sequence number for the drug. This is a standardized numeric code used to identify the active ingredient(s) of the medication. It is a coded identifier, not a true numeric quantity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Drug HICL Sequence Number</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:organism">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/organism"/>
    <rdfs:comment xml:lang="en">The name of the microorganism identified from the culture. This may include multidrug-resistant organisms such as MRSA (Methicillin-resistant Staphylococcus aureus), ESBL-producing bacteria, VRE (Vancomycin-resistant enterococci), KPC (Klebsiella pneumoniae carbapenemase), NDM-1 (New Delhi metallo-beta-lactamase 1), or MRGN (Multidrug-resistant Gram-negative bacteria).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Organism</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplitemvalue">
    <rdfs:comment xml:lang="en">The specific value or description of the care plan item within its group, representing the clinical detail of the planned or active care intervention.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral/cplitemvalue"/>
    <rdfs:label xml:lang="en">Care Plan Item Value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:culturesite">
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdfs:label xml:lang="en">Culture Site</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The anatomical site or specimen source from which the microbiology culture was obtained (e.g., blood, urine, wound, sputum). This corresponds to the location where a swab or sample was taken for microbiological analysis.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/culturesite"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#wardid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/wardid"/>
    <rdfs:label xml:lang="en">Ward ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">Identifier for the ward or unit within the hospital where the patient was located.</rdfs:comment>
    <rdfs:comment xml:lang="en">An integer identifier for the specific ward or physical location within the hospital where the patient's unit stay took place.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitdischargeoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to the unit discharge time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes between the unit discharge time and the unit admission time (which serves as the reference time point, offset = 0). Always a positive value representing the length of the unit stay in minutes.</rdfs:comment>
    <rdfs:label xml:lang="en">Unit Discharge Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitdischargeoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaldischargelocation">
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaldischargelocation"/>
    <rdfs:comment xml:lang="en">The location or facility to which the patient was discharged from the hospital (e.g., Home, Skilled Nursing Facility, Rehabilitation).</rdfs:comment>
    <rdfs:comment xml:lang="en">The location or destination to which the patient was discharged from the hospital (e.g., 'Home', 'Skilled Nursing Facility', 'Rehabilitation', 'Other Hospital', 'Death', 'Other').</rdfs:comment>
    <rdfs:label xml:lang="en">Hospital Discharge Location</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#oobventday1">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">Out-of-Bed Ventilation Day 1</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/oobventday1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient had out-of-bed ventilation on day 1 of ICU stay. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#padiastolic">
    <rdfs:label xml:lang="en">Pulmonary Artery Diastolic Pressure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/padiastolic"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:comment xml:lang="en">Pulmonary artery diastolic pressure measured in millimeters of mercury (mmHg). Represents the minimum pressure in the pulmonary artery during right ventricular relaxation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#APNEAPARAMS">
    <rdfs:comment xml:lang="en">Free-text description of apnea ventilation parameters configured on the ventilator for backup ventilation in case of patient apnea.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">Apnea Parameters</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/APNEAPARAMS"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Nursecharting">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a single nurse charting observation recorded during a patient's unit stay in the ICU or intermediate care setting. Each entry captures a specific clinical measurement, assessment, or observation made by nursing staff.</rdfs:comment>
    <rdfs:label xml:lang="en">Nurse Charting Entry</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCARESTATUSOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to the respiratory care status event.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/RESPCARESTATUSOFFSET"/>
    <rdfs:label xml:lang="en">Respiratory Care Status Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actualicumortality">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Actual ICU Mortality</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/actualicumortality"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The actual ICU mortality outcome for the patient. Encoded as a string, typically 'ALIVE' or 'EXPIRED'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Nurseassessment">
    <rdfs:comment xml:lang="en">A clinical assessment performed by a nurse during a patient's unit stay. Each record captures a single cell attribute value from a structured nursing assessment form, identified by its path, label, attribute name, and value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology#hasPatient exactly 1 Patient"/>
    <rdfs:label xml:lang="en">Nurse Assessment</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:physicalexamoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Physical Examination Time Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/physicalexamoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to when the physical examination was recorded. A negative value indicates the exam occurred before ICU admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugstartoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to when the drug administration was started. A negative value indicates the drug was started before unit admission.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Drug Start Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugstartoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HIGHIRONOXLIMIT">
    <rdfs:label xml:lang="en">High Inspired Oxygen Limit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Upper alarm limit for inspired oxygen concentration (FiO2), measured as a percentage or fraction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/HIGHIRONOXLIMIT"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intubated">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/intubated"/>
    <rdfs:label xml:lang="en">Intubated</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient was intubated at the time of APACHE scoring. Encoded as an integer: 0 = not intubated, 1 = intubated.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#AIRWAYTYPE">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/AIRWAYTYPE"/>
    <rdfs:label xml:lang="en">Airway Type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of artificial airway in use, e.g., oral endotracheal tube, nasal endotracheal tube, or tracheostomy.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEPATH">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <rdfs:comment xml:lang="en">The hierarchical path or classification within the clinical documentation system that categorizes the note. Represents the navigation path used to locate or organize the note entry.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTEPATH"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Note Path</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#meds">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/meds"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/meds"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient was receiving sedation or paralytic medications that could affect the GCS assessment at the time of APACHE scoring. Encoded as an integer: 0 = no sedation/paralytic medications, 1 = receiving sedation/paralytic medications.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the patient was on sedative or paralytic medications affecting the Glasgow Coma Scale (GCS) assessment. Encoded as integer: 0 = no sedation/paralysis, 1 = sedated/paralyzed.</rdfs:comment>
    <rdfs:label xml:lang="en">Sedation or Paralytic Medications</rdfs:label>
    <rdfs:label xml:lang="en">GCS Medications Flag</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitadmitsource">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The source from which the patient was admitted to the ICU unit (e.g., Emergency Department, Floor, Operating Room, Direct Admit).</rdfs:comment>
    <rdfs:comment xml:lang="en">The source or location from which the patient was admitted to the ICU or hospital unit (e.g., 'Emergency Department', 'Operating Room', 'Floor', 'Other ICU', 'Direct Admit', 'Other Hospital', 'Recovery Room', 'Step-Down Unit (SDU)').</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitadmitsource"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:label xml:lang="en">Unit Admit Source</rdfs:label>
    <rdfs:label xml:lang="en">Unit Admission Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugnotetype">
    <rdfs:label xml:lang="en">Drug Note Type</rdfs:label>
    <rdfs:comment xml:lang="en">The type of clinical note associated with the drug record (e.g., admission, update).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugnotetype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sodium">
    <rdfs:comment xml:lang="en">Serum sodium concentration measured in milliequivalents per liter (mEq/L), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/sodium"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Serum Sodium</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medicationid">
    <rdfs:comment xml:lang="en">Unique identifier for the medication order record. Serves as the primary key of the medication table.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/medicationid"/>
    <rdfs:label xml:lang="en">Medication ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#LOWEXHMVLIMIT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">Low Exhaled Minute Volume Limit</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/LOWEXHMVLIMIT"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Lower alarm limit for exhaled minute volume, measured in liters per minute (L/min).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitsource">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Admission Source Code</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Encoded source of patient admission for APACHE scoring. Categorical integer representing where the patient was admitted from (e.g., emergency department, operating room, floor, other hospital).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/admitsource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#respiratoryrate">
    <rdfs:comment xml:lang="en">Respiratory rate measured in breaths per minute, representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Respiratory Rate</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/respiratoryrate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CURRENTHISTORYSEQNUM">
    <rdfs:comment xml:lang="en">Sequence number indicating the order of respiratory care history entries for the current episode.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Current History Sequence Number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/CURRENTHISTORYSEQNUM"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Careplaninfectiousdisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Care Plan Infectious Disease</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease"/>
    <rdfs:comment xml:lang="en">Represents an infectious disease entry within a patient's care plan during an ICU or hospital stay. Records the site of infection, clinical assessment, response to therapy, treatment details, and whether the infection was active upon discharge.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergyid">
    <rdfs:comment xml:lang="en">Unique primary key identifier for each allergy record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergyid"/>
    <rdfs:label xml:lang="en">Allergy Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dialysistotal">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/dialysistotal"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:comment xml:lang="en">The cumulative total fluid volume removed or added through dialysis, measured in milliliters (mL). Relevant for patients undergoing renal replacement therapy such as hemodialysis or continuous renal replacement therapy (CRRT).</rdfs:comment>
    <rdfs:label xml:lang="en">Dialysis Total</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEENTEREDOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the note was entered into the system. This may differ from NOTEOFFSET if the note was documented retrospectively.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTEENTEREDOFFSET"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Note Entered Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:infectdiseasesite">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/infectdiseasesite"/>
    <rdfs:comment xml:lang="en">The anatomical site or body system affected by the infectious disease, e.g., 'Lung', 'Urinary Tract', 'Bloodstream', 'Wound'. Corresponds to clinical documentation of infection location.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Infectious Disease Site</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#svri">
    <rdfs:label xml:lang="en">Systemic Vascular Resistance Index</rdfs:label>
    <rdfs:comment xml:lang="en">Systemic Vascular Resistance Index (SVRI), the SVR normalized to body surface area, measured in dynes·sec/cm⁵/m².</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/svri"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labothertypeid">
    <rdfs:comment xml:lang="en">Integer identifier representing the type or category of the custom laboratory test. This is a categorical code referencing a specific lab test type definition. Values are encoded integers where each distinct value maps to a particular lab test category.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Lab Other Type ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/labothertypeid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitdischargelocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Unit Discharge Location</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The location to which the patient was discharged from the ICU unit (e.g., Floor, Step-Down Unit, Other Hospital).</rdfs:comment>
    <rdfs:comment xml:lang="en">The location or destination to which the patient was discharged from the ICU or hospital unit (e.g., 'Floor', 'Step-Down Unit (SDU)', 'Other ICU', 'Home', 'Death', 'Other Hospital', 'Telemetry').</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitdischargelocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergyname">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergyname"/>
    <rdfs:label xml:lang="en">Allergy Name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:comment xml:lang="en">The name of the allergen or substance causing the allergic reaction in the patient.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAINSPTIME">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAINSPTIME"/>
    <rdfs:label xml:lang="en">Set Apnea Inspiratory Time</rdfs:label>
    <rdfs:comment xml:lang="en">Configured inspiratory time for apnea backup ventilation. Stored as a string value representing time in seconds.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Careplangoal">
    <rdfs:comment xml:lang="en">External alignment: cplgoalid exactly 1 xsd:integer</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a goal defined within a patient's care plan during their unit stay. Each goal has a category, value, status, and an indication of whether it remains active upon discharge.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Care Plan Goal</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugoffset">
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to when the drug was noted or active.</rdfs:comment>
    <rdfs:label xml:lang="en">Drug Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugoffset"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1fio2">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1fio2"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Fraction of inspired oxygen (FiO2) on day 1 of ICU admission, expressed as a decimal (e.g., 0.21 to 1.0).</rdfs:comment>
    <rdfs:label xml:lang="en">Day 1 FiO2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplcareprovderid">
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Care Plan Care Provider Identifier</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/cplcareprovderid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for each care plan care provider record. Serves as the primary key.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEATV">
    <rdfs:label xml:lang="en">Set Apnea Tidal Volume</rdfs:label>
    <rdfs:comment xml:lang="en">Configured tidal volume for apnea backup ventilation, typically in milliliters (mL).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEATV"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAINTERVAL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Set Apnea Interval</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:comment xml:lang="en">Configured apnea interval setting on the ventilator, representing the time in seconds before apnea backup ventilation is triggered.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAINTERVAL"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#intaketotal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/intaketotal"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <rdfs:label xml:lang="en">Intake Total</rdfs:label>
    <rdfs:comment xml:lang="en">The cumulative total fluid intake volume for the patient at the time of this record, measured in milliliters (mL). Includes all oral, intravenous, and enteral fluid inputs.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#noninvasivesystolic">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">The systolic blood pressure measured non-invasively (e.g., via cuff), recorded in mmHg.</rdfs:comment>
    <rdfs:label xml:lang="en">Non-Invasive Systolic Blood Pressure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/noninvasivesystolic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#providertype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/providertype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The type or role of the care provider, e.g., attending physician, consulting physician, nurse practitioner.</rdfs:comment>
    <rdfs:label xml:lang="en">Provider Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Intakeoutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Intake and Output Record</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput"/>
    <rdfs:comment xml:lang="en">Represents a clinical intake and output record for a patient during their ICU stay. Tracks fluid intake, output, dialysis totals, and net fluid balance, which are critical for monitoring hydration status, renal function, and overall fluid management in critically ill patients.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#PRIORVENTENDOFFSET">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/PRIORVENTENDOFFSET"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Prior Ventilation End Offset</rdfs:label>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to the end of a prior mechanical ventilation episode.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#meanbp">
    <rdfs:label xml:lang="en">Mean Blood Pressure</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/meanbp"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Mean arterial blood pressure measured in millimeters of mercury (mmHg), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dosage">
    <rdfs:label xml:lang="en">Dosage</rdfs:label>
    <rdfs:comment xml:lang="en">The dosage of the medication as a string, typically including the numeric amount and unit (e.g., '500 mg', '10 mL'). Corresponds to the prescribed dose per administration.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/dosage"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#numbedscategory">
    <rdfs:comment xml:lang="en">A categorical string describing the size of the hospital based on the number of beds (e.g., '&lt;100', '100-249', '250-499', '&gt;=500'). Represents a binned classification of hospital capacity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A categorical classification of the hospital based on the number of beds it has. This represents a bed capacity category (e.g., small, medium, large) rather than an exact bed count.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Hospital"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/hospital/numbedscategory"/>
    <rdfs:label xml:lang="en">Number of Beds Category</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Respiratorycare">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a respiratory care episode for a patient in the ICU, including airway management details, ventilator settings, alarm limits, and apnea parameters. Each record is uniquely identified by RESPCAREID.</rdfs:comment>
    <rdfs:label xml:lang="en">Respiratory Care Record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#LOWRESPRATELIMIT">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/LOWRESPRATELIMIT"/>
    <rdfs:comment xml:lang="en">Lower alarm limit for respiratory rate, measured in breaths per minute.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">Low Respiratory Rate Limit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:infusiondrugid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/infusiondrugid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Infusion Drug Record Identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each infusion drug administration record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#thrombolytics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/thrombolytics"/>
    <rdfs:comment xml:lang="en">Indicates whether thrombolytic therapy was administered. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Thrombolytics Administered</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#midur">
    <rdfs:comment xml:lang="en">Duration in hours since myocardial infarction onset, used as a predictor variable in APACHE scoring for cardiac patients.</rdfs:comment>
    <rdfs:label xml:lang="en">Myocardial Infarction Duration</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/midur"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hematocrit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/hematocrit"/>
    <rdfs:comment xml:lang="en">Hematocrit value expressed as a percentage (%), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:label xml:lang="en">Hematocrit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#icp">
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/icp"/>
    <rdfs:label xml:lang="en">Intracranial Pressure (ICP)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Intracranial pressure measured in millimeters of mercury (mmHg). Reflects the pressure inside the skull and thus the pressure on the brain tissue and cerebrospinal fluid. Elevated ICP may indicate cerebral edema, hemorrhage, or other intracranial pathology.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pco2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Partial Pressure of Arterial Carbon Dioxide (PaCO2)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/pco2"/>
    <rdfs:comment xml:lang="en">Partial pressure of carbon dioxide in arterial blood measured in millimeters of mercury (mmHg), used in APACHE scoring to assess ventilation status.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergynotetype">
    <rdfs:label xml:lang="en">Allergy Note Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:comment xml:lang="en">The type of note associated with the allergy entry, indicating the clinical context in which the allergy was documented.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergynotetype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSEASSESSENTRYOFFSET">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:label xml:lang="en">Nurse Assessment Entry Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/NURSEASSESSENTRYOFFSET"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to the time the nurse assessment data was entered into the system.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAFIO2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Set Apnea FiO2</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAFIO2"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Configured fraction of inspired oxygen (FiO2) for apnea backup ventilation, expressed as a percentage or decimal fraction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:infusionrate">
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The volumetric rate of the intravenous infusion, stored as a string to accommodate various unit formats (e.g., 'ml/hr'). May be empty if not recorded.</rdfs:comment>
    <rdfs:label xml:lang="en">Infusion Rate</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/infusionrate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ejectfx">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Ejection Fraction</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/ejectfx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Cardiac ejection fraction as a percentage, representing the proportion of blood pumped out of the heart with each contraction. Used in APACHE prediction for cardiac patients.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1eyes">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1eyes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale eye opening component score on day 1 of ICU admission. Ordinal integer ranging from 1 (no eye opening) to 4 (spontaneous). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">Day 1 GCS Eye Opening Score</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#VENTSTARTOFFSET">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/VENTSTARTOFFSET"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Ventilation Start Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to the start of the current mechanical ventilation episode.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergytype">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergytype"/>
    <rdfs:label xml:lang="en">Allergy Type</rdfs:label>
    <rdfs:comment xml:lang="en">The category or type of allergy, such as 'Drug' or 'Non-Drug', indicating the nature of the allergic reaction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#electivesurgery">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/electivesurgery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Elective Surgery</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient underwent elective surgery prior to ICU admission. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#systemicsystolic">
    <rdfs:label xml:lang="en">Systemic Systolic Blood Pressure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/systemicsystolic"/>
    <rdfs:comment xml:lang="en">Systemic systolic arterial blood pressure measured in millimeters of mercury (mmHg). Represents the peak pressure in the arteries during cardiac contraction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#HIRESPRATELIMIT">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">High Respiratory Rate Limit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/HIRESPRATELIMIT"/>
    <rdfs:comment xml:lang="en">Upper alarm limit for respiratory rate, measured in breaths per minute.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEARR">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEARR"/>
    <rdfs:comment xml:lang="en">Configured respiratory rate for apnea backup ventilation, measured in breaths per minute.</rdfs:comment>
    <rdfs:label xml:lang="en">Set Apnea Respiratory Rate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasHospital">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitalid"/>
    <rdfs:comment xml:lang="en">Links a patient unit stay record to the hospital where the stay occurred. Resolves foreign key hospitalid referencing the hospital table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a patient unit stay record to the hospital where the stay occurred. Resolves the foreign key from patient.hospitalid to hospital.hospitalid.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#Hospital"/>
    <rdfs:label xml:lang="en">has hospital</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugunit">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The unit of measurement for the drug dosage (e.g., mg, mL, units, mcg).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugunit"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Drug Unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#celllabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/celllabel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The human-readable label for the specific intake or output item recorded (e.g., 'Normal Saline', 'Urine', 'Chest Tube'). This is the display name of the flowsheet cell.</rdfs:comment>
    <rdfs:label xml:lang="en">Cell Label</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unabridgedhosplos">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The unabridged (uncapped) hospital length of stay in days, without any truncation applied by the APACHE model.</rdfs:comment>
    <rdfs:label xml:lang="en">Unabridged Hospital Length of Stay</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/unabridgedhosplos"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SETAPNEAPEAKFLOW">
    <rdfs:label xml:lang="en">Set Apnea Peak Flow</rdfs:label>
    <rdfs:comment xml:lang="en">Configured peak inspiratory flow rate for apnea backup ventilation, typically in liters per minute (L/min).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/SETAPNEAPEAKFLOW"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Careplangeneral">
    <rdfs:comment xml:lang="en">Represents a general care plan entry for a patient during their unit stay. Contains care plan items grouped by category, with values and timing offsets relative to unit admission, and an indicator of whether the item was active upon discharge.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Care Plan General</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#vent">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Ventilated</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient was on mechanical ventilation at the time of APACHE scoring. Encoded as an integer: 0 = not ventilated, 1 = ventilated.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/vent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSECAREOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Nurse Care Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/NURSECAREOFFSET"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to the time the nurse care observation was recorded. A negative value indicates the observation occurred before unit admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#teachtype">
    <rdfs:label xml:lang="en">Teaching Hospital Type</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/teachtype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Encoded type of teaching hospital. Categorical integer value indicating the teaching status of the hospital (e.g., 0 = non-teaching, 1 = teaching, 2 = university).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#preopmi">
    <rdfs:comment xml:lang="en">Indicates whether the patient had a preoperative myocardial infarction. Encoded as an integer flag: 0 = no, 1 = yes. Represents a boolean categorical.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/preopmi"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Preoperative Myocardial Infarction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Apachepatientresult">
    <rdfs:comment xml:lang="en">Represents the results of an APACHE (Acute Physiology and Chronic Health Evaluation) severity-of-disease scoring for a patient ICU stay. Contains predicted and actual mortality rates, lengths of stay, ventilation days, and related clinical indicators.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/table/apachepatientresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">APACHE Patient Result</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTVALUE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdfs:label xml:lang="en">Nursing Chart Value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The actual recorded value of the nursing chart observation. Stored as a string to accommodate various data types including numeric measurements, categorical assessments, and free-text entries.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTVALUE"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cellvaluetext">
    <rdfs:label xml:lang="en">Cell Value Text</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/cellvaluetext"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The text value recorded for this intake/output entry. Used when the recorded value is descriptive rather than numeric, or as a string representation of the numeric value.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:Patient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a patient unit stay record in the eICU collaborative research database. Each instance corresponds to a unique ICU stay for a patient.</rdfs:comment>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dischargelocation">
    <rdfs:comment xml:lang="en">Encoded discharge location of the patient. Categorical integer representing where the patient was discharged to (e.g., home, skilled nursing facility, other hospital).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/dischargelocation"/>
    <rdfs:label xml:lang="en">Discharge Location Code</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitstaytype">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitstaytype"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Unit Stay Type</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The type of unit stay (e.g., admit, readmit, transfer).</rdfs:comment>
    <rdfs:comment xml:lang="en">The type of unit stay categorization (e.g., 'admit', 'readmit', 'transfer'). Indicates whether this is an initial admission, a readmission, or a transfer from another unit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apachescore">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The total APACHE (Acute Physiology and Chronic Health Evaluation) score, combining the acute physiology score, age points, and chronic health points. Higher scores indicate greater severity of illness.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/apachescore"/>
    <rdfs:label xml:lang="en">APACHE Score</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistorypath">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistorypath"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Past History Path</rdfs:label>
    <rdfs:comment xml:lang="en">Hierarchical path representing the structured classification of the past history item, typically following a taxonomy such as organ system or condition category. Maximum 255 characters.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actualhospitallos">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/actualhospitallos"/>
    <rdfs:comment xml:lang="en">The actual hospital length of stay in days for the patient.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Actual Hospital Length of Stay</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CELLATTRIBUTE">
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdfs:comment xml:lang="en">The specific clinical attribute or parameter being assessed within the nursing assessment cell (e.g., 'Sedation Scale', 'Pain Level').</rdfs:comment>
    <rdfs:comment xml:lang="en">The specific attribute name within the nursing care charting cell that was documented (e.g., 'Size', 'Reactivity', 'Score').</rdfs:comment>
    <rdfs:label xml:lang="en">Cell Attribute</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/CELLATTRIBUTE"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/CELLATTRIBUTE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Pasthistory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Represents a past medical history entry for a patient during a unit stay. Each record captures a specific historical clinical note, including the type, hierarchical path, and value of the past history item.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: pasthistoryid exactly 1 xsd:integer</rdfs:comment>
    <rdfs:label xml:lang="en">Past History Record</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdxtext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The free-text or display-text description of the admission diagnosis, which may include additional clinical detail beyond the standardized diagnosis name.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx/admitdxtext"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Admission Diagnosis Text</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apachepredvar_gender">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Encoded gender of the patient as used in APACHE prediction. Typically encoded as integer: 0 = Female, 1 = Male. This is distinct from the patient table gender which is stored as a string.</rdfs:comment>
    <rdfs:label xml:lang="en">APACHE Gender Code</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/gender"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#svr">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/svr"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Systemic Vascular Resistance</rdfs:label>
    <rdfs:comment xml:lang="en">Systemic Vascular Resistance (SVR), a measure of the resistance to blood flow in the systemic circulation, measured in dynes·sec/cm⁵.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cpleoldiscussionoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time when the end-of-life care plan discussion took place.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaneol/cpleoldiscussionoffset"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplaneol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Care Plan End of Life Discussion Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#preopcardiaccath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Preoperative Cardiac Catheterization</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the patient underwent preoperative cardiac catheterization. Encoded as an integer flag: 0 = no, 1 = yes. Represents a boolean categorical.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/preopcardiaccath"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CELLATTRIBUTEPATH">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdfs:label xml:lang="en">Cell Attribute Path</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/CELLATTRIBUTEPATH"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/CELLATTRIBUTEPATH"/>
    <rdfs:comment xml:lang="en">The hierarchical path within the nursing assessment form that identifies the location of the assessed attribute, representing the navigation structure of the assessment template.</rdfs:comment>
    <rdfs:comment xml:lang="en">The hierarchical path within the nursing care charting system that identifies the location of the attribute in the documentation structure (e.g., 'Neurological &gt; Pupil Response &gt; Left Eye').</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#noninvasivemean">
    <rdfs:label xml:lang="en">Non-Invasive Mean Arterial Pressure</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/noninvasivemean"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">The mean arterial pressure (MAP) measured non-invasively, recorded in mmHg.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistorynotetype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdfs:label xml:lang="en">Past History Note Type</rdfs:label>
    <rdfs:comment xml:lang="en">The type or category of the past history note, e.g., 'Admission' or other clinical note classifications. Maximum 40 characters.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistorynotetype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actualhospitalmortality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:comment xml:lang="en">The actual hospital mortality outcome for the patient. Encoded as a string, typically 'ALIVE' or 'EXPIRED'.</rdfs:comment>
    <rdfs:label xml:lang="en">Actual Hospital Mortality</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/actualhospitalmortality"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#writtenineicu">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/writtenineicu"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/writtenineicu"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Written in eICU</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the drug order was written while the patient was in the eICU. Expected values are 'True' or 'False'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the allergy record was written while the patient was in the eICU. Typical values are 'Yes' or 'No'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ptcawithin24h">
    <rdfs:comment xml:lang="en">Indicates whether percutaneous transluminal coronary angioplasty (PTCA) was performed within 24 hours of admission. Encoded as an integer flag: 0 = no, 1 = yes. Represents a boolean categorical.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">PTCA Within 24 Hours</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/ptcawithin24h"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergyoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Allergy Offset</rdfs:label>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time to when the allergy was noted.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/allergyoffset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#etco2">
    <rdfs:comment xml:lang="en">End-tidal carbon dioxide concentration measured in millimeters of mercury (mmHg). Represents the partial pressure of CO2 at the end of an exhaled breath, used to monitor ventilation adequacy.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:label xml:lang="en">End-Tidal Carbon Dioxide (EtCO2)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/etco2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CPLGOALCATEGORY">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdfs:label xml:lang="en">Care Plan Goal Category</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The category or type of the care plan goal, such as a clinical domain or therapeutic area the goal pertains to.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/CPLGOALCATEGORY"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#fio2">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/fio2"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/fio2"/>
    <rdfs:comment xml:lang="en">Fraction of inspired oxygen expressed as a decimal (e.g., 0.21 for room air, 1.0 for 100% oxygen), used in APACHE scoring to assess the level of supplemental oxygen being delivered to the patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Fraction of inspired oxygen (FiO2), expressed as a decimal (e.g., 0.21 to 1.0). Used as a physiological variable in APACHE scoring.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Fraction of Inspired Oxygen (FiO2)</rdfs:label>
    <rdfs:label xml:lang="en">FiO2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Vitalperiodic">
    <rdfs:comment xml:lang="en">External alignment: vitalperiodicid exactly 1 xsd:long</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents periodically recorded vital sign observations for a patient during their ICU stay. Each record captures a snapshot of physiological parameters such as heart rate, blood pressure, temperature, oxygen saturation, and other hemodynamic measurements at a specific time offset from unit admission.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vital Signs Periodic Measurement</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplgroup">
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
    <rdfs:label xml:lang="en">Care Plan Group</rdfs:label>
    <rdfs:comment xml:lang="en">The category or group to which this care plan item belongs, such as 'Nutrition', 'Activity', 'Ventilation', or other clinical care domains.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral/cplgroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosispriority">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/diagnosispriority"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Diagnosis Priority</rdfs:label>
    <rdfs:comment xml:lang="en">The priority level of the diagnosis, indicating whether it is a primary diagnosis (the condition most responsible for the patient's admission) or a secondary/other diagnosis representing comorbid conditions. Typical values include 'Primary' and 'Other'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apacheversion">
    <rdfs:comment xml:lang="en">The version of the APACHE scoring system used (e.g., 'IV', 'IVa'). Different versions use different algorithms and variable sets.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/apacheversion"/>
    <rdfs:label xml:lang="en">APACHE Version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#physicianinterventioncategory">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:label xml:lang="en">Physician Intervention Category</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/physicianinterventioncategory"/>
    <rdfs:comment xml:lang="en">The category of intervention performed by the physician, used in APACHE scoring to classify the type of clinical management (e.g., surgical, medical).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Lab">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents a clinical laboratory test result recorded during a patient's unit stay. This class captures lab measurements such as electrolytes, inflammatory markers, liver function tests, renal markers, and endocrine markers used for monitoring postoperative recovery and pre-discharge assessment.</rdfs:comment>
    <rdfs:label xml:lang="en">Laboratory Test</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSINGCHARTOFFSET">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecharting/NURSINGCHARTOFFSET"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecharting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nursing Chart Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when the nursing chart observation was recorded.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labid">
    <rdfs:comment xml:lang="en">Unique primary key identifier for each laboratory test record.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labid"/>
    <rdfs:label xml:lang="en">Lab Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#loadingdose">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/loadingdose"/>
    <rdfs:label xml:lang="en">Loading Dose</rdfs:label>
    <rdfs:comment xml:lang="en">The initial higher dose of the medication given to rapidly achieve a therapeutic concentration, expressed as a string including amount and unit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCAREID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:label xml:lang="en">Respiratory Care ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/RESPCAREID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for each respiratory care record. Serves as the primary key.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#urine">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Total urine output in milliliters (mL) over a 24-hour period, used as a physiological variable in the APACHE scoring system.</rdfs:comment>
    <rdfs:label xml:lang="en">Urine Output</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/urine"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosisstring">
    <rdfs:comment xml:lang="en">A hierarchical text string describing the diagnosis, typically structured as a path from general category to specific condition (e.g., 'cardiovascular|arrhythmias|atrial fibrillation').</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/diagnosisstring"/>
    <rdfs:label xml:lang="en">Diagnosis String</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:treatment">
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
    <rdfs:comment xml:lang="en">The treatment administered for the infectious disease, such as antibiotic therapy, antifungal therapy, or other antimicrobial interventions.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/treatment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaldischargestatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The status of the patient at hospital discharge (e.g., Alive, Expired).</rdfs:comment>
    <rdfs:comment xml:lang="en">The vital status of the patient at the time of hospital discharge (e.g., 'Alive', 'Expired'). Indicates whether the patient survived to hospital discharge.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaldischargestatus"/>
    <rdfs:label xml:lang="en">Hospital Discharge Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cirrhosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/cirrhosis"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of cirrhosis as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Cirrhosis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTEID">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTEID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">A unique integer identifier for the clinical note record. Serves as the primary key for the note table.</rdfs:comment>
    <rdfs:label xml:lang="en">Note Identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSEASSESSOFFSET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Nurse Assessment Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/NURSEASSESSOFFSET"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to the time the nurse assessment was performed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cvp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/cvp"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:comment xml:lang="en">Central venous pressure measured in millimeters of mercury (mmHg). Reflects the pressure in the thoracic vena cava near the right atrium, used to assess cardiac preload and fluid status.</rdfs:comment>
    <rdfs:label xml:lang="en">Central Venous Pressure (CVP)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#managingphysician">
    <rdfs:label xml:lang="en">Managing Physician</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/managingphysician"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Indicates whether this care provider is the managing physician for the patient's care plan. Typically encoded as a categorical string value.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cpleolid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplaneol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique identifier (primary key) for the end-of-life care plan record.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan End of Life ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaneol/cpleolid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#lymphoma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/lymphoma"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of lymphoma as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Lymphoma</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugdosage">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/drugdosage"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The numeric dosage amount of the medication. The unit of measurement is specified in the drugunit property.</rdfs:comment>
    <rdfs:label xml:lang="en">Drug Dosage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labotherresult">
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The categorical or qualitative result of the custom laboratory test, such as 'normal', 'abnormal', 'positive', 'negative', or similar textual outcome descriptors.</rdfs:comment>
    <rdfs:label xml:lang="en">Lab Other Result</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/labotherresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#paop">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Pulmonary Artery Occlusion Pressure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/paop"/>
    <rdfs:comment xml:lang="en">Pulmonary Artery Occlusion Pressure (PAOP), also known as pulmonary capillary wedge pressure (PCWP), measured in mmHg. Used to assess left atrial and left ventricular filling pressures.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#customlabid">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for each custom laboratory test record. Serves as the primary key for the customlab table.</rdfs:comment>
    <rdfs:label xml:lang="en">Custom Lab ID</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/customlabid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labothername">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Customlab"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Lab Other Name</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab/labothername"/>
    <rdfs:comment xml:lang="en">The name or label of the custom laboratory test performed, e.g., a specific enzyme, electrolyte, or biomarker name such as ASAT, ALAT, CRP, PCT, Albumin, Lipase, Creatinine, Bilirubin, INR, Hemoglobin, Leukocytes, Sodium, GFR, TSH, HbA1c, etc.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#interventioncategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Intervention Category</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:comment xml:lang="en">The category of clinical intervention associated with this care provider entry in the care plan.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/interventioncategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTVALUE">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTVALUE"/>
    <rdfs:comment xml:lang="en">The recorded value of the respiratory parameter identified by RESPCHARTVALUELABEL. Stored as a string to accommodate both numeric values (e.g., '40' for FiO2 percentage) and textual values (e.g., ventilator mode names). Units depend on the specific parameter being measured.</rdfs:comment>
    <rdfs:label xml:lang="en">Respiratory Chart Value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#LOWIRONOXLIMIT">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/LOWIRONOXLIMIT"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">Low Inspired Oxygen Limit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Lower alarm limit for inspired oxygen concentration (FiO2), measured as a percentage or fraction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#predictediculos">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">Predicted ICU Length of Stay</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/predictediculos"/>
    <rdfs:comment xml:lang="en">The predicted ICU length of stay in days, as estimated by the APACHE model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:cplinfectid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/cplinfectid"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:comment xml:lang="en">Primary key uniquely identifying each infectious disease record within the care plan. Auto-generated integer identifier.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan Infectious Disease Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Apachepredvar">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents a set of predictor variables used in the APACHE (Acute Physiology and Chronic Health Evaluation) scoring system for ICU patients. Each record captures physiological, demographic, and clinical variables used to predict patient outcomes.</rdfs:comment>
    <rdfs:label xml:lang="en">APACHE Prediction Variable</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#predictedhospitallos">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/predictedhospitallos"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">The predicted hospital length of stay in days, as estimated by the APACHE model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Predicted Hospital Length of Stay</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTVALUELABEL">
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTVALUELABEL"/>
    <rdfs:label xml:lang="en">Respiratory Chart Value Label</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The descriptive label for the specific respiratory parameter being recorded, such as 'FiO2', 'Tidal Volume', 'PEEP', 'Respiratory Rate', or other ventilator and respiratory measurement names.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Customlab">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/customlab"/>
    <rdfs:comment xml:lang="en">Represents a custom laboratory test result recorded for a patient during their ICU stay. This includes non-standard or facility-specific lab tests that are not part of the standard lab panel. Relevant postoperative and pre-discharge lab parameters include liver enzymes (ASAT, ALAT, AP, GGT), pancreatic markers (Lipase), kidney function (Creatinine, Urea, GFR), clotting (Quick, INR, Bilirubin), electrolytes (Sodium), blood parameters (Hemoglobin, Leukocytes), inflammatory markers (CRP, PCT), nutritional markers (Albumin, Cholinesterase), and endocrine markers (TSH, HbA1c).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Custom Laboratory Test</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apacheadmissiondx">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/apacheadmissiondx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">APACHE Admission Diagnosis</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The APACHE (Acute Physiology and Chronic Health Evaluation) admission diagnosis, a standardized diagnosis used for severity scoring in ICU patients.</rdfs:comment>
    <rdfs:comment xml:lang="en">The admission diagnosis selected for the patient as part of the APACHE (Acute Physiology and Chronic Health Evaluation) scoring system. This is a free-text or standardized string describing the primary reason for ICU admission used in severity-of-illness calculations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Diagnosis">
    <rdfs:comment xml:lang="en">Represents a clinical diagnosis assigned to a patient during an ICU stay. Each diagnosis includes an ICD-9 code, a textual description, a priority level (primary or secondary), and whether the diagnosis was active upon discharge.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Diagnosis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pasthistoryoffset">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/pasthistory/pasthistoryoffset"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to when the past history event was noted or occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Pasthistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Past History Offset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Careplancareprovider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider"/>
    <rdfs:comment xml:lang="en">Represents a care provider entry within a patient's care plan, documenting the type of provider, their specialty, intervention category, and whether they are the managing physician. Each record is associated with a specific patient unit stay.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Care Plan Care Provider</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplgeneralid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral/cplgeneralid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Unique integer identifier for a general care plan entry. Serves as the primary key for the Careplangeneral class.</rdfs:comment>
    <rdfs:label xml:lang="en">Care Plan General ID</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admissionheight">
    <rdfs:comment xml:lang="en">The height of the patient at the time of admission, measured in centimeters (cm).</rdfs:comment>
    <rdfs:comment xml:lang="en">The height of the patient at the time of admission, recorded in centimeters (cm) as a decimal value.</rdfs:comment>
    <rdfs:label xml:lang="en">Admission Height</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/admissionheight"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
</rdf:RDF>
