<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:prov="http://www.w3.org/ns/prov#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology#cplgoalid">
    <rdfs:comment xml:lang="en">A unique integer identifier for each care plan goal record. Serves as the primary key for the careplangoal table.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangoal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangoal/cplgoalid"/>
    <rdfs:label xml:lang="en">Care Plan Goal Identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:drugname">
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/drugname"/>
    <rdfs:label xml:lang="en">Drug Name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the drug being administered via continuous intravenous infusion, e.g., vasopressors, sedatives, or analgesics.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CELLLABEL">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nurseassessment/CELLLABEL"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/CELLLABEL"/>
    <rdfs:comment xml:lang="en">The display label of the cell in the nursing assessment form, representing the category or section of the assessment (e.g., 'Neurological', 'Cardiovascular').</rdfs:comment>
    <rdfs:comment xml:lang="en">The label of the nursing care charting cell, identifying the category or type of nursing care observation being documented (e.g., skin assessment, pain level, mobility status).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nurseassessment"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdfs:label xml:lang="en">Cell Label</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#albumin">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Serum albumin concentration measured in grams per deciliter (g/dL), representing the worst value in the first 24 hours of ICU admission for APACHE scoring. Low albumin may indicate liver dysfunction or malnutrition.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/albumin"/>
    <rdfs:label xml:lang="en">Serum Albumin</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#apachepatientresultsid">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/apachepatientresultsid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">APACHE Patient Results ID</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Primary key identifier for the APACHE patient result record. Unique, not-null integer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaladmittime24">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaladmittime24"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The time of hospital admission in 24-hour format (HH:MM:SS). Stored as a time string derived from a VARCHAR(8) source column.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of day the patient was admitted to the hospital, recorded in 24-hour format (HH:MM:SS). The source database column is VARCHAR(8) storing a time-of-day string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Hospital Admit Time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">Hospital Admission Time (24-hour)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdxenteredoffset">
    <rdfs:label xml:lang="en">Admission Diagnosis Entered Offset</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx/admitdxenteredoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission when the admission diagnosis was entered into the system. Negative values indicate entries made before the recorded unit admission time.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTETEXT">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTETEXT"/>
    <rdfs:comment xml:lang="en">The free-text content of the clinical note containing the clinician's narrative documentation, observations, or assessments.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Note Text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitadmittime24">
    <rdfs:label xml:lang="en">Unit Admit Time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">Unit Admission Time (24-hour)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitadmittime24"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time of unit admission in 24-hour format (HH:MM:SS). Stored as a time string derived from a VARCHAR(8) source column.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of day the patient was admitted to the ICU or hospital unit, recorded in 24-hour format (HH:MM:SS). This time serves as the reference point (offset = 0) for all offset-based timestamps. The source database column is VARCHAR(8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labresulttext">
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
    <rdfs:comment xml:lang="en">The textual representation of the laboratory test result, which may include qualitative results or the numeric value as a string.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labresulttext"/>
    <rdfs:label xml:lang="en">Lab Result Text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rxincluded">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondrug/rxincluded"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/allergy/rxincluded"/>
    <rdfs:comment xml:lang="en">Indicates whether the drug was included in the patient's prescription list. Expected values are 'True' or 'False'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the allergy information was included in the prescription workflow. Typical values are 'Yes' or 'No'.</rdfs:comment>
    <rdfs:label xml:lang="en">Prescription Included</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaladmitoffset">
    <rdfs:label xml:lang="en">Hospital Admit Offset</rdfs:label>
    <rdfs:label xml:lang="en">Hospital Admission Offset</rdfs:label>
    <rdfs:comment xml:lang="en">Time offset in minutes from the unit admission time to the hospital admission time. Typically a negative value indicating the hospital admission occurred before the unit admission.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of minutes between the hospital admission time and the unit admission time (which serves as the reference time point, offset = 0). Negative values indicate the hospital admission occurred before the unit admission.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaladmitoffset"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#teachingstatus">
    <rdfs:domain rdf:resource="http://example.org/ontology#Hospital"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/hospital/teachingstatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Teaching Status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Indicates whether the hospital is a teaching hospital. The source database column is TINYINT where 1 represents a teaching hospital and 0 represents a non-teaching hospital. Mapped to xsd:boolean where true indicates a teaching hospital and false indicates a non-teaching hospital.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the hospital is a teaching hospital (true) or a non-teaching hospital (false). Teaching hospitals are affiliated with medical schools and provide clinical education to medical students and residents. Mapped from TINYINT in the source database where 1 = true (teaching) and 0 = false (non-teaching).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#heartrate">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/heartrate"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/heartrate"/>
    <rdfs:label xml:lang="en">Heart Rate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:comment xml:lang="en">Heart rate measured in beats per minute (bpm), representing the worst value in the first 24 hours of ICU admission for APACHE scoring.</rdfs:comment>
    <rdfs:comment xml:lang="en">The patient's heart rate measured in beats per minute (bpm).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#verbal">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale (GCS) verbal response component used in APACHE scoring. Ordinal integer values: 1 = no verbal response, 2 = incomprehensible sounds, 3 = inappropriate words, 4 = confused, 5 = oriented. A value of -1 may indicate the patient is intubated and unable to be assessed verbally.</rdfs:comment>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale verbal component score. Ordinal integer ranging from 1 (no verbal response) to 5 (oriented). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/verbal"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/verbal"/>
    <rdfs:label xml:lang="en">GCS Verbal Response</rdfs:label>
    <rdfs:label xml:lang="en">GCS Verbal Score</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#nettotal">
    <rdfs:domain rdf:resource="http://example.org/ontology#Intakeoutput"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/intakeoutput/nettotal"/>
    <rdfs:label xml:lang="en">Net Total</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The net fluid balance calculated as intake minus output minus dialysis, measured in milliliters (mL). A positive value indicates net fluid gain; a negative value indicates net fluid loss.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#var03hspxlos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">Predicted Hospital Length of Stay Variable</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">APACHE variable 03 representing predicted hospital length of stay, measured in days as a continuous value.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/var03hspxlos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hospitaldischargetime24">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:label xml:lang="en">Hospital Discharge Time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">Hospital Discharge Time (24-hour)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/hospitaldischargetime24"/>
    <rdfs:comment xml:lang="en">The time of hospital discharge in 24-hour format (HH:MM:SS). Stored as a time string derived from a VARCHAR(8) source column.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of day the patient was discharged from the hospital, recorded in 24-hour format (HH:MM:SS). The source database column is VARCHAR(8) storing a time-of-day string.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hepaticfailure">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient has a history of hepatic (liver) failure as a chronic health condition for APACHE scoring. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/hepaticfailure"/>
    <rdfs:label xml:lang="en">Hepatic Failure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#labmeasurenameinterface">
    <rdfs:comment xml:lang="en">The interface-level name for the laboratory measurement, representing the naming convention used at the data interface or integration layer.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/lab/labmeasurenameinterface"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Lab Measure Name Interface</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Lab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#respiration">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/respiration"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Respiration Rate</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:comment xml:lang="en">The patient's respiratory rate measured in breaths per minute.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#acutephysiologyscore">
    <rdfs:label xml:lang="en">Acute Physiology Score</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The acute physiology score component of the APACHE assessment. This integer score is derived from the worst physiological values recorded during the first 24 hours of ICU admission.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/acutephysiologyscore"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#activeupondischarge">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Active Upon Discharge</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether this care provider was still actively involved in the patient's care at the time of discharge. Typically encoded as a categorical string such as 'True' or 'False'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the end-of-life care plan was still active at the time of patient discharge. Stored as a boolean value (true or false).</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether this care plan item was still active at the time of patient discharge. Stored as a string with typical values 'True' or 'False'. Retained as xsd:string rather than xsd:boolean because the source VARCHAR(10) column may contain additional or null-like values beyond strict boolean.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the diagnosis was still active at the time of patient discharge from the unit. Typical values include 'True' or 'False'. Stored as a string; may be considered for conversion to xsd:boolean.</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether the treatment was still active at the time of the patient's discharge from the unit. Expected values are typically 'True' or 'False'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplancareprovider"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplaneol"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Treatment"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplancareprovider/activeupondischarge"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaneol/activeupondischarge"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral/activeupondischarge"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/activeupondischarge"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/treatment/activeupondischarge"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#drugstopoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medication"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/medication/drugstopoffset"/>
    <rdfs:label xml:lang="en">Drug Stop Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time offset in minutes from the patient's unit admission to when the drug administration was stopped. A negative value indicates the drug was stopped before unit admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#uniquepid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Unique Patient ID</rdfs:label>
    <rdfs:label xml:lang="en">Unique Patient Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">A de-identified unique identifier for the patient across multiple hospital stays and unit visits.</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique string identifier that tracks a single patient across multiple hospital admissions and unit stays. Used to link all encounters belonging to the same individual, analogous to a patient life number.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/uniquepid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NOTETYPE">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/note/NOTETYPE"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Note"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Note Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The category or type of the clinical note, such as 'Nursing', 'Physician', 'Respiratory', etc. Indicates the clinical discipline or purpose of the note.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#oobintubday1">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/oobintubday1"/>
    <rdfs:comment xml:lang="en">Indicates whether the patient had out-of-bed intubation on day 1 of ICU stay. Encoded as integer: 0 = no, 1 = yes.</rdfs:comment>
    <rdfs:label xml:lang="en">Out-of-Bed Intubation Day 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#day1verbal">
    <rdfs:comment xml:lang="en">Glasgow Coma Scale verbal component score on day 1 of ICU admission. Ordinal integer ranging from 1 (no verbal response) to 5 (oriented). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/day1verbal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:label xml:lang="en">Day 1 GCS Verbal Score</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#NURSECAREENTRYOFFSET">
    <rdfs:label xml:lang="en">Nurse Care Entry Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Nursecare"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to the time the nurse care entry was entered into the system. This may differ from NURSECAREOFFSET if documentation was performed retrospectively.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/nursecare/NURSECAREENTRYOFFSET"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dischargeweight">
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of discharge, measured in kilograms (kg).</rdfs:comment>
    <rdfs:comment xml:lang="en">The weight of the patient at the time of unit discharge, recorded in kilograms (kg) as a decimal value.</rdfs:comment>
    <rdfs:label xml:lang="en">Discharge Weight</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/dischargeweight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:physicalexampath">
    <rdfs:comment xml:lang="en">A hierarchical string representing the structured path of the physical examination finding, typically encoding the body system and specific finding category (e.g., 'notes/Progress Notes/Physical Exam/Physical Exam/Neurologic/GCS/Eyes').</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/physicalexampath"/>
    <rdfs:label xml:lang="en">Physical Examination Path</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#observationoffset">
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalperiodic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/observationoffset"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalperiodic/observationoffset"/>
    <rdfs:label xml:lang="en">Observation Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission time to when this aperiodic vital sign observation was recorded.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time in minutes from the patient's unit admission to the time the vital sign observation was recorded. A negative value indicates the observation occurred before unit admission.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patienthealthsystemstayid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Patient Health System Stay ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier for the patient's overall health system stay, which may encompass multiple unit stays.</rdfs:comment>
    <rdfs:comment xml:lang="en">An integer identifier representing the patient's overall health system stay. Groups multiple unit stays that occur within the same hospital admission or health system encounter.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/patienthealthsystemstayid"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#diagnosisoffset">
    <rdfs:label xml:lang="en">Diagnosis Offset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the unit admission time at which the diagnosis was entered or recorded.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/diagnosis/diagnosisoffset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Diagnosis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Vitalaperiodic">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Represents aperiodic (non-regularly timed) vital sign measurements for a patient during an ICU stay. These include non-invasive blood pressure readings, pulmonary artery occlusion pressure, cardiac output/input, and vascular resistance indices.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vital Signs Aperiodic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#cplitemoffset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Care Plan Item Offset</rdfs:label>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's unit admission to when this care plan item was recorded or became active.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplangeneral/cplitemoffset"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplangeneral"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:antibiotic">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The name of the antibiotic agent tested against the identified organism in an antimicrobial susceptibility test. Used to determine appropriate antimicrobial therapy and to detect antibiotic resistance patterns.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/antibiotic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Antibiotic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:sensitivitylevel">
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/sensitivitylevel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The susceptibility result of the identified organism to the tested antibiotic. Typical values include 'Sensitive' (S), 'Intermediate' (I), and 'Resistant' (R), indicating whether the organism is likely to respond to treatment with the given antibiotic. This is critical for identifying multidrug resistance.</rdfs:comment>
    <rdfs:label xml:lang="en">Sensitivity Level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:hasPatient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Careplaninfectiousdisease"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Microlab"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Physicalexam"/>
    <rdfs:range rdf:resource="http://example.org/ontology#:Patient"/>
    <rdfs:label xml:lang="en">has Patient</rdfs:label>
    <rdfs:label xml:lang="en">Has Patient</rdfs:label>
    <rdfs:label xml:lang="en">has patient</rdfs:label>
    <rdfs:comment xml:lang="en">Links a care plan infectious disease record to the patient (identified by patient unit stay) to whom this infectious disease entry belongs. Resolves foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an infusion drug administration record to the patient (ICU stay) who received the infusion. Resolves the foreign key from infusiondrug.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a microbiology laboratory result to the patient (identified by their unit stay) from whom the culture specimen was collected. Resolves the foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a physical examination record to the patient (unit stay) on whom the examination was performed. Resolves the foreign key from physicalexam.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/careplaninfectiousdisease/patientunitstayid"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/patientunitstayid"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/microlab/patientunitstayid"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/physicalexam/patientunitstayid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#AIRWAYSIZE">
    <rdfs:label xml:lang="en">Airway Size</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycare/AIRWAYSIZE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Size of the artificial airway device, typically expressed in millimeters of internal diameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#RESPCHARTTYPECAT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The category or type classification of the respiratory charting entry, such as ventilator settings, oxygenation parameters, or respiratory assessment categories. This is a categorical field that could be modeled as an enumerated class in future revisions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Respiratorycharting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Respiratory Chart Type Category</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/respiratorycharting/RESPCHARTTYPECAT"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#:infusionoffset">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/infusiondrug/infusionoffset"/>
    <rdfs:comment xml:lang="en">The time offset in minutes from the patient's ICU admission to the infusion drug record entry. A positive value indicates time after admission; a negative value indicates time before admission.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Infusion Time Offset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#:Infusiondrug"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Apacheapsvar">
    <rdfs:comment xml:lang="en">Represents the Acute Physiology Score (APS) variables used in the APACHE (Acute Physiology and Chronic Health Evaluation) scoring system. Each instance captures physiological measurements and clinical parameters for a patient during an ICU stay, used to compute illness severity scores.</rdfs:comment>
    <rdfs:comment xml:lang="en">External alignment: apacheapsvarid exactly 1 xsd:integer</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">APACHE APS Variable</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#motor">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/motor"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/motor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale (GCS) motor response component used in APACHE scoring. Ordinal integer values: 1 = no motor response, 2 = extension to pain, 3 = flexion to pain, 4 = withdrawal from pain, 5 = localizing pain, 6 = obeys commands.</rdfs:comment>
    <rdfs:comment xml:lang="en">Glasgow Coma Scale motor component score. Ordinal integer ranging from 1 (no motor response) to 6 (obeys commands). Value of -1 may indicate unable to assess.</rdfs:comment>
    <rdfs:label xml:lang="en">GCS Motor Response</rdfs:label>
    <rdfs:label xml:lang="en">GCS Motor Score</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#noninvasivediastolic">
    <rdfs:comment xml:lang="en">The diastolic blood pressure measured non-invasively (e.g., via cuff), recorded in mmHg.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Vitalaperiodic"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/vitalaperiodic/noninvasivediastolic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Non-Invasive Diastolic Blood Pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#admitdxpath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The hierarchical classification path of the admission diagnosis within the eICU diagnosis taxonomy. This string represents the full path from the root category to the specific diagnosis, with levels separated by a delimiter (e.g., 'admission diagnosis|Cardiovascular|Shock|Sepsis').</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/admissiondx/admitdxpath"/>
    <rdfs:label xml:lang="en">Admission Diagnosis Path</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#predictedhospitalmortality">
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepatientresult/predictedhospitalmortality"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The predicted probability of hospital mortality based on the APACHE model, stored as a string representation.</rdfs:comment>
    <rdfs:label xml:lang="en">Predicted Hospital Mortality</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#unitdischargetime24">
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/patient/unitdischargetime24"/>
    <rdfs:label xml:lang="en">Unit Discharge Time (24h)</rdfs:label>
    <rdfs:label xml:lang="en">Unit Discharge Time (24-hour)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:comment xml:lang="en">The time of unit discharge in 24-hour format (HH:MM:SS). Stored as a time string derived from a VARCHAR(8) source column.</rdfs:comment>
    <rdfs:comment xml:lang="en">The time of day the patient was discharged from the ICU or hospital unit, recorded in 24-hour format (HH:MM:SS). The source database column is VARCHAR(8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#pao2">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
    <rdfs:comment xml:lang="en">Partial pressure of oxygen in arterial blood measured in millimeters of mercury (mmHg), used in APACHE scoring to assess oxygenation status.</rdfs:comment>
    <rdfs:comment xml:lang="en">Partial pressure of arterial oxygen (PaO2), measured in mmHg. Used as a physiological variable in APACHE scoring.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apacheapsvar/pao2"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/provenance/apachepredvar/pao2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Partial Pressure of Arterial Oxygen (PaO2)</rdfs:label>
    <rdfs:label xml:lang="en">PaO2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasPatient">
    <rdfs:label xml:lang="en">has patient</rdfs:label>
    <rdfs:label xml:lang="en">Has Patient</rdfs:label>
    <rdfs:label xml:lang="en">has Patient</rdfs:label>
    <rdfs:comment xml:lang="en">Links an admission drug record to the patient unit stay during which the drug was documented. Resolves foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an admission diagnosis record to the patient (identified by their unit stay) for whom the diagnosis was recorded. This resolves the foreign key from admissiondx.patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an allergy record to the patient unit stay during which the allergy was documented. Resolves foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an APACHE APS variable record to the patient unit stay it belongs to. Resolves the foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an APACHE patient result record to the patient unit stay it was computed for. Resolves foreign key patientunitstayid referencing patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an APACHE prediction variable record to the patient unit stay it pertains to.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a care plan care provider record to the patient unit stay it is associated with. Resolves the foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the end-of-life care plan record to the patient unit stay it belongs to. Resolves foreign key patientunitstayid referencing the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a general care plan entry to the patient (identified by their unit stay) for whom the care plan was created. Resolves the foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a care plan goal to the patient (identified by their unit stay) for whom the goal was established. Resolves the foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a custom laboratory test record to the patient (identified by their unit stay) for whom the test was performed. Resolves the foreign key from customlab.patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a diagnosis to the patient unit stay during which the diagnosis was recorded. Resolves the foreign key from diagnosis.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an intake/output record to the patient (identified by their unit stay) to whom this fluid balance measurement belongs. Resolves the foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a laboratory test record to the patient (identified by their unit stay) for whom the test was performed. Resolves the foreign key from lab.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medication order to the patient (identified by their unit stay) to whom the medication was prescribed or administered.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a clinical note to the patient whose unit stay the note is associated with. Resolves the foreign key from note.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse assessment record to the patient (identified by their unit stay) for whom the assessment was performed. Resolves the foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse care entry to the patient (identified by their unit stay) for whom the nursing care was documented. Resolves the foreign key from nursecare.patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a nurse charting entry to the patient whose unit stay the observation was recorded during. Resolves the foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a past history record to the patient (unit stay) to whom this history entry belongs. Resolves foreign key pasthistory.patientunitstayid referencing patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a respiratory care record to the patient unit stay it belongs to. Derived from foreign key PATIENTUNITSTAYID referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a respiratory charting entry to the patient (identified by their unit stay) for whom the respiratory observation was recorded. Resolves foreign key PATIENTUNITSTAYID referencing the patient table.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a treatment record to the patient (identified by their unit stay) who received the treatment. Resolves the foreign key from treatment.patientunitstayid to patient.patientunitstayid.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an aperiodic vital sign measurement to the patient (identified by their unit stay) to whom the measurement belongs. Resolves foreign key from patientunitstayid to the Patient class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a periodic vital sign measurement to the patient unit stay during which the observation was recorded. Resolves the foreign key patientunitstayid referencing the patient table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Patient"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondrug"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Admissiondx"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apacheapsvar"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepatientresult"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Apachepredvar"/>
