    <rdfs:comment xml:lang="en">Class generated from source table 'PlaylistTrack'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A junction entity representing the many-to-many association between a Playlist and a Track. Each instance indicates that a specific track is included in a specific playlist. The composite key (PlaylistId, TrackId) ensures no duplicate track entries within the same playlist.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Playlist Track</rdfs:label>
