  <rdf:Description rdf:about="http://example.org/ontology#Employee_ReportsTo">
    <rdfs:label xml:lang="en">Employee Reports To</rdfs:label>
    <rdfs:label xml:lang="en">Reports To</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/Employee/ReportsTo"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Employee"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Employee"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'Employee.ReportsTo' referencing 'Employee.EmployeeId'. This is an explicit recursive self-referential relationship within the Employee class.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the manager or supervisor of this employee. This is a self-referential foreign key (Employee.ReportsTo references Employee.EmployeeId), representing the organizational reporting hierarchy. An employee may have at most one direct manager. The top-level manager has no value for this property.</rdfs:comment>
  </rdf:Description>
