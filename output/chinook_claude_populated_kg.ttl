    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/PostalCode> .

onto:Employee_ReportsTo a owl:ObjectProperty ;
    rdfs:label "Employee Reports To"@en,
        "Reports To"@en ;
    rdfs:comment "Identifies the manager or supervisor of this employee. This is a self-referential foreign key (Employee.ReportsTo references Employee.EmployeeId), representing the organizational reporting hierarchy. An employee may have at most one direct manager. The top-level manager has no value for this property."@en,
        "Object property generated from foreign key 'Employee.ReportsTo' referencing 'Employee.EmployeeId'. This is an explicit recursive self-referential relationship within the Employee class."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range onto:Employee ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/ReportsTo> .

onto:Employee_State a owl:DatatypeProperty ;
    rdfs:label "State"@en ;
    rdfs:comment "Data property generated from source column 'Employee.State' with range xsd:string."@en,
        "State, province, or regional subdivision of the employee's address."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/State> .

onto:Employee_Title a owl:DatatypeProperty ;
    rdfs:label "Job Title"@en,
        "Title"@en ;
    rdfs:comment "Data property generated from source column 'Employee.Title' with range xsd:string."@en,
        "Job title or role of the employee (e.g., 'General Manager', 'Sales Support Agent'). This field is optional."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/Title> .

onto:Genre_Name a owl:DatatypeProperty ;
    rdfs:label "Genre Name"@en,
        "Name"@en ;
    rdfs:comment "Data property generated from source column 'Genre.Name' with range xsd:string."@en,
        "Name of the musical genre, such as rock, jazz, metal, or classical. This field may be empty."@en ;
    rdfs:domain onto:Genre ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Genre/Name> .

onto:InvoiceLine_Quantity a owl:DatatypeProperty ;
    rdfs:label "Quantity"@en ;
    rdfs:comment "Data property generated from source column 'InvoiceLine.Quantity' with range xsd:integer."@en,
        "The number of units of the track purchased in this line item."@en ;
    rdfs:domain onto:InvoiceLine ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/Quantity> .

onto:InvoiceLine_UnitPrice a owl:DatatypeProperty ;
    rdfs:label "Unit Price"@en ;
    rdfs:comment "Data property generated from source column 'InvoiceLine.UnitPrice' with range xsd:decimal."@en,
        "The unit price charged for the track on this invoice line item. This is a monetary decimal value."@en ;
    rdfs:domain onto:InvoiceLine ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/UnitPrice> .

onto:InvoiceLine_hasInvoice a owl:ObjectProperty ;
    rdfs:label "Invoice Line has Invoice"@en,
        "belongs to invoice"@en ;
    rdfs:comment "Object property generated from foreign key 'InvoiceLine.InvoiceId' referencing 'Invoice.InvoiceId'."@en,
        "Relates an invoice line item to the invoice it belongs to. Foreign-key relationship from InvoiceLine.InvoiceId to Invoice.InvoiceId."@en ;
    rdfs:domain onto:InvoiceLine ;
    rdfs:range onto:Invoice ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/InvoiceId> .

onto:InvoiceLine_hasTrack a owl:ObjectProperty ;
    rdfs:label "Invoice Line has Track"@en,
        "purchased track"@en ;
    rdfs:comment "Object property generated from foreign key 'InvoiceLine.TrackId' referencing 'Track.TrackId'."@en,
        "Relates an invoice line item to the track that was purchased. Foreign-key relationship from InvoiceLine.TrackId to Track.TrackId."@en ;
    rdfs:domain onto:InvoiceLine ;
    rdfs:range onto:Track ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/TrackId> .

onto:Invoice_BillingAddress a owl:DatatypeProperty ;
    rdfs:label "Billing Address"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.BillingAddress' with range xsd:string."@en,
        "Street address used for billing on this invoice. Optional field."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/BillingAddress> .

onto:Invoice_BillingCity a owl:DatatypeProperty ;
    rdfs:label "Billing City"@en ;
    rdfs:comment "City used for billing on this invoice. Optional field."@en,
        "Data property generated from source column 'Invoice.BillingCity' with range xsd:string."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/BillingCity> .

onto:Invoice_BillingCountry a owl:DatatypeProperty ;
    rdfs:label "Billing Country"@en ;
    rdfs:comment "Country used for billing on this invoice. Optional field."@en,
        "Data property generated from source column 'Invoice.BillingCountry' with range xsd:string."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/BillingCountry> .

onto:Invoice_BillingPostalCode a owl:DatatypeProperty ;
    rdfs:label "Billing Postal Code"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.BillingPostalCode' with range xsd:string."@en,
        "Postal or ZIP code used for billing on this invoice. Optional field."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/BillingPostalCode> .

onto:Invoice_BillingState a owl:DatatypeProperty ;
    rdfs:label "Billing State"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.BillingState' with range xsd:string."@en,
        "State, province, or regional subdivision used for billing on this invoice. Optional field."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/BillingState> .

onto:MediaType_Name a owl:DatatypeProperty ;
    rdfs:label "Media Type Name"@en,
        "Name"@en ;
    rdfs:comment "Data property generated from source column 'MediaType.Name' with range xsd:string."@en,
        "Name or description of the media type, describing the audio format, encoding type, or protected media format (e.g., 'MPEG audio file', 'AAC audio file', 'Protected AAC audio file')."@en ;
    rdfs:domain onto:MediaType ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/MediaType/Name> .

onto:Playlist_Name a owl:DatatypeProperty ;
    rdfs:label "Name"@en,
        "Playlist Name"@en ;
    rdfs:comment "Data property generated from source column 'Playlist.Name' with range xsd:string."@en,
        "Name of the playlist. May contain a user-facing or system-defined playlist name. This field is optional (nullable)."@en ;
    rdfs:domain onto:Playlist ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Playlist/Name> .

onto:Track_Milliseconds a owl:DatatypeProperty ;
    rdfs:label "Duration (Milliseconds)"@en,
        "Milliseconds"@en ;
    rdfs:comment "Data property generated from source column 'Track.Milliseconds' with range xsd:integer."@en,
        "Duration of the track measured in milliseconds. This is a required numeric field."@en ;
    rdfs:domain onto:Track ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/Milliseconds> .

onto:Track_Name a owl:DatatypeProperty ;
    rdfs:label "Name"@en,
        "Track Name"@en ;
    rdfs:comment "Data property generated from source column 'Track.Name' with range xsd:string."@en,
        "Name or title of the track. This is a required text field."@en ;
    rdfs:domain onto:Track ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/Name> .

onto:Track_UnitPrice a owl:DatatypeProperty ;
    rdfs:label "Unit Price"@en ;
    rdfs:comment "Data property generated from source column 'Track.UnitPrice' with range xsd:decimal."@en,
        "Price of the track as a decimal monetary amount. This is a required field."@en ;
    rdfs:domain onto:Track ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/UnitPrice> .

onto:Track_hasMediaType a owl:ObjectProperty ;
    rdfs:label "Track has Media Type"@en,
        "has media type"@en ;
    rdfs:comment "Indicates that each track has a media type. Foreign-key relationship from Track.MediaTypeId to MediaType.MediaTypeId. This is a required relationship."@en,
        "Object property generated from foreign key 'Track.MediaTypeId' referencing 'MediaType.MediaTypeId'."@en ;
    rdfs:domain onto:Track ;
    rdfs:range onto:MediaType ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/MediaTypeId> .

