onto:PlaylistTrack a owl:Class ;
    rdfs:label "Playlist Track"@en,
        "Playlist-Track Association"@en ;
    rdfs:comment "A junction entity representing the many-to-many association between a Playlist and a Track. Each instance indicates that a specific track is included in a specific playlist. The composite key (PlaylistId, TrackId) ensures no duplicate track entries within the same playlist."@en,
        "Class generated from source table 'PlaylistTrack'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:PlaylistTrack_hasTrack ;
            owl:someValuesFrom onto:Track ],
        [ a owl:Restriction ;
            owl:onProperty onto:PlaylistTrack_hasPlaylist ;
            owl:someValuesFrom onto:Playlist ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Playlist ;
            owl:onProperty onto:PlaylistTrack_hasPlaylist ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Track ;
            owl:onProperty onto:PlaylistTrack_hasTrack ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Playlist ;
            owl:onProperty onto:PlaylistTrack_hasPlaylist ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Track ;
            owl:onProperty onto:PlaylistTrack_hasTrack ],
        onto:PlaylistTrack_hasPlaylist_exactly_1_Playlist,
        onto:PlaylistTrack_hasTrack_exactly_1_Track ;
    owl:hasKey ( onto:PlaylistTrack_hasPlaylist onto:PlaylistTrack_hasTrack ),
        ( onto:PlaylistTrack_hasPlaylist onto:PlaylistTrack_hasTrack ) ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/PlaylistTrack> .

