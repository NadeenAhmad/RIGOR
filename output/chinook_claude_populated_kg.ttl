onto:Artist_ArtistId a owl:DatatypeProperty ;
    rdfs:label "Artist Id"@en ;
    rdfs:comment "Data property generated from source column 'Artist.ArtistId' with range xsd:integer."@en,
        "Unique identifier for the artist. This is the primary key of the Artist table and uniquely identifies each artist in the music catalogue."@en ;
    rdfs:domain onto:Artist ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Artist/ArtistId> .

onto:Genre_GenreId a owl:DatatypeProperty ;
    rdfs:label "Genre ID"@en,
        "Genre Id"@en ;
    rdfs:comment "Data property generated from source column 'Genre.GenreId' with range xsd:integer."@en,
        "Unique identifier for the genre. This field is the primary key of the Genre table."@en ;
    rdfs:domain onto:Genre ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Genre/GenreId> .

onto:PlaylistTrack_hasPlaylist a owl:ObjectProperty ;
    rdfs:label "Playlist Track has Playlist"@en,
        "belongs to playlist"@en ;
    rdfs:comment "Object property generated from foreign key 'PlaylistTrack.PlaylistId' referencing 'Playlist.PlaylistId'."@en,
        "Relates a PlaylistTrack association to the Playlist it belongs to. Derived from the foreign key PlaylistTrack.PlaylistId referencing Playlist.PlaylistId. This property is mandatory (NOT NULL) and part of the composite primary key."@en ;
    rdfs:domain onto:PlaylistTrack ;
    rdfs:range onto:Playlist ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/PlaylistTrack/PlaylistId> .

onto:PlaylistTrack_hasTrack a owl:ObjectProperty ;
    rdfs:label "Playlist Track has Track"@en,
        "includes track"@en ;
    rdfs:comment "Object property generated from foreign key 'PlaylistTrack.TrackId' referencing 'Track.TrackId'."@en,
        "Relates a PlaylistTrack association to the Track it includes. Derived from the foreign key PlaylistTrack.TrackId referencing Track.TrackId. This property is mandatory (NOT NULL) and part of the composite primary key."@en ;
    rdfs:domain onto:PlaylistTrack ;
    rdfs:range onto:Track ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/PlaylistTrack/TrackId> .

