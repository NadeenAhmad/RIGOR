onto:Customer_Address a owl:DatatypeProperty ;
    rdfs:label "Address"@en,
        "Street Address"@en ;
    rdfs:comment "Data property generated from source column 'Customer.Address' with range xsd:string."@en,
        "Street address of the customer. Optional field."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Address> .

onto:Customer_City a owl:DatatypeProperty ;
    rdfs:label "City"@en ;
    rdfs:comment "City of the customer address. Optional field."@en,
        "Data property generated from source column 'Customer.City' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/City> .

onto:Customer_Company a owl:DatatypeProperty ;
    rdfs:label "Company"@en ;
    rdfs:comment "Company or organization associated with the customer. This field may be empty if the customer is not associated with a company."@en,
        "Data property generated from source column 'Customer.Company' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Company> .

onto:Customer_Country a owl:DatatypeProperty ;
    rdfs:label "Country"@en ;
    rdfs:comment "Country of the customer address. Optional field."@en,
        "Data property generated from source column 'Customer.Country' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Country> .

onto:Customer_Fax a owl:DatatypeProperty ;
    rdfs:label "Fax"@en ;
    rdfs:comment "Customer fax number. Optional field."@en,
        "Data property generated from source column 'Customer.Fax' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Fax> .

onto:Customer_Phone a owl:DatatypeProperty ;
    rdfs:label "Phone"@en ;
    rdfs:comment "Customer phone number. Optional field."@en,
        "Data property generated from source column 'Customer.Phone' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Phone> .

onto:Customer_PostalCode a owl:DatatypeProperty ;
    rdfs:label "Postal Code"@en ;
    rdfs:comment "Data property generated from source column 'Customer.PostalCode' with range xsd:string."@en,
        "Postal or ZIP code of the customer address. Optional field."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/PostalCode> .

onto:Customer_State a owl:DatatypeProperty ;
    rdfs:label "State"@en ;
    rdfs:comment "Data property generated from source column 'Customer.State' with range xsd:string."@en,
        "State, province, or regional subdivision of the customer address. Optional field."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/State> .

onto:Customer_hasSupportRep a owl:ObjectProperty ;
    rdfs:label "Customer has Support Rep"@en,
        "has Support Representative"@en ;
    rdfs:comment "Object property generated from foreign key 'Customer.SupportRepId' referencing 'Employee.EmployeeId'."@en,
        "The employee assigned as the customer's support representative. Derived from foreign key Customer.SupportRepId referencing Employee.EmployeeId. May be empty if no support representative is assigned."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range onto:Employee ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/SupportRepId> .

onto:Track_Bytes a owl:DatatypeProperty ;
    rdfs:label "Bytes"@en,
        "File Size (Bytes)"@en ;
    rdfs:comment "Data property generated from source column 'Track.Bytes' with range xsd:integer."@en,
        "Size of the media file measured in bytes. May be empty if file size information is unavailable."@en ;
    rdfs:domain onto:Track ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/Bytes> .

onto:Track_Composer a owl:DatatypeProperty ;
    rdfs:label "Composer"@en ;
    rdfs:comment "Data property generated from source column 'Track.Composer' with range xsd:string."@en,
        "Name of the composer or composers of the track. May be empty when composer information is not available."@en ;
    rdfs:domain onto:Track ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/Composer> .

onto:Track_hasAlbum a owl:ObjectProperty ;
    rdfs:label "Track has Album"@en,
        "belongs to album"@en ;
    rdfs:comment "Indicates that a track may belong to an album. Foreign-key relationship from Track.AlbumId to Album.AlbumId. May be empty if the track is not assigned to an album."@en,
        "Object property generated from foreign key 'Track.AlbumId' referencing 'Album.AlbumId'."@en ;
    rdfs:domain onto:Track ;
    rdfs:range onto:Album ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/AlbumId> .

onto:Track_hasGenre a owl:ObjectProperty ;
    rdfs:label "Track has Genre"@en,
        "has genre"@en ;
    rdfs:comment "Indicates that a track may belong to a genre. Foreign-key relationship from Track.GenreId to Genre.GenreId. May be empty if the genre is not specified."@en,
        "Object property generated from foreign key 'Track.GenreId' referencing 'Genre.GenreId'."@en ;
    rdfs:domain onto:Track ;
    rdfs:range onto:Genre ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Track/GenreId> .

