        "Class generated from source table 'Genre'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:Genre_GenreId ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty onto:Genre_GenreId ],
        [ a owl:Restriction ;
