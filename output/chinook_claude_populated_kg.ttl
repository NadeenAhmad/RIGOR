        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty onto:Genre_Name ],
        onto:Genre_GenreId_exactly_1_xsd_integer,
        onto:Genre_Name_max_1_xsd_string ;
    owl:hasKey ( onto:Genre_GenreId ),
        ( onto:Genre_GenreId ) ;
    skos:exactMatch <http://www.wikidata.org/entity/Q105672006> ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Genre> .

