onto:MediaType a owl:Class ;
    rdfs:label "Media Type"@en ;
    rdfs:comment "A media format or encoding type for tracks, describing the audio format, encoding type, or protected media format."@en,
        "Class generated from source table 'MediaType'."@en,
        "Represents a media format or encoding type for audio tracks. Examples include AAC, MPEG, protected AAC, and purchased AAC audio files. Each track in the catalogue is associated with exactly one media type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty onto:MediaType_Name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty onto:MediaType_Name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty onto:MediaType_MediaTypeId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty onto:MediaType_MediaTypeId ],
        [ a owl:Restriction ;
            owl:onProperty onto:MediaType_MediaTypeId ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty onto:MediaType_MediaTypeId ;
            owl:someValuesFrom xsd:integer ],
        onto:MediaType_MediaTypeId_exactly_1_xsd_integer,
        onto:MediaType_Name_max_1_xsd_string ;
    owl:hasKey ( onto:MediaType_MediaTypeId ),
        ( onto:MediaType_MediaTypeId ) ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/MediaType> .

