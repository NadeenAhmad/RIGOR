onto:Album_Title a owl:DatatypeProperty ;
    rdfs:label "Album Title"@en,
        "Title"@en ;
    rdfs:comment "Data property generated from source column 'Album.Title' with range xsd:string."@en,
        "The title of the music album. This is a required text field representing the human-readable name of the album."@en ;
    rdfs:domain onto:Album ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Album/Title> .

onto:Album_hasArtist a owl:ObjectProperty ;
    rdfs:label "Album has Artist"@en,
        "has artist"@en ;
    rdfs:comment "Links an album to the artist who created, performed, or is associated with it. Every album belongs to exactly one artist. Derived from foreign key Album.ArtistId referencing Artist.ArtistId."@en,
        "Object property generated from foreign key 'Album.ArtistId' referencing 'Artist.ArtistId'."@en ;
    rdfs:domain onto:Album ;
    rdfs:range onto:Artist ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Album/ArtistId> .

onto:Customer_CustomerId a owl:DatatypeProperty ;
    rdfs:label "Customer ID"@en,
        "Customer Id"@en ;
    rdfs:comment "Data property generated from source column 'Customer.CustomerId' with range xsd:integer."@en,
        "Unique identifier for the customer. Primary key of the Customer table."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/CustomerId> .

onto:Employee_FirstName a owl:DatatypeProperty ;
    rdfs:label "First Name"@en ;
    rdfs:comment "Data property generated from source column 'Employee.FirstName' with range xsd:string."@en,
        "Employee's first name. This is a required text field."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/FirstName> .

onto:Employee_LastName a owl:DatatypeProperty ;
    rdfs:label "Last Name"@en ;
    rdfs:comment "Data property generated from source column 'Employee.LastName' with range xsd:string."@en,
        "Employee's last name. This is a required text field."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/LastName> .

onto:InvoiceLine_InvoiceLineId a owl:DatatypeProperty ;
    rdfs:label "Invoice Line Id"@en ;
    rdfs:comment "Data property generated from source column 'InvoiceLine.InvoiceLineId' with range xsd:integer."@en,
        "Unique identifier (primary key) for the invoice line item."@en ;
    rdfs:domain onto:InvoiceLine ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/InvoiceLineId> .

onto:Invoice_InvoiceDate a owl:DatatypeProperty ;
    rdfs:label "Invoice Date"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.InvoiceDate' with range xsd:datetime."@en,
        "Date and time when the invoice was created. This is a required datetime field."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/InvoiceDate> .

onto:Invoice_Total a owl:DatatypeProperty ;
    rdfs:label "Invoice Total"@en,
        "Total"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.Total' with range xsd:decimal."@en,
        "Total monetary amount of the invoice. This is a required decimal field representing the sum of all line items."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/Total> .

onto:Invoice_hasCustomer a owl:ObjectProperty ;
    rdfs:label "Invoice has Customer"@en,
        "has Customer"@en ;
    rdfs:comment "Object property generated from foreign key 'Invoice.CustomerId' referencing 'Customer.CustomerId'."@en,
        "Relates an invoice to the customer who made the purchase. Each invoice belongs to exactly one customer. Derived from foreign key Invoice.CustomerId referencing Customer.CustomerId."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range onto:Customer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/CustomerId> .

