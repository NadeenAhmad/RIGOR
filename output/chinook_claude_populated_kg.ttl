onto:Album_AlbumId a owl:DatatypeProperty ;
    rdfs:label "Album ID"@en,
        "Album Id"@en ;
    rdfs:comment "Data property generated from source column 'Album.AlbumId' with range xsd:integer."@en,
        "Unique integer identifier for the album. This is the primary key of the Album table."@en ;
    rdfs:domain onto:Album ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Album/AlbumId> .

onto:Employee_EmployeeId a owl:DatatypeProperty ;
    rdfs:label "Employee ID"@en,
        "Employee Id"@en ;
    rdfs:comment "Data property generated from source column 'Employee.EmployeeId' with range xsd:integer."@en,
        "Unique identifier for the employee. This is the primary key of the Employee table."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/EmployeeId> .

onto:Invoice_InvoiceId a owl:DatatypeProperty ;
    rdfs:label "Invoice ID"@en,
        "Invoice Id"@en ;
    rdfs:comment "Data property generated from source column 'Invoice.InvoiceId' with range xsd:integer."@en,
        "Unique identifier for the invoice. This is the primary key of the Invoice table."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/InvoiceId> .

onto:MediaType_MediaTypeId a owl:DatatypeProperty ;
    rdfs:label "Media Type Id"@en ;
    rdfs:comment "Data property generated from source column 'MediaType.MediaTypeId' with range xsd:integer."@en,
        "Unique identifier for the media type. This is the primary key of the MediaType table and is used by the Track table to reference the encoding format of each track."@en ;
    rdfs:domain onto:MediaType ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/MediaType/MediaTypeId> .

onto:Playlist_PlaylistId a owl:DatatypeProperty ;
    rdfs:label "Playlist ID"@en,
        "Playlist Id"@en ;
    rdfs:comment "Data property generated from source column 'Playlist.PlaylistId' with range xsd:integer."@en,
        "Unique identifier for the playlist. This is the primary key of the Playlist table."@en ;
    rdfs:domain onto:Playlist ;
    rdfs:range xsd:integer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Playlist/PlaylistId> .

