onto:Artist_Name a owl:DatatypeProperty ;
    rdfs:label "Name"@en ;
    rdfs:comment "Data property generated from source column 'Artist.Name' with range xsd:string."@en,
        "The human-readable name of the artist or performer. This field is optional (nullable) and stores the display name used in the music catalogue."@en ;
    rdfs:domain onto:Artist ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Artist/Name> .

onto:Customer_Email a owl:DatatypeProperty ;
    rdfs:label "Email"@en ;
    rdfs:comment "Customer email address. This is a required field."@en,
        "Data property generated from source column 'Customer.Email' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/Email> .

onto:Customer_FirstName a owl:DatatypeProperty ;
    rdfs:label "First Name"@en ;
    rdfs:comment "Customer's first name. This is a required text field."@en,
        "Data property generated from source column 'Customer.FirstName' with range xsd:string."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/FirstName> .

onto:Customer_LastName a owl:DatatypeProperty ;
    rdfs:label "Last Name"@en ;
    rdfs:comment "Customer's last name. This is a required text field."@en,
