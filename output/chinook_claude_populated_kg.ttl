<http://example.org/ontology> a owl:Ontology ;
    prov:generatedAtTime "2026-04-30T20:50:44.325507+00:00"^^xsd:dateTime .

onto:Customer_hasInvoice a owl:ObjectProperty ;
    rdfs:label "has Invoice"@en ;
    rdfs:comment "Inverse of Invoice_hasCustomer. Relates a customer to their invoices. A customer can have one or more invoices."@en ;
    rdfs:domain onto:Customer ;
    rdfs:range onto:Invoice ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Invoice/CustomerId> .

onto:Employee_hasDirectReport a owl:ObjectProperty ;
    rdfs:label "Has Direct Report"@en ;
    rdfs:comment "Inverse of Employee_ReportsTo. Identifies employees who directly report to this employee. Derived from the recursive foreign key Employee.ReportsTo referencing Employee.EmployeeId, representing the organizational management hierarchy."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range onto:Employee ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Employee/ReportsTo> .

onto:Employee_isSupportRepFor a owl:ObjectProperty ;
    rdfs:label "is Support Representative for"@en ;
    rdfs:comment "Inverse of Customer_hasSupportRep. Indicates that an employee acts as a support representative for a customer."@en ;
    rdfs:domain onto:Employee ;
    rdfs:range onto:Customer ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Customer/SupportRepId> .

onto:Invoice_hasInvoiceLine a owl:ObjectProperty ;
    rdfs:label "has invoice line"@en ;
    rdfs:comment "Inverse of InvoiceLine_hasInvoice; relates an invoice to its constituent line items."@en ;
    rdfs:domain onto:Invoice ;
    rdfs:range onto:InvoiceLine ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/InvoiceLine/InvoiceId> .

onto:playlistContainsTrack a owl:ObjectProperty ;
    rdfs:label "playlist contains track"@en ;
    rdfs:comment "A shortcut property representing the many-to-many relationship between Playlist and Track, derived by composing PlaylistTrack_hasPlaylist (inverse) and PlaylistTrack_hasTrack. A playlist can contain many tracks, and a track can appear in many playlists."@en ;
    rdfs:domain onto:Playlist ;
    rdfs:range onto:Track ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/PlaylistTrack> .

onto:trackInPlaylist a owl:ObjectProperty ;
    rdfs:label "track in playlist"@en ;
    rdfs:comment "Inverse of playlistContainsTrack. Indicates that a track appears in a given playlist."@en ;
    rdfs:domain onto:Track ;
    rdfs:range onto:Playlist ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/PlaylistTrack> .

