onto:Playlist a owl:Class ;
    rdfs:label "Playlist"@en ;
    rdfs:comment "A named collection of tracks in a digital media store. Playlists group tracks into user-facing or system-defined lists."@en,
        "Class generated from source table 'Playlist'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty onto:Playlist_Name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty onto:Playlist_Name ],
        [ a owl:Restriction ;
            owl:onProperty onto:Playlist_PlaylistId ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty onto:Playlist_PlaylistId ],
        [ a owl:Restriction ;
            owl:onProperty onto:Playlist_PlaylistId ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty onto:Playlist_PlaylistId ],
        onto:Playlist_PlaylistId_exactly_1_xsd_integer ;
    owl:hasKey ( onto:Playlist_PlaylistId ),
        ( onto:Playlist_PlaylistId ) ;
    skos:exactMatch <http://www.wikidata.org/entity/Q100391350> ;
    prov:wasDerivedFrom <http://example.org/ontology/provenance/Playlist> .

